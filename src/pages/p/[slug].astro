      <script
        is:inline
        define:vars={{
          currencySymbol: prospect.currencySymbol,
          defaultPackageId: defaultPkg?.id ?? '',
          defaultPackageName: defaultPkg?.name ?? '',
        }}
      >
        (function () {
          let selectedVehicle = 'sedan';
          let selectedVehicleLabel = 'Coupe / Sedan';
          let selectedPackageId = defaultPackageId;
          let selectedPackageName = defaultPackageName;
          let selectedCondition = 'standard';

          const vehicleButtons = document.querySelectorAll('.vehicle-btn');
          const packageButtons = document.querySelectorAll('.package-btn');
          const conditionButtons = document.querySelectorAll('.condition-btn');
          const addonCheckboxes = document.querySelectorAll('.addon-checkbox');

          const topEstEl = document.getElementById('calc-top-estimate');
          const topDurEl = document.getElementById('calc-top-duration');
          const formEstEl = document.getElementById('calc-form-estimate');
          const mobileEstEl = document.getElementById('mobile-sticky-estimate');
          const dockVehicleEl = document.getElementById('dock-vehicle-label');
          const dockPackageEl = document.getElementById('dock-package-label');
          const dockDurationEl = document.getElementById('dock-duration-label');

          const form = document.getElementById('quote-form');
          const submitBtn = document.getElementById('submit-quote-btn');
          const errorBox = document.getElementById('quote-error-box');

          const modal = document.getElementById('quote-success-modal');
          const modalSummary = document.getElementById('modal-customer-summary');
          const modalSms = document.getElementById('modal-owner-sms');
          const closeModalBtn = document.getElementById('close-modal-btn');
          const doneModalBtn = document.getElementById('done-modal-btn');

          function pulsePrice(el) {
            if (!el) return;
            el.classList.remove('price-bump');
            void el.offsetWidth;
            el.classList.add('price-bump');
          }

          function getConditionSpread(cond) {
            if (cond === 'pet_hair') return [25, 45];
            if (cond === 'heavy_soil') return [35, 65];
            return [0, 20];
          }

          function updatePricingDisplay() {
            packageButtons.forEach((btn) => {
              const priceAttr = btn.getAttribute(`data-price-${selectedVehicle}`);
              const priceEl = btn.querySelector('.pkg-price-display');
              if (priceAttr && priceEl) {
                priceEl.textContent = `${currencySymbol}${priceAttr}`;
              }
            });

            const activePkgBtn = document.querySelector(
              `.package-btn[data-package-id="${selectedPackageId}"]`
            );
            if (!activePkgBtn) return;

            const basePrice = Number(
              activePkgBtn.getAttribute(`data-price-${selectedVehicle}`) || '145'
            );
            const duration = activePkgBtn.getAttribute('data-duration') || '';
            const [condMin, condMax] = getConditionSpread(selectedCondition);

            let addonsSum = 0;
            addonCheckboxes.forEach((cb) => {
              if (cb.checked) {
                addonsSum += Number(cb.getAttribute('data-addon-price') || '0');
              }
            });

            const estMin = basePrice + condMin + addonsSum;
            const estMax = basePrice + condMax + addonsSum;
            const formatted = `${currencySymbol}${estMin} - ${currencySymbol}${estMax}`;

            if (topEstEl) {
              topEstEl.textContent = formatted;
              pulsePrice(topEstEl);
            }
            if (topDurEl) topDurEl.textContent = duration;
            if (formEstEl) {
              formEstEl.textContent = formatted;
              pulsePrice(formEstEl);
            }
            if (mobileEstEl) {
              mobileEstEl.textContent = formatted;
              pulsePrice(mobileEstEl);
            }
            if (dockVehicleEl) dockVehicleEl.textContent = selectedVehicleLabel;
            if (dockPackageEl) dockPackageEl.textContent = selectedPackageName;
            if (dockDurationEl) {
              dockDurationEl.textContent = `${duration} · Zero upfront payment`;
            }
          }

          function setVehicle(size, label) {
            selectedVehicle = size;
            selectedVehicleLabel = label;
            vehicleButtons.forEach((btn) => {
              const active = btn.getAttribute('data-vehicle') === size;
              btn.setAttribute('aria-checked', active ? 'true' : 'false');
              btn.className = active
                ? 'vehicle-btn interactive-card flex flex-col justify-between rounded-xl border-2 border-[#00F2FE] bg-[#00F2FE]/8 p-5 text-left cyan-glow-sm'
                : 'vehicle-btn interactive-card flex flex-col justify-between rounded-xl border border-slate-700/80 bg-[#0A0C10]/65 p-5 text-left hover:border-cyan-400/50';
              const svg = btn.querySelector('svg');
              const dot = btn.querySelector('.vehicle-dot');
              if (svg) {
                svg.setAttribute('class', active ? 'h-10 w-24 text-[#00F2FE]' : 'h-10 w-24 text-slate-300');
              }
              if (dot) {
                dot.className = active
                  ? 'vehicle-dot h-4 w-4 rounded-full border-2 border-[#00F2FE] bg-[#00F2FE]'
                  : 'vehicle-dot h-4 w-4 rounded-full border-2 border-slate-600';
              }
            });
            updatePricingDisplay();
          }

          function setPackage(pkgId, pkgName) {
            selectedPackageId = pkgId;
            selectedPackageName = pkgName;
            packageButtons.forEach((btn) => {
              const active = btn.getAttribute('data-package-id') === pkgId;
              btn.setAttribute('aria-pressed', active ? 'true' : 'false');
              btn.className = active
                ? 'package-btn interactive-card relative flex h-full flex-col justify-between rounded-xl border-2 border-[#00F2FE] bg-[#00F2FE]/8 p-6 text-left cyan-glow-sm'
                : 'package-btn interactive-card relative flex h-full flex-col justify-between rounded-xl border border-slate-700/80 bg-[#0A0C10]/65 p-6 text-left hover:border-cyan-400/50';
              const dot = btn.querySelector('.pkg-dot');
              if (dot) {
                dot.className = active
                  ? 'pkg-dot mt-1 h-4 w-4 shrink-0 rounded-full border-2 border-[#00F2FE] bg-[#00F2FE]'
                  : 'pkg-dot mt-1 h-4 w-4 shrink-0 rounded-full border-2 border-slate-600';
              }
            });
            updatePricingDisplay();
          }

          function setCondition(cond) {
            selectedCondition = cond;
            conditionButtons.forEach((btn) => {
              const active = btn.getAttribute('data-condition') === cond;
              btn.className = active
                ? 'condition-btn interactive-card flex w-full items-center justify-between rounded-xl border-2 border-[#00F2FE] bg-[#00F2FE]/8 px-4 py-3.5 text-left'
                : 'condition-btn interactive-card flex w-full items-center justify-between rounded-xl border border-slate-700/80 bg-[#0A0C10]/65 px-4 py-3.5 text-left hover:border-cyan-400/50';
            });
            updatePricingDisplay();
          }

          vehicleButtons.forEach((btn) => {
            btn.addEventListener('click', () => {
              const val = btn.getAttribute('data-vehicle');
              const label = btn.getAttribute('data-vehicle-label') || 'Coupe / Sedan';
              if (val) setVehicle(val, label);
            });
          });

          packageButtons.forEach((btn) => {
            btn.addEventListener('click', () => {
              const val = btn.getAttribute('data-package-id');
              const name = btn.getAttribute('data-package-name') || '';
              if (val) setPackage(val, name);
            });
          });

          conditionButtons.forEach((btn) => {
            btn.addEventListener('click', () => {
              const val = btn.getAttribute('data-condition');
              if (val) setCondition(val);
            });
          });

          addonCheckboxes.forEach((cb) => {
            cb.addEventListener('change', () => {
              const parentLabel = cb.closest('.addon-label');
              if (parentLabel) {
                parentLabel.className = cb.checked
                  ? 'addon-label interactive-card flex cursor-pointer items-start gap-3 rounded-xl border-2 border-[#00F2FE] bg-[#00F2FE]/8 p-3.5'
                  : 'addon-label interactive-card flex cursor-pointer items-start gap-3 rounded-xl border border-slate-700/80 bg-[#0A0C10]/65 p-3.5 hover:border-cyan-400/50';
              }
              updatePricingDisplay();
            });
          });

          // Interactive Before / After toggles on Job Proof cards
          document.querySelectorAll('[data-proof-card]').forEach((card) => {
            const buttons = card.querySelectorAll('.proof-tab-btn');
            const noteEl = card.querySelector('.proof-note');
            if (!noteEl) return;

            buttons.forEach((btn) => {
              btn.addEventListener('click', () => {
                const mode = btn.getAttribute('data-toggle-proof');
                buttons.forEach((b) => {
                  const isActive = b === btn;
                  b.className = isActive
                    ? 'proof-tab-btn rounded-lg bg-[#00F2FE]/15 px-2.5 py-1 text-[11px] font-bold text-[#00F2FE] ring-1 ring-cyan-400/40'
                    : 'proof-tab-btn rounded-lg px-2.5 py-1 text-[11px] font-semibold text-[#94A3B8] hover:text-white';
                });
                if (mode === 'before') {
                  noteEl.textContent = noteEl.getAttribute('data-before-text') || '';
                  noteEl.className = 'proof-note mt-2 text-xs leading-snug text-amber-200';
                } else {
                  noteEl.textContent = noteEl.getAttribute('data-after-text') || '';
                  noteEl.className = 'proof-note mt-2 text-xs leading-snug text-emerald-300';
                }
              });
            });
          });

          function closeModal() {
            if (!modal) return;
            modal.classList.add('hidden');
            modal.classList.remove('flex');
          }

          closeModalBtn?.addEventListener('click', closeModal);
          doneModalBtn?.addEventListener('click', closeModal);
          modal?.addEventListener('click', (e) => {
            if (e.target === modal) closeModal();
          });

          form?.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (!form || !submitBtn || !errorBox) return;

            errorBox.classList.add('hidden');
            errorBox.textContent = '';

            const formData = new FormData(form);
            const selectedAddons = [];
            addonCheckboxes.forEach((cb) => {
              if (cb.checked) selectedAddons.push(cb.value);
            });

            const payload = {
              slug: String(formData.get('slug') || ''),
              customerName: String(formData.get('customerName') || ''),
              customerPhone: String(formData.get('customerPhone') || ''),
              customerPostal: String(formData.get('customerPostal') || ''),
              vehicleSize: selectedVehicle,
              packageId: selectedPackageId,
              conditionLevel: selectedCondition,
              addonsSelected: selectedAddons,
              preferredTiming: String(formData.get('preferredTiming') || 'this_week'),
              notes: String(formData.get('notes') || ''),
              website_url: String(formData.get('website_url') || ''),
            };

            const originalText = submitBtn.textContent;
            submitBtn.disabled = true;
            submitBtn.textContent = 'Calculating & Saving Quote...';

            try {
              const res = await fetch('/api/quotes', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
              });
              const result = await res.json();

              if (!res.ok || !result.ok) {
                errorBox.textContent =
                  result.error || 'Please check your name, phone number, and postal code.';
                errorBox.classList.remove('hidden');
                return;
              }

              if (result.quote && modalSummary && modalSms && modal) {
                modalSummary.innerHTML = '';
                const line1 = document.createElement('div');
                line1.className = 'font-bold text-white';
                line1.textContent = `${result.quote.vehicleLabel} · ${result.quote.packageName}`;

                const line2 = document.createElement('div');
                line2.className = 'mt-1 text-xs text-[#00F2FE] font-semibold';
                line2.textContent = `Estimated Range: ${result.quote.priceRange} (${result.quote.durationLabel})`;

                const line3 = document.createElement('div');
                line3.className = 'mt-1 text-xs text-[#94A3B8]';
                line3.textContent = `Contact: ${result.quote.customerName} (${result.quote.customerPhone}) · ${result.quote.customerPostal}`;

                modalSummary.appendChild(line1);
                modalSummary.appendChild(line2);
                modalSummary.appendChild(line3);

                modalSms.textContent = result.ownerPreview?.smsPreview || '';
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                form.reset();
              }
            } catch {
              errorBox.textContent =
                'Network error while submitting quote. Please try again.';
              errorBox.classList.remove('hidden');
            } finally {
              submitBtn.disabled = false;
              submitBtn.textContent = originalText;
            }
          });

          updatePricingDisplay();
        })();
      </script>
    </BaseLayout>
  )
}
