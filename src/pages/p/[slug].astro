---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProspectBySlug } from "../../lib/db/repository";
import { isStudioAuthorized } from "../../lib/security/auth";

const { slug } = Astro.params;
const env = Astro.locals.runtime.env;
const d1 = env.DB;
const prospect = slug ? await getProspectBySlug(d1, slug) : null;

if (!prospect) {
  Astro.response.status = 404;
}

const defaultPkg =
  prospect?.packages.find((p) => p.popular) ?? prospect?.packages[0] ?? null;
const initialMin = defaultPkg ? defaultPkg.prices.sedan : 145;
const initialMax = initialMin + 20;
const isPreview = prospect?.mode === "preview";
const studioAuthed = await isStudioAuthorized(
  Astro.request,
  Astro.cookies,
  env,
);
const isFounderSelfTest =
  Astro.url.searchParams.get("founder") === "1" && studioAuthed;

const rawPhone = prospect?.phoneDisplay ?? "";
const phoneDigits = rawPhone.replace(/\D/g, "");
const hasDialablePhone =
  Boolean(rawPhone) &&
  phoneDigits.length >= 7 &&
  !rawPhone.includes("555-") &&
  !rawPhone.toLowerCase().includes("direct");
const telHref = hasDialablePhone
  ? `tel:${rawPhone.replace(/[^+\d]/g, "")}`
  : "";
const cleanIgHandle = (prospect?.instagramHandle ?? "")
  .replace(/^@+/, "")
  .trim();
const igProfileUrl =
  cleanIgHandle && cleanIgHandle !== "detailer"
    ? `https://instagram.com/${encodeURIComponent(cleanIgHandle)}`
    : "";
const isUk = prospect?.country === "UK";
const foundingSetupText = isUk
  ? "£39 founding setup + £12/mo"
  : "$50 founding setup + $15/mo";
const realPhotoGallery = prospect
  ? prospect.gallery.filter((item) => Boolean(item.imageUrl?.trim()))
  : [];
const visibleGallery = isPreview ? (prospect?.gallery ?? []) : realPhotoGallery;
const hasSelfContainedWater = Boolean(
  prospect?.trustPoints.some((pt) =>
    /water|power|self-contained|autonomous/i.test(pt),
  ),
);
const rawFoundingCheckout = env.FOUNDING_CHECKOUT_URL?.trim() || "";
const foundingCheckoutUrl = rawFoundingCheckout.startsWith("https://")
  ? rawFoundingCheckout
  : "";
---

{!prospect ? (
  <BaseLayout
    title="Preview Not Found | QuotesDock"
    description="This detailing preview page could not be found."
    noindex={true}
  >
    <main class="carbon-mesh mx-auto flex min-h-screen flex-col items-center justify-center px-6 py-16 text-center">
      <div class="glass-panel w-full max-w-lg rounded-2xl p-8">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-sky-400/30 bg-sky-400/10 px-3 py-1 text-xs font-semibold text-[#7DD3FC]">
          QuotesDock
        </span>
        <h1 class="mt-4 text-2xl font-bold text-slate-50">
          This detailing quote link is not active
        </h1>
        <p class="mt-3 text-sm leading-relaxed text-[#CBD5E1]">
          Check the link address with your mobile detailer, or visit the
          QuotesDock homepage to explore our 60-second driveway quote template.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a
            href="/"
            class="rounded-xl bg-[#38BDF8] px-5 py-2.5 text-sm font-bold text-[#06131F] transition-colors hover:bg-[#7DD3FC]"
          >
            Return to QuotesDock
          </a>
        </div>
      </div>
    </main>
  </BaseLayout>
) : (
  <BaseLayout
    title={`${prospect.businessName} | Instant 60-Second Driveway Quote`}
    description={prospect.tagline}
    noindex={isPreview}
    showScrollLaser={true}
  >
    {isPreview && (
      <div class="border-b border-cyan-400/30 bg-[#0D1626] px-4 py-2 text-xs text-sky-50 sm:text-sm">
        <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-2">
          <div class="flex min-w-0 max-w-full flex-1 items-start gap-2.5 sm:items-center">
            <span class="relative mt-1 flex h-2 w-2 shrink-0 sm:mt-0">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#00F2FE] opacity-75" />
              <span class="relative inline-flex h-2 w-2 rounded-full bg-[#00F2FE]" />
            </span>
            <span class="leading-snug">
              <strong class="text-[#7DD3FC]">
                {isFounderSelfTest
                  ? "Founder Test Mode"
                  : "Live Custom Preview"}
              </strong>{" "}
              prepared for <strong>{prospect.businessName}</strong> (
              {prospect.city}) - sample prices shown for demonstration until
              confirmed by owner
            </span>
          </div>
          <div class="flex shrink-0 items-center gap-4">
            <a
              href="#quote-calculator"
              class="font-semibold text-[#7DD3FC] underline decoration-cyan-400/50 underline-offset-4 hover:text-white"
            >
              Run Quote Test
            </a>
            <a
              href="#claim-preview"
              class="btn-hydro-primary rounded-lg px-3 py-1 text-xs font-bold"
            >
              Claim Page
            </a>
          </div>
        </div>
      </div>
    )}

    {/* Sticky Glass Navigation Bar */}
    <nav class="sticky top-0 z-40 border-b border-slate-800/90 bg-[#090C12]/90 backdrop-blur-xl">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6">
        <div class="flex min-w-0 items-center gap-3.5">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-cyan-400/40 bg-cyan-400/10 text-[#00F2FE] cyan-glow-sm">
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M12 2L20 6.5V17.5L12 22L4 17.5V6.5L12 2Z" />
              <path d="M12 7L16 9.5V14.5L12 17L8 14.5V9.5L12 7Z" />
            </svg>
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <span class="font-display truncate text-base font-bold tracking-tight text-slate-50 sm:text-lg">
                {prospect.businessName}
              </span>
            </div>
            <div class="flex items-center gap-1.5 text-[11px] text-[#CBD5E1]">
              <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-400" />
              <span class="truncate">Mobile Unit: {prospect.city}</span>
            </div>
          </div>
        </div>

        <div class="hidden items-center gap-7 text-xs font-semibold tracking-wide text-[#CBD5E1] lg:flex">
          <a
            href="#quote-calculator"
            class="text-[#7DD3FC] transition-colors hover:text-white"
          >
            Configurator
          </a>
          {visibleGallery.length > 0 && (
            <a href="#job-proof" class="transition-colors hover:text-white">
              Recent Work
            </a>
          )}
          <a href="#rig-specs" class="transition-colors hover:text-white">
            Service Highlights
          </a>
          <a href="#faq" class="transition-colors hover:text-white">
            FAQ
          </a>
        </div>

        <div class="flex shrink-0 items-center gap-2.5">
          {hasDialablePhone ? (
            <a
              href={telHref}
              class="hidden rounded-lg border border-slate-600/80 bg-[#111622] px-3.5 py-2 text-xs font-semibold text-slate-100 transition-colors hover:border-cyan-400/50 hover:text-white sm:inline-flex"
            >
              {prospect.phoneDisplay}
            </a>
          ) : (
            <span class="hidden rounded-lg border border-slate-600/80 bg-[#111622] px-3.5 py-2 text-xs font-semibold text-slate-200 sm:inline-flex">
              Direct DM / Text Dispatch
            </span>
          )}
          <a
            href="#quote-calculator"
            class="btn-hydro-primary rounded-lg px-4 py-2 text-xs font-bold sm:text-sm"
          >
            Get 60s Quote
          </a>
        </div>
      </div>
    </nav>

    {/* Atmospheric Wet-Bay Studio Hero */}
    <header class="wetbay-stage relative overflow-hidden border-b border-slate-800/80">
      <div class="mx-auto max-w-7xl px-4 pb-14 pt-10 sm:px-6 sm:pb-20 sm:pt-14">
        <div class="grid items-center gap-10 lg:grid-cols-12">
          {/* Left Copy & Metrics */}
          <div class="reveal-up is-visible min-w-0 lg:col-span-7">
            <div class="inline-flex max-w-full flex-wrap items-center gap-2 rounded-full border border-cyan-400/30 bg-cyan-400/10 px-3.5 py-1.5 text-xs">
              <span class="relative flex h-2 w-2">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#00F2FE] opacity-75" />
                <span class="relative inline-flex h-2 w-2 rounded-full bg-[#00F2FE]" />
              </span>
              <span class="font-semibold text-slate-50">
                {prospect.turnaroundBadge}
              </span>
              <span class="text-slate-500">|</span>
              <span class="font-bold text-amber-300">
                ★ {prospect.ratingScore}
              </span>
              <span class="text-slate-200">
                ({prospect.reviewCount}+ public reviews)
              </span>
              <span class="text-slate-500">|</span>
              <span class="text-[#7DD3FC]">{prospect.instagramHandle}</span>
            </div>

            <h1 class="mt-5 max-w-[20ch] text-3xl font-bold leading-[1.08] tracking-[-0.03em] text-slate-50 sm:text-5xl lg:text-[54px]">
              {prospect.heroHeadline}
            </h1>

            <p class="mt-4 max-w-2xl text-base leading-relaxed text-[#CBD5E1] sm:text-lg">
              {prospect.heroSubheadline}
            </p>

            <div class="mt-7 flex flex-wrap items-center gap-4">
              <a
                href="#quote-calculator"
                data-magnetic="4"
                class="btn-hydro-primary group inline-flex items-center gap-2.5 rounded-xl px-6 py-4 text-sm font-bold sm:text-base"
              >
                <span>Configure Driveway Quote</span>
                <svg
                  class="h-4 w-4 transition-transform group-hover:translate-x-1"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                    clip-rule="evenodd"
                  />
                </svg>
              </a>
              {visibleGallery.length > 0 && (
                <a
                  href="#job-proof"
                  class="inline-flex items-center gap-2 rounded-xl border border-slate-600/80 bg-[#111622]/90 px-5 py-4 text-sm font-semibold text-slate-100 backdrop-blur-md transition-colors hover:border-cyan-400/55 hover:text-white"
                >
                  View Recent Work
                </a>
              )}
            </div>

            {/* 4-Card Honest Summary Strip */}
            <div class="mt-8 grid grid-cols-2 gap-3 border-t border-slate-800/90 pt-6 sm:grid-cols-4">
              <div class="glass-panel spotlight-card rounded-xl p-3.5">
                <div class="font-display tabular-nums text-lg font-bold text-[#00F2FE]">
                  ★ {prospect.ratingScore}
                </div>
                <div class="mt-0.5 text-[11px] font-medium text-[#CBD5E1]">
                  {prospect.reviewCount}+ Public Reviews
                </div>
              </div>
              <div class="glass-panel spotlight-card rounded-xl p-3.5">
                <div class="font-display tabular-nums text-lg font-bold text-slate-50">
                  {prospect.packages.length} Tiers
                </div>
                <div class="mt-0.5 text-[11px] font-medium text-[#CBD5E1]">
                  Sedan, SUV &amp; Truck
                </div>
              </div>
              <div class="glass-panel spotlight-card rounded-xl p-3.5">
                <div class="font-display text-lg font-bold text-[#00F2FE]">
                  {hasSelfContainedWater ? "Self-Contained" : "On-Site"}
                </div>
                <div class="mt-0.5 text-[11px] font-medium text-[#CBD5E1]">
                  {hasSelfContainedWater ? "Water & Power Ready" : "Home or Workplace"}
                </div>
              </div>
              <div class="glass-panel spotlight-card rounded-xl p-3.5">
                <div class="font-display text-lg font-bold text-emerald-300">
                  60 Sec
                </div>
                <div class="mt-0.5 text-[11px] font-medium text-[#CBD5E1]">
                  Instant Quote Flow
                </div>
              </div>
            </div>
          </div>

          {/* Right Bay Preview Frame */}
          <div class="reveal-up is-visible stagger-1 lg:col-span-5">
            <div
              data-tilt-card="2.5"
              class="glass-panel anisotropic-border spotlight-card relative overflow-hidden rounded-2xl p-2"
            >
              <div class="relative aspect-[4/3] overflow-hidden rounded-xl bg-[#090C12]">
                <img
                  src="/images/hero-wetbay.jpg"
                  alt={`${prospect.businessName} mobile detailing showcase`}
                  class="h-full w-full object-cover object-[70%_62%] scale-105"
                />
                {/* Mask upper-left background wall cleanly so image works for every city */}
                <div
                  class="pointer-events-none absolute inset-0"
                  style="background: linear-gradient(125deg, rgba(9,12,18,0.92) 0%, rgba(9,12,18,0.44) 45%, rgba(9,12,18,0.08) 100%), linear-gradient(to top, rgba(9,12,18,0.95) 0%, transparent 52%);"
                />

                <div class="absolute inset-x-3 bottom-3 flex items-center justify-between gap-3 rounded-xl border border-slate-700/80 bg-[#090C12]/90 px-4 py-3 backdrop-blur-md">
                  <div class="min-w-0">
                    <div class="flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-[#7DD3FC]">
                      <span class="h-1.5 w-1.5 rounded-full bg-[#00F2FE]" />
                      {hasSelfContainedWater ? "Self-Contained Mobile Unit" : "Mobile Detailing Service"}
                    </div>
                    <div class="mt-0.5 truncate text-xs text-slate-200">
                      Serving {prospect.serviceArea}
                    </div>
                  </div>
                  <div class="shrink-0 text-right">
                    <div class="font-display tabular-nums text-base font-bold text-slate-50">
                      {prospect.currencySymbol}
                      {initialMin}+
                    </div>
                    <div class="text-[10px] uppercase tracking-wider text-[#CBD5E1]">
                      Base Reset
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    {/* Main Content */}
    <main class="studio-frame-rails relative mx-auto max-w-7xl px-4 pb-32 pt-12 sm:px-6 sm:pt-16 lg:px-8">
      {/* Interactive 60-Second Driveway Quote Configurator */}
      <section
        id="quote-calculator"
        class="reveal-up is-visible glass-panel anisotropic-border rounded-2xl p-5 sm:p-8 lg:p-10"
      >
        <div class="flex flex-wrap items-start justify-between gap-6 border-b border-slate-800 pb-6">
          <div>
            <div class="inline-flex items-center gap-2 rounded-full border border-cyan-400/30 bg-cyan-400/10 px-3 py-1 text-xs font-semibold text-[#7DD3FC]">
              Real-Time Driveway Estimator
            </div>
            <h2 class="mt-3 text-2xl font-bold tracking-[-0.03em] text-slate-50 sm:text-3xl">
              60-Second Driveway Quote Configurator
            </h2>
            <p class="mt-1.5 text-sm text-[#CBD5E1]">
              Tap your vehicle class, detailing tier, and condition for an
              instant {prospect.city} estimate.
            </p>
          </div>

          <div class="rounded-xl border border-cyan-400/35 bg-[#090C12]/90 px-5 py-3.5 cyan-glow-sm">
            <div class="text-[11px] font-semibold uppercase tracking-wider text-[#CBD5E1]">
              Live Estimated Range
            </div>
            <div
              id="calc-top-estimate"
              class="font-display tabular-nums mt-0.5 text-2xl font-bold text-[#00F2FE] sm:text-3xl"
            >
              {prospect.currencySymbol}
              {initialMin} - {prospect.currencySymbol}
              {initialMax}
            </div>
            <div id="calc-top-duration" class="mt-0.5 text-xs text-slate-200">
              {defaultPkg?.durationLabel}
            </div>
          </div>
        </div>

        {/* 4-Step Interactive Telemetry Track */}
        <div
          id="calc-telemetry-track"
          aria-label="Quote configurator steps"
          class="mt-6 grid grid-cols-2 gap-2 rounded-xl border border-slate-800/90 bg-[#090C12]/80 p-2 sm:grid-cols-4"
        >
          <div
            data-step-node="1"
            class="flex items-center gap-2 rounded-lg border border-cyan-400/40 bg-cyan-400/10 px-3 py-2 text-xs font-semibold text-white transition-colors"
          >
            <span class="font-mono text-[11px] font-bold text-[#00F2FE]">01</span>
            <span>Vehicle</span>
          </div>
          <div
            data-step-node="2"
            class="flex items-center gap-2 rounded-lg border border-transparent px-3 py-2 text-xs font-semibold text-slate-300 transition-colors"
          >
            <span class="font-mono text-[11px] font-bold text-slate-400">02</span>
            <span>Package</span>
          </div>
          <div
            data-step-node="3"
            class="flex items-center gap-2 rounded-lg border border-transparent px-3 py-2 text-xs font-semibold text-slate-300 transition-colors"
          >
            <span class="font-mono text-[11px] font-bold text-slate-400">03</span>
            <span>Condition</span>
          </div>
          <div
            data-step-node="4"
            class="flex items-center gap-2 rounded-lg border border-transparent px-3 py-2 text-xs font-semibold text-slate-300 transition-colors"
          >
            <span class="font-mono text-[11px] font-bold text-slate-400">04</span>
            <span>Dispatch</span>
          </div>
        </div>

        <form id="quote-form" class="mt-8 space-y-10" novalidate>
          <input type="hidden" name="slug" value={prospect.slug} />
          <div class="hidden" aria-hidden="true">
            <label for="website_url">Leave blank</label>
            <input
              id="website_url"
              name="website_url"
              type="text"
              tabindex="-1"
              autocomplete="off"
              value=""
            />
          </div>

          {/* Step 01: Vehicle Class with Custom SVG Silhouettes */}
          <div>
            <div class="flex items-center justify-between gap-2">
              <div class="flex items-center gap-3">
                <span class="font-display flex h-7 w-7 items-center justify-center rounded-full bg-[#00F2FE] text-xs font-bold text-[#041019]">
                  01
                </span>
                <h3 class="text-base font-bold text-slate-50 sm:text-lg">
                  Select Vehicle Class
                </h3>
              </div>
              <span class="text-xs font-semibold uppercase tracking-wider text-[#CBD5E1]">
                Step 1 of 4
              </span>
            </div>

            <div
              id="vehicle-size-group"
              class="mt-4 grid gap-4 md:grid-cols-3"
              role="radiogroup"
              aria-label="Vehicle size"
            >
              <button
                type="button"
                data-vehicle="sedan"
                data-vehicle-label="Coupe / Sedan"
                aria-checked="true"
                role="radio"
                class="vehicle-btn interactive-card spotlight-card flex flex-col justify-between rounded-xl border-2 border-[#00F2FE] bg-[#00F2FE]/10 p-5 text-left cyan-glow-sm"
              >
                <div class="bay-floor-glow vehicle-bay-glow flex w-full items-start justify-between gap-3 rounded-lg pb-1">
                  {/* Sedan SVG Silhouette */}
                  <div class="relative">
                    <svg class="pointer-events-none -mb-1 h-2 w-24 text-[#00F2FE]/45" viewBox="0 0 120 10" fill="none" aria-hidden="true">
                      <path d="M12 8C38 2 82 2 108 8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                    </svg>
                    <svg
                      class="h-10 w-24 text-[#00F2FE]"
                      viewBox="0 0 120 44"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M10 30H22M40 30H82M100 30H110L112 24L104 20L82 18L66 10H36L20 18L10 21V30Z" />
                      <circle cx="31" cy="30" r="7" />
                      <circle cx="91" cy="30" r="7" />
                    </svg>
                  </div>
                  <span class="vehicle-dot h-4 w-4 rounded-full border-2 border-[#00F2FE] bg-[#00F2FE]" />
                </div>
                <div class="mt-3">
                  <div class="font-display text-base font-bold text-slate-50">
                    Coupe / Sedan
                  </div>
                  <p class="mt-1 text-xs text-[#CBD5E1]">
                    2-door or 4-door cars (Civic, Model 3, BMW 3 Series)
                  </p>
                  <div class="mt-3 text-[11px] font-bold uppercase tracking-wider text-[#7DD3FC]">
                    Standard Baseline Scale
                  </div>
                </div>
              </button>

              <button
                type="button"
                data-vehicle="suv"
                data-vehicle-label="Mid-Size SUV"
                aria-checked="false"
                role="radio"
                class="vehicle-btn interactive-card spotlight-card flex flex-col justify-between rounded-xl border border-slate-700/80 bg-[#090C12]/80 p-5 text-left hover:border-cyan-400/50"
              >
                <div class="vehicle-bay-glow flex w-full items-start justify-between gap-3 rounded-lg pb-1">
                  {/* Mid-Size SUV SVG Silhouette */}
                  <div class="relative">
                    <svg class="pointer-events-none -mb-1 h-2 w-24 text-slate-500/35" viewBox="0 0 120 10" fill="none" aria-hidden="true">
                      <path d="M12 8C38 2 82 2 108 8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                    </svg>
                    <svg
                      class="h-10 w-24 text-slate-300"
                      viewBox="0 0 120 44"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M10 30H22M40 30H82M100 30H110L112 22L104 18L90 17L76 9H30L18 18L10 21V30Z" />
                      <circle cx="31" cy="30" r="7.5" />
                      <circle cx="91" cy="30" r="7.5" />
                    </svg>
                  </div>
                  <span class="vehicle-dot h-4 w-4 rounded-full border-2 border-slate-500" />
                </div>
                <div class="mt-3">
                  <div class="font-display text-base font-bold text-slate-50">
                    Mid-Size SUV / Crossover
                  </div>
                  <p class="mt-1 text-xs text-[#CBD5E1]">
                    2-row SUVs &amp; wagons (RAV4, CR-V, Model Y, Porsche Macan)
                  </p>
                  <div class="mt-3 text-[11px] font-bold uppercase tracking-wider text-slate-300">
                    +Mid-Size Surface Area
                  </div>
                </div>
              </button>

              <button
                type="button"
                data-vehicle="truck_xl"
                data-vehicle-label="3-Row SUV / Pickup"
                aria-checked="false"
                role="radio"
                class="vehicle-btn interactive-card spotlight-card flex flex-col justify-between rounded-xl border border-slate-700/80 bg-[#090C12]/80 p-5 text-left hover:border-cyan-400/50"
              >
                <div class="vehicle-bay-glow flex w-full items-start justify-between gap-3 rounded-lg pb-1">
                  {/* Pickup / Full-Size Truck SVG Silhouette */}
                  <div class="relative">
                    <svg class="pointer-events-none -mb-1 h-2 w-24 text-slate-500/35" viewBox="0 0 120 10" fill="none" aria-hidden="true">
