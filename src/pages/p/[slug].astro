---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProspectBySlug } from '../../lib/db/repository';

const { slug } = Astro.params;
const d1 = Astro.locals.runtime.env.DB;
const prospect = slug ? await getProspectBySlug(d1, slug) : null;

if (!prospect) {
  Astro.response.status = 404;
}

const defaultPkg =
  prospect?.packages.find((p) => p.popular) ?? prospect?.packages[0] ?? null;
const initialMin = defaultPkg ? defaultPkg.prices.sedan : 145;
const initialMax = initialMin + 20;
const isPreview = prospect?.mode === 'preview';

const glossReadings = [
  { before: '64.2', after: '98.6', delta: '+34.4', beforeWidth: '64%', afterWidth: '98%' },
  { before: '68.8', after: '97.4', delta: '+28.6', beforeWidth: '69%', afterWidth: '97%' },
  { before: '66.0', after: '96.9', delta: '+30.9', beforeWidth: '66%', afterWidth: '97%' },
  { before: '61.5', after: '98.1', delta: '+36.6', beforeWidth: '62%', afterWidth: '98%' },
  { before: '70.4', after: '97.8', delta: '+27.4', beforeWidth: '70%', afterWidth: '98%' },
  { before: '58.9', after: '96.5', delta: '+37.6', beforeWidth: '59%', afterWidth: '96%' },
];
---

{
  !prospect ? (
    <BaseLayout
      title="Preview Not Found | QuotesDock"
      description="This detailing preview page could not be found."
    >
      <main class="carbon-mesh mx-auto flex min-h-screen flex-col items-center justify-center px-6 py-16 text-center">
        <div class="glass-panel w-full max-w-lg rounded-2xl p-8">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-cyan-400/30 bg-cyan-400/10 px-3 py-1 text-xs font-semibold text-[#00F2FE]">
            QuotesDock Preview
          </span>
          <h1 class="mt-4 text-2xl font-bold text-white">
            This preview link is not active
          </h1>
          <p class="mt-3 text-sm leading-relaxed text-[#94A3B8]">
            Check that the business slug is spelled correctly, or open your Founder Studio to generate a new detailer preview.
          </p>
          <div class="mt-6 flex flex-wrap justify-center gap-3">
            <a
              href="/"
              class="rounded-xl border border-slate-700 bg-slate-900/80 px-4 py-2.5 text-sm font-semibold text-slate-200 transition-colors hover:border-cyan-400/50 hover:text-white"
            >
              View Live Demos
            </a>
            <a
              href="/studio"
              class="rounded-xl bg-[#00F2FE] px-4 py-2.5 text-sm font-bold text-[#06121A] transition-colors hover:bg-[#4FACFE]"
            >
              Open Founder Studio
            </a>
          </div>
        </div>
      </main>
    </BaseLayout>
  ) : (
    <BaseLayout
      title={`${prospect.businessName} | Instant 60-Second Driveway Quote`}
      description={prospect.tagline}
    >
      {isPreview && (
        <div class="border-b border-cyan-400/30 bg-[#061A26] px-4 py-2 text-xs text-cyan-50 sm:text-sm">
          <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-2">
            <div class="flex min-w-0 max-w-full flex-1 items-start gap-2.5 sm:items-center">
              <span class="relative mt-1 flex h-2 w-2 shrink-0 sm:mt-0">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#00F2FE] opacity-75" />
                <span class="relative inline-flex h-2 w-2 rounded-full bg-[#00F2FE]" />
              </span>
              <span class="leading-snug">
                <strong class="text-[#00F2FE]">Live Custom Preview</strong> prepared for{' '}
                <strong>{prospect.businessName}</strong> ({prospect.city}) - test your 60-second quote configurator below
              </span>
            </div>
            <a
              href="#quote-calculator"
              class="shrink-0 font-semibold text-[#00F2FE] underline decoration-cyan-400/50 underline-offset-4 hover:text-white"
            >
              Run Quote Test
            </a>
          </div>
        </div>
      )}

      {/* Sticky Glass Navigation Bar */}
      <nav class="sticky top-0 z-40 border-b border-slate-800/80 bg-[#0A0C10]/85 backdrop-blur-xl">
        <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6">
          <div class="flex min-w-0 items-center gap-3.5">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-cyan-400/40 bg-cyan-400/10 text-[#00F2FE] cyan-glow-sm">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 2L20 6.5V17.5L12 22L4 17.5V6.5L12 2Z" />
                <path d="M12 7L16 9.5V14.5L12 17L8 14.5V9.5L12 7Z" />
              </svg>
            </div>
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <span class="font-display truncate text-base font-bold tracking-tight text-white sm:text-lg">
                  {prospect.businessName}
                </span>
              </div>
              <div class="flex items-center gap-1.5 text-[11px] text-[#94A3B8]">
                <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-400" />
                <span class="truncate">Mobile Unit: {prospect.city}</span>
              </div>
            </div>
          </div>

          <div class="hidden items-center gap-7 text-xs font-semibold tracking-wide text-[#94A3B8] lg:flex">
            <a href="#quote-calculator" class="text-[#00F2FE] transition-colors hover:text-white">
              Configurator
            </a>
            <a href="#job-proof" class="transition-colors hover:text-white">
              Job Proof
            </a>
            <a href="#rig-specs" class="transition-colors hover:text-white">
              Mobile Rig
            </a>
            <a href="#faq" class="transition-colors hover:text-white">
              FAQ
            </a>
          </div>

          <div class="flex shrink-0 items-center gap-2.5">
            <a
              href={`tel:${prospect.phoneDisplay.replace(/[^+\d]/g, '')}`}
              class="hidden rounded-lg border border-slate-700/80 bg-slate-900/80 px-3.5 py-2 text-xs font-semibold text-slate-200 transition-colors hover:border-cyan-400/50 hover:text-white sm:inline-flex"
            >
              {prospect.phoneDisplay}
            </a>
            <a
              href="#quote-calculator"
              class="rounded-lg bg-[#00F2FE] px-4 py-2 text-xs font-bold text-[#06121A] transition-colors hover:bg-[#4FACFE] cyan-glow-sm sm:text-sm"
            >
              Get 60s Quote
            </a>
          </div>
        </div>
      </nav>

      {/* Atmospheric Wet-Bay Studio Hero */}
      <header class="carbon-mesh relative overflow-hidden border-b border-slate-800/80">
        <div class="tunnel-ambient pointer-events-none absolute -top-32 left-1/2 h-80 w-[90vw] max-w-[720px] -translate-x-1/2 rounded-full bg-[#00F2FE]/10 blur-[120px]" />

        <div class="mx-auto max-w-7xl px-4 pb-14 pt-10 sm:px-6 sm:pb-20 sm:pt-14">
          <div class="grid items-center gap-10 lg:grid-cols-12">
            {/* Left Copy & Metrics */}
            <div class="reveal-up is-visible min-w-0 lg:col-span-7">
              <div class="inline-flex max-w-full flex-wrap items-center gap-2 rounded-full border border-cyan-400/30 bg-cyan-400/10 px-3.5 py-1.5 text-xs">
                <span class="relative flex h-2 w-2">
                  <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#00F2FE] opacity-75" />
                  <span class="relative inline-flex h-2 w-2 rounded-full bg-[#00F2FE]" />
                </span>
                <span class="font-semibold text-white">{prospect.turnaroundBadge}</span>
                <span class="text-slate-500">|</span>
                <span class="font-bold text-amber-400">★ {prospect.ratingScore}</span>
                <span class="text-slate-300">({prospect.reviewCount}+ public reviews)</span>
                <span class="text-slate-500">|</span>
                <span class="text-[#00F2FE]">{prospect.instagramHandle}</span>
              </div>

              <h1 class="mt-5 max-w-[20ch] text-3xl font-bold leading-[1.08] tracking-tight text-white sm:text-5xl lg:text-[54px]">
                {prospect.heroHeadline}
              </h1>

              <p class="mt-4 max-w-2xl text-base leading-relaxed text-[#94A3B8] sm:text-lg">
                {prospect.heroSubheadline}
              </p>

              <div class="mt-7 flex flex-wrap items-center gap-4">
                <a
                  href="#quote-calculator"
                  class="group inline-flex items-center gap-2.5 rounded-xl bg-[#00F2FE] px-6 py-4 text-sm font-bold text-[#06121A] transition-colors hover:bg-[#4FACFE] cyan-glow sm:text-base"
                >
                  <span>Configure Driveway Quote</span>
                  <svg
                    class="h-4 w-4 transition-transform group-hover:translate-x-1"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </a>
                <a
                  href="#job-proof"
                  class="inline-flex items-center gap-2 rounded-xl border border-slate-700 bg-slate-900/70 px-5 py-4 text-sm font-semibold text-slate-200 transition-colors hover:border-cyan-400/50 hover:text-white"
                >
                  Inspect Gloss Proof
                </a>
              </div>

              {/* 4-Card Telemetry Strip */}
              <div class="mt-8 grid grid-cols-2 gap-3 border-t border-slate-800/80 pt-6 sm:grid-cols-4">
                <div class="glass-panel rounded-xl p-3.5">
                  <div class="font-display tabular-nums text-lg font-bold text-[#00F2FE]">
                    ★ {prospect.ratingScore}
                  </div>
                  <div class="mt-0.5 text-[11px] font-medium text-[#94A3B8]">
                    {prospect.reviewCount}+ Public Reviews
                  </div>
                </div>
                <div class="glass-panel rounded-xl p-3.5">
                  <div class="font-display tabular-nums text-lg font-bold text-white">
                    0 PPM
                  </div>
                  <div class="mt-0.5 text-[11px] font-medium text-[#94A3B8]">
                    Spot-Free Pure Rinse
                  </div>
                </div>
                <div class="glass-panel rounded-xl p-3.5">
                  <div class="font-display tabular-nums text-lg font-bold text-[#00F2FE]">
                    98+ GU
                  </div>
                  <div class="mt-0.5 text-[11px] font-medium text-[#94A3B8]">
                    Target Gloss Depth
                  </div>
                </div>
                <div class="glass-panel rounded-xl p-3.5">
                  <div class="font-display text-lg font-bold text-emerald-400">
                    60 Sec
                  </div>
                  <div class="mt-0.5 text-[11px] font-medium text-[#94A3B8]">
                    Instant Quote Flow
                  </div>
                </div>
              </div>
            </div>

            {/* Right Optical Bay Frame */}
            <div class="reveal-up is-visible stagger-1 lg:col-span-5">
              <div class="glass-panel anisotropic-border relative overflow-hidden rounded-2xl p-2">
                <div class="relative aspect-[4/3] overflow-hidden rounded-xl bg-[#070A0F]">
                  <img
                    src="/images/hero-wetbay.jpg"
                    alt={`${prospect.businessName} wet-bay detailing showcase`}
                    class="h-full w-full object-cover object-[70%_62%] scale-105"
                  />
                  {/* Mask upper-left background wall cleanly so image works for every city */}
                  <div
                    class="pointer-events-none absolute inset-0"
                    style="background: linear-gradient(125deg, rgba(10,12,16,0.92) 0%, rgba(10,12,16,0.42) 45%, rgba(10,12,16,0.08) 100%), linear-gradient(to top, rgba(10,12,16,0.94) 0%, transparent 52%);"
                  />

                  <div class="absolute inset-x-3 bottom-3 flex items-center justify-between gap-3 rounded-xl border border-slate-700/70 bg-[#0A0C10]/85 px-4 py-3 backdrop-blur-md">
                    <div class="min-w-0">
                      <div class="flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-[#00F2FE]">
                        <span class="h-1.5 w-1.5 rounded-full bg-[#00F2FE]" />
                        Autonomous Mobile Unit
                      </div>
                      <div class="mt-0.5 truncate text-xs text-slate-300">
                        Serving {prospect.serviceArea}
                      </div>
                    </div>
                    <div class="shrink-0 text-right">
                      <div class="font-display tabular-nums text-base font-bold text-white">
                        {prospect.currencySymbol}{initialMin}+
                      </div>
                      <div class="text-[10px] uppercase tracking-wider text-[#94A3B8]">
                        Base Reset
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </header>

      {/* Main Content */}
      <main class="mx-auto max-w-7xl px-4 pb-32 pt-12 sm:px-6 sm:pt-16">
        {/* Interactive 60-Second Driveway Quote Configurator */}
        <section
          id="quote-calculator"
          class="reveal-up glass-panel anisotropic-border rounded-2xl p-5 sm:p-8 lg:p-10"
        >
          <div class="flex flex-wrap items-start justify-between gap-6 border-b border-slate-800 pb-6">
            <div>
              <div class="inline-flex items-center gap-2 rounded-full border border-cyan-400/30 bg-cyan-400/10 px-3 py-1 text-xs font-semibold text-[#00F2FE]">
                Real-Time Driveway Estimator
              </div>
              <h2 class="mt-3 text-2xl font-bold tracking-tight text-white sm:text-3xl">
                60-Second Driveway Quote Configurator
              </h2>
              <p class="mt-1.5 text-sm text-[#94A3B8]">
                Tap your vehicle class, detailing tier, and condition for an instant {prospect.city} estimate.
              </p>
            </div>

            <div class="rounded-xl border border-cyan-400/35 bg-[#0A0C10]/90 px-5 py-3.5 cyan-glow-sm">
              <div class="text-[11px] font-semibold uppercase tracking-wider text-[#94A3B8]">
                Live Estimated Range
              </div>
              <div
                id="calc-top-estimate"
                class="font-display tabular-nums mt-0.5 text-2xl font-bold text-[#00F2FE] sm:text-3xl"
              >
                {prospect.currencySymbol}{initialMin} - {prospect.currencySymbol}{initialMax}
              </div>
              <div id="calc-top-duration" class="mt-0.5 text-xs text-slate-300">
                {defaultPkg?.durationLabel}
              </div>
            </div>
          </div>

          <form id="quote-form" class="mt-8 space-y-10" novalidate>
            <input type="hidden" name="slug" value={prospect.slug} />
            <div class="hidden" aria-hidden="true">
              <label for="website_url">Leave blank</label>
              <input
                id="website_url"
                name="website_url"
                type="text"
                tabindex="-1"
                autocomplete="off"
                value=""
              />
            </div>

            {/* Step 01: Vehicle Class with Custom SVG Silhouettes */}
            <div>
              <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-3">
                  <span class="font-display flex h-7 w-7 items-center justify-center rounded-full bg-[#00F2FE] text-xs font-bold text-[#06121A]">
                    01
                  </span>
                  <h3 class="text-base font-bold text-white sm:text-lg">
                    Select Vehicle Class
                  </h3>
                </div>
                <span class="text-xs font-semibold uppercase tracking-wider text-[#94A3B8]">
                  Step 1 of 4
                </span>
              </div>

              <div
                id="vehicle-size-group"
                class="mt-4 grid gap-4 md:grid-cols-3"
                role="radiogroup"
                aria-label="Vehicle size"
              >
                <button
                  type="button"
                  data-vehicle="sedan"
                  data-vehicle-label="Coupe / Sedan"
                  aria-checked="true"
                  role="radio"
                  class="vehicle-btn interactive-card flex flex-col justify-between rounded-xl border-2 border-[#00F2FE] bg-[#00F2FE]/8 p-5 text-left cyan-glow-sm"
                >
                  <div class="flex w-full items-start justify-between gap-3">
                    {/* Sedan SVG Silhouette */}
                    <svg class="h-10 w-24 text-[#00F2FE]" viewBox="0 0 120 44" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M10 30H22M40 30H82M100 30H110L112 24L104 20L82 18L66 10H36L20 18L10 21V30Z" />
                      <circle cx="31" cy="30" r="7" />
                      <circle cx="91" cy="30" r="7" />
                    </svg>
                    <span class="vehicle-dot h-4 w-4 rounded-full border-2 border-[#00F2FE] bg-[#00F2FE]" />
                  </div>
                  <div class="mt-3">
                    <div class="font-display text-base font-bold text-white">
                      Coupe / Sedan
                    </div>
                    <p class="mt-1 text-xs text-[#94A3B8]">
                      2-door or 4-door cars (Civic, Model 3, BMW 3 Series)
                    </p>
                    <div class="mt-3 text-[11px] font-bold uppercase tracking-wider text-[#00F2FE]">
                      Standard Baseline Scale
                    </div>
                  </div>
                </button>

                <button
                  type="button"
                  data-vehicle="suv"
                  data-vehicle-label="Mid-Size SUV"
                  aria-checked="false"
                  role="radio"
                  class="vehicle-btn interactive-card flex flex-col justify-between rounded-xl border border-slate-700/80 bg-[#0A0C10]/65 p-5 text-left hover:border-cyan-400/50"
                >
                  <div class="flex w-full items-start justify-between gap-3">
                    {/* Mid-Size SUV SVG Silhouette */}
                    <svg class="h-10 w-24 text-slate-300" viewBox="0 0 120 44" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M10 30H22M40 30H82M100 30H110L112 22L104 18L90 17L76 9H30L18 18L10 21V30Z" />
                      <circle cx="31" cy="30" r="7.5" />
                      <circle cx="91" cy="30" r="7.5" />
                    </svg>
                    <span class="vehicle-dot h-4 w-4 rounded-full border-2 border-slate-600" />
                  </div>
                  <div class="mt-3">
                    <div class="font-display text-base font-bold text-white">
                      Mid-Size SUV / Crossover
                    </div>
                    <p class="mt-1 text-xs text-[#94A3B8]">
                      2-row SUVs & wagons (RAV4, CR-V, Model Y, Porsche Macan)
                    </p>
                    <div class="mt-3 text-[11px] font-bold uppercase tracking-wider text-[#94A3B8]">
                      +Mid-Size Surface Area
                    </div>
                  </div>
                </button>

                <button
                  type="button"
                  data-vehicle="truck_xl"
                  data-vehicle-label="3-Row SUV / Pickup"
                  aria-checked="false"
                  role="radio"
                  class="vehicle-btn interactive-card flex flex-col justify-between rounded-xl border border-slate-700/80 bg-[#0A0C10]/65 p-5 text-left hover:border-cyan-400/50"
                >
                  <div class="flex w-full items-start justify-between gap-3">
                    {/* Pickup / Full-Size Truck SVG Silhouette */}
                    <svg class="h-10 w-24 text-slate-300" viewBox="0 0 120 44" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M8 30H21M39 30H83M101 30H113V19H72V9H34L20 18L8 21V30Z" />
                      <circle cx="30" cy="30" r="8" />
                      <circle cx="92" cy="30" r="8" />
                    </svg>
                    <span class="vehicle-dot h-4 w-4 rounded-full border-2 border-slate-600" />
                  </div>
                  <div class="mt-3">
                    <div class="font-display text-base font-bold text-white">
                      3-Row SUV / Pickup Truck
                    </div>
                    <p class="mt-1 text-xs text-[#94A3B8]">
                      Full-size trucks, minivans & XL SUVs (F-150, Tahoe, Range Rover)
                    </p>
                    <div class="mt-3 text-[11px] font-bold uppercase tracking-wider text-[#94A3B8]">
                      +Full-Size Rig Scale
                    </div>
                  </div>
                </button>
              </div>
            </div>

            {/* Step 02: Detailing Packages */}
            <div>
              <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-3">
                  <span class="font-display flex h-7 w-7 items-center justify-center rounded-full bg-[#00F2FE] text-xs font-bold text-[#06121A]">
                    02
                  </span>
                  <h3 class="text-base font-bold text-white sm:text-lg">
                    Choose Preservation Package
                  </h3>
                </div>
                <span class="text-xs font-semibold uppercase tracking-wider text-[#94A3B8]">
                  Step 2 of 4
                </span>
              </div>

              <div id="package-group" class="mt-4 grid gap-5 lg:grid-cols-3">
                {prospect.packages.map((pkg, idx) => {
                  const isDefault = defaultPkg ? pkg.id === defaultPkg.id : idx === 0;
                  return (
                    <button
                      type="button"
                      data-package-id={pkg.id}
                      data-package-name={pkg.name}
                      data-price-sedan={pkg.prices.sedan}
                      data-price-suv={pkg.prices.suv}
                      data-price-truck_xl={pkg.prices.truck_xl}
                      data-duration={pkg.durationLabel}
                      aria-pressed={isDefault ? 'true' : 'false'}
                      class={`package-btn interactive-card relative flex h-full flex-col justify-between rounded-xl p-6 text-left ${
                        isDefault
                          ? 'border-2 border-[#00F2FE] bg-[#00F2FE]/8 cyan-glow-sm'
                          : 'border border-slate-700/80 bg-[#0A0C10]/65 hover:border-cyan-400/50'
                      }`}
                    >
                      {pkg.popular && (
                        <span class="absolute -top-3 right-5 rounded-full bg-[#00F2FE] px-3 py-0.5 text-[10px] font-extrabold uppercase tracking-widest text-[#06121A]">
                          Most Booked
                        </span>
                      )}

                      <div>
                        <div class="flex items-start justify-between gap-2">
                          <span class="font-display text-lg font-bold text-white">
                            {pkg.name}
                          </span>
                          <span
                            class={`pkg-dot mt-1 h-4 w-4 shrink-0 rounded-full border-2 ${
                              isDefault
                                ? 'border-[#00F2FE] bg-[#00F2FE]'
                                : 'border-slate-600'
                            }`}
                          />
                        </div>
                        <p class="mt-1 text-xs text-[#94A3B8]">{pkg.tagline}</p>

                        <div class="mt-4 flex items-baseline gap-2 border-b border-slate-800 pb-4">
                          <span class="pkg-price-display font-display tabular-nums text-3xl font-bold text-[#00F2FE]">
                            {prospect.currencySymbol}{pkg.prices.sedan}
                          </span>
                          <span class="text-xs text-[#94A3B8]">
                            ({pkg.durationLabel})
                          </span>
                        </div>

                        <ul class="mt-4 space-y-2.5">
                          {pkg.features.map((feat) => (
                            <li class="flex items-start gap-2.5 text-xs leading-relaxed text-slate-200">
                              <span class="mt-0.5 font-bold text-[#00F2FE]">✓</span>
                              <span>{feat}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </button>
                  );
                })}
              </div>
            </div>

            {/* Step 03: Condition & Add-ons */}
