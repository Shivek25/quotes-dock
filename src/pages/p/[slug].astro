                  >
                    Text My Quote to {prospect.businessName} Now
                  </a>
                  <a
                    href={telHref}
                    class="inline-flex items-center justify-center rounded-xl border border-slate-600/80 bg-[#151D2A] px-4 py-2.5 text-xs font-semibold text-slate-100 transition-colors hover:border-sky-400/50 hover:text-white"
