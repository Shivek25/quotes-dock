    </div>

    <script
      is:inline
      define:vars={{
        currencySymbol: prospect.currencySymbol,
        defaultPackageId: defaultPkg?.id ?? "",
        defaultPackageName: defaultPkg?.name ?? "",
        businessName: prospect.businessName,
        prospectSlug: prospect.slug,
        prospectCity: prospect.city,
        prospectCountry: prospect.country,
        dialableDigits: hasDialablePhone ? phoneDigits : "",
        isFounderSelfTest,
      }}
    >
      (function () {
        const reducedMotion =
          typeof window.matchMedia === "function" &&
          window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        let selectedVehicle = "sedan";
        let selectedVehicleLabel = "Coupe / Sedan";
        let selectedPackageId = defaultPackageId;
        let selectedPackageName = defaultPackageName;
        let selectedCondition = "standard";

        const vehicleButtons = document.querySelectorAll(".vehicle-btn");
        const packageButtons = document.querySelectorAll(".package-btn");
        const conditionButtons = document.querySelectorAll(".condition-btn");
        const addonCheckboxes = document.querySelectorAll(".addon-checkbox");
        const stepNodes = document.querySelectorAll("[data-step-node]");

        const topEstEl = document.getElementById("calc-top-estimate");
        const topDurEl = document.getElementById("calc-top-duration");
        const formEstEl = document.getElementById("calc-form-estimate");
        const mobileEstEl = document.getElementById("mobile-sticky-estimate");
        const dockVehicleEl = document.getElementById("dock-vehicle-label");
        const dockPackageEl = document.getElementById("dock-package-label");
        const dockDurationEl = document.getElementById("dock-duration-label");

        const form = document.getElementById("quote-form");
        const submitBtn = document.getElementById("submit-quote-btn");
        const errorBox = document.getElementById("quote-error-box");

        const modal = document.getElementById("quote-success-modal");
        const modalSummary = document.getElementById("modal-customer-summary");
        const modalSms = document.getElementById("modal-owner-sms");
        const modalLiveSmsLink = document.getElementById("modal-live-sms-link");
        const modalCopyQuoteBtn = document.getElementById(
          "modal-copy-quote-btn",
        );
        const closeModalBtn = document.getElementById("close-modal-btn");
        const doneModalBtn = document.getElementById("done-modal-btn");
        let latestQuoteSummaryText = "";
        let maxStepReached = 1;

        const elRafMap = new WeakMap();
        const rangeStateMap = new WeakMap();
        const singleStateMap = new WeakMap();

        function setTelemetryStep(stepNum) {
          if (stepNum > maxStepReached) maxStepReached = stepNum;
          stepNodes.forEach((node) => {
            const num = Number(node.getAttribute("data-step-node") || "1");
            const active = num <= maxStepReached;
            node.className = active
              ? "flex items-center gap-2 rounded-lg border border-cyan-400/40 bg-cyan-400/10 px-3 py-2 text-xs font-semibold text-white transition-colors"
              : "flex items-center gap-2 rounded-lg border border-transparent px-3 py-2 text-xs font-semibold text-slate-300 transition-colors";
            const badge = node.querySelector("span");
            if (badge) {
              badge.className = active
                ? "font-mono text-[11px] font-bold text-[#00F2FE]"
                : "font-mono text-[11px] font-bold text-slate-400";
            }
          });
        }

        function animateRange(el, targetMin, targetMax, animate) {
          if (!el) return;
          const prev = rangeStateMap.get(el) || { min: targetMin, max: targetMax };
          const oldRaf = elRafMap.get(el);
          if (oldRaf) window.cancelAnimationFrame(oldRaf);

          if (!animate || reducedMotion || (prev.min === targetMin && prev.max === targetMax)) {
            rangeStateMap.set(el, { min: targetMin, max: targetMax });
            el.textContent = `${currencySymbol}${targetMin} - ${currencySymbol}${targetMax}`;
            return;
          }

          const startMin = prev.min;
          const startMax = prev.max;
          const startTime = performance.now();
          const durationMs = 240;

          const tick = (now) => {
            const t = Math.min(1, (now - startTime) / durationMs);
            const eased = 1 - Math.pow(1 - t, 3);
            const curMin = Math.round(startMin + (targetMin - startMin) * eased);
            const curMax = Math.round(startMax + (targetMax - startMax) * eased);
            rangeStateMap.set(el, { min: curMin, max: curMax });
            el.textContent = `${currencySymbol}${curMin} - ${currencySymbol}${curMax}`;
            if (t < 1) {
              elRafMap.set(el, window.requestAnimationFrame(tick));
            } else {
              elRafMap.delete(el);
            }
          };
          elRafMap.set(el, window.requestAnimationFrame(tick));
        }

        function animateSingle(el, targetVal, animate) {
          if (!el) return;
          const prev = singleStateMap.has(el) ? singleStateMap.get(el) : targetVal;
          const oldRaf = elRafMap.get(el);
          if (oldRaf) window.cancelAnimationFrame(oldRaf);

          if (!animate || reducedMotion || prev === targetVal) {
            singleStateMap.set(el, targetVal);
            el.textContent = `${currencySymbol}${targetVal}`;
            return;
          }

          const startTime = performance.now();
          const durationMs = 240;
          const tick = (now) => {
            const t = Math.min(1, (now - startTime) / durationMs);
            const eased = 1 - Math.pow(1 - t, 3);
            const cur = Math.round(prev + (targetVal - prev) * eased);
            singleStateMap.set(el, cur);
            el.textContent = `${currencySymbol}${cur}`;
            if (t < 1) {
              elRafMap.set(el, window.requestAnimationFrame(tick));
            } else {
              elRafMap.delete(el);
            }
          };
          elRafMap.set(el, window.requestAnimationFrame(tick));
        }

        modalCopyQuoteBtn?.addEventListener("click", async () => {
          if (!latestQuoteSummaryText) return;
          try {
            await navigator.clipboard.writeText(latestQuoteSummaryText);
            const prev = modalCopyQuoteBtn.textContent;
            modalCopyQuoteBtn.textContent = "Copied Summary!";
            setTimeout(() => {
              modalCopyQuoteBtn.textContent = prev;
            }, 1800);
          } catch {
            // Clipboard unavailable
          }
        });

        function pulsePrice(el) {
          if (!el || reducedMotion) return;
          el.classList.remove("price-bump");
          void el.offsetWidth;
          el.classList.add("price-bump");
        }

        function getConditionSpread(cond) {
          if (cond === "pet_hair") return [25, 45];
          if (cond === "heavy_soil") return [35, 65];
          return [0, 20];
        }

        function updatePricingDisplay(animate = true) {
          packageButtons.forEach((btn) => {
            const priceAttr = btn.getAttribute(`data-price-${selectedVehicle}`);
            const priceEl = btn.querySelector(".pkg-price-display");
            if (priceAttr && priceEl) {
              animateSingle(priceEl, Number(priceAttr), animate);
            }
          });

          const activePkgBtn = document.querySelector(
            `.package-btn[data-package-id="${selectedPackageId}"]`,
          );
          if (!activePkgBtn) return;

          const basePrice = Number(
            activePkgBtn.getAttribute(`data-price-${selectedVehicle}`) || "145",
          );
          const duration = activePkgBtn.getAttribute("data-duration") || "";
          const [condMin, condMax] = getConditionSpread(selectedCondition);

          let addonsSum = 0;
          addonCheckboxes.forEach((cb) => {
            if (cb.checked) {
              addonsSum += Number(cb.getAttribute("data-addon-price") || "0");
            }
          });

          const estMin = basePrice + condMin + addonsSum;
          const estMax = basePrice + condMax + addonsSum;

          if (topEstEl) {
            animateRange(topEstEl, estMin, estMax, animate);
            if (animate) pulsePrice(topEstEl);
          }
          if (topDurEl) topDurEl.textContent = duration;
          if (formEstEl) {
            animateRange(formEstEl, estMin, estMax, animate);
            if (animate) pulsePrice(formEstEl);
          }
          if (mobileEstEl) {
            animateRange(mobileEstEl, estMin, estMax, animate);
            if (animate) pulsePrice(mobileEstEl);
          }
          if (dockVehicleEl) dockVehicleEl.textContent = selectedVehicleLabel;
          if (dockPackageEl) dockPackageEl.textContent = selectedPackageName;
          if (dockDurationEl) {
            dockDurationEl.textContent = `${duration} · Zero upfront payment`;
          }
        }

        function setVehicle(size, label) {
          selectedVehicle = size;
          selectedVehicleLabel = label;
          setTelemetryStep(1);
          vehicleButtons.forEach((btn) => {
            const active = btn.getAttribute("data-vehicle") === size;
            btn.setAttribute("aria-checked", active ? "true" : "false");
            btn.className = active
              ? "vehicle-btn interactive-card spotlight-card flex flex-col justify-between rounded-xl border-2 border-[#00F2FE] bg-[#00F2FE]/10 p-5 text-left cyan-glow-sm"
              : "vehicle-btn interactive-card spotlight-card flex flex-col justify-between rounded-xl border border-slate-700/80 bg-[#090C12]/80 p-5 text-left hover:border-cyan-400/50";
            const bayGlow = btn.querySelector(".vehicle-bay-glow");
            if (bayGlow) {
              bayGlow.className = active
                ? "bay-floor-glow vehicle-bay-glow flex w-full items-start justify-between gap-3 rounded-lg pb-1"
                : "vehicle-bay-glow flex w-full items-start justify-between gap-3 rounded-lg pb-1";
            }
            const svgs = btn.querySelectorAll("svg");
            if (svgs[0]) {
              svgs[0].setAttribute(
                "class",
                active
                  ? "pointer-events-none -mb-1 h-2 w-24 text-[#00F2FE]/45"
                  : "pointer-events-none -mb-1 h-2 w-24 text-slate-500/35",
              );
            }
            const carSvg = svgs[1] || svgs[0];
            if (carSvg) {
              carSvg.setAttribute(
                "class",
                active
                  ? "h-10 w-24 text-[#00F2FE]"
                  : "h-10 w-24 text-slate-300",
              );
            }
            const dot = btn.querySelector(".vehicle-dot");
            if (dot) {
              dot.className = active
                ? "vehicle-dot h-4 w-4 rounded-full border-2 border-[#00F2FE] bg-[#00F2FE]"
                : "vehicle-dot h-4 w-4 rounded-full border-2 border-slate-500";
            }
          });
          updatePricingDisplay(true);
        }

        function setPackage(pkgId, pkgName) {
          selectedPackageId = pkgId;
          selectedPackageName = pkgName;
          setTelemetryStep(2);
          packageButtons.forEach((btn) => {
            const active = btn.getAttribute("data-package-id") === pkgId;
            btn.setAttribute("aria-pressed", active ? "true" : "false");
            btn.className = active
              ? "package-btn interactive-card spotlight-card relative flex h-full flex-col justify-between rounded-xl border-2 border-[#00F2FE] bg-[#00F2FE]/10 p-6 text-left cyan-glow-sm"
              : "package-btn interactive-card spotlight-card relative flex h-full flex-col justify-between rounded-xl border border-slate-700/80 bg-[#090C12]/80 p-6 text-left hover:border-cyan-400/50";
            const dot = btn.querySelector(".pkg-dot");
            if (dot) {
              dot.className = active
                ? "pkg-dot mt-1 h-4 w-4 shrink-0 rounded-full border-2 border-[#00F2FE] bg-[#00F2FE]"
                : "pkg-dot mt-1 h-4 w-4 shrink-0 rounded-full border-2 border-slate-500";
            }
          });
          updatePricingDisplay(true);
        }

        function setCondition(cond) {
          selectedCondition = cond;
          setTelemetryStep(3);
          conditionButtons.forEach((btn) => {
            const active = btn.getAttribute("data-condition") === cond;
            btn.className = active
              ? "condition-btn interactive-card spotlight-card flex w-full items-center justify-between rounded-xl border-2 border-[#00F2FE] bg-[#00F2FE]/10 px-4 py-3.5 text-left"
              : "condition-btn interactive-card spotlight-card flex w-full items-center justify-between rounded-xl border border-slate-700/80 bg-[#090C12]/80 px-4 py-3.5 text-left hover:border-cyan-400/50";
          });
          updatePricingDisplay(true);
        }

        vehicleButtons.forEach((btn) => {
          btn.addEventListener("click", () => {
            const val = btn.getAttribute("data-vehicle");
            const label =
              btn.getAttribute("data-vehicle-label") || "Coupe / Sedan";
            if (val) setVehicle(val, label);
          });
        });

        packageButtons.forEach((btn) => {
          btn.addEventListener("click", () => {
            const val = btn.getAttribute("data-package-id");
            const name = btn.getAttribute("data-package-name") || "";
            if (val) setPackage(val, name);
          });
        });

        conditionButtons.forEach((btn) => {
          btn.addEventListener("click", () => {
            const val = btn.getAttribute("data-condition");
            if (val) setCondition(val);
          });
        });

        addonCheckboxes.forEach((cb) => {
          cb.addEventListener("change", () => {
            setTelemetryStep(3);
            const parentLabel = cb.closest(".addon-label");
            if (parentLabel) {
              parentLabel.className = cb.checked
                ? "addon-label interactive-card spotlight-card flex min-w-0 cursor-pointer items-start gap-3 rounded-xl border-2 border-[#00F2FE] bg-[#00F2FE]/10 p-3.5"
                : "addon-label interactive-card spotlight-card flex min-w-0 cursor-pointer items-start gap-3 rounded-xl border border-slate-700/80 bg-[#090C12]/80 p-3.5 hover:border-cyan-400/50";
            }
            updatePricingDisplay(true);
          });
        });

        ["customerName", "customerPhone", "customerPostal", "preferredTiming", "notes"].forEach((id) => {
          document.getElementById(id)?.addEventListener("focus", () => {
            setTelemetryStep(4);
          });
        });

        // Interactive Before / After toggles on Job Proof cards (notes + optional before image)
        document.querySelectorAll("[data-proof-card]").forEach((card) => {
          const buttons = card.querySelectorAll(".proof-tab-btn");
          const noteEl = card.querySelector(".proof-note");
          const imgEl = card.querySelector(".proof-img");
          if (!noteEl) return;

          buttons.forEach((btn) => {
            btn.addEventListener("click", () => {
              const mode = btn.getAttribute("data-toggle-proof");
              buttons.forEach((b) => {
                const isActive = b === btn;
                b.className = isActive
                  ? "proof-tab-btn rounded-lg bg-[#00F2FE]/15 px-2.5 py-1 text-[11px] font-bold text-[#7DD3FC] ring-1 ring-cyan-400/40"
                  : "proof-tab-btn rounded-lg px-2.5 py-1 text-[11px] font-semibold text-[#CBD5E1] hover:text-white";
              });
              if (!reducedMotion && noteEl instanceof HTMLElement) {
                noteEl.style.opacity = "0.4";
                window.requestAnimationFrame(() => {
                  noteEl.style.opacity = "1";
                });
              }
              if (mode === "before") {
                noteEl.textContent = noteEl.getAttribute("data-before-text") || "";
                noteEl.className = "proof-note mt-2.5 text-xs leading-snug text-amber-200 transition-opacity duration-200";
                const beforeSrc = imgEl?.getAttribute("data-before-src");
                if (imgEl && beforeSrc) imgEl.setAttribute("src", beforeSrc);
              } else {
                noteEl.textContent = noteEl.getAttribute("data-after-text") || "";
                noteEl.className = "proof-note mt-2.5 text-xs leading-snug text-emerald-300 transition-opacity duration-200";
                const afterSrc = imgEl?.getAttribute("data-after-src");
                if (imgEl && afterSrc) imgEl.setAttribute("src", afterSrc);
              }
            });
          });
        });

        // Preview Claim & Removal Forms
        const modalClaimBtn = document.getElementById("modal-claim-btn");
        modalClaimBtn?.addEventListener("click", () => {
          closeModal();
          const claimSection = document.getElementById("claim-preview");
          claimSection?.scrollIntoView({ behavior: "smooth", block: "start" });
          const nameInput = document.getElementById("claimOwnerName");
          if (nameInput) setTimeout(() => nameInput.focus(), 350);
        });

        const claimForm = document.getElementById("claim-preview-form");
        const claimFeedback = document.getElementById("claim-feedback");
        const claimSubmitBtn = document.getElementById("claim-submit-btn");
        claimForm?.addEventListener("submit", async (e) => {
          e.preventDefault();
          if (!claimForm || !claimFeedback || !claimSubmitBtn) return;
          claimFeedback.classList.add("hidden");
          const fd = new FormData(claimForm);
          const orig = claimSubmitBtn.textContent;
          claimSubmitBtn.setAttribute("disabled", "true");
          claimSubmitBtn.textContent = "Submitting Claim...";
          try {
            const res = await fetch("/api/inquiries", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                inquiryType: "claim_page",
                slug: prospectSlug,
                businessName,
                ownerName: String(fd.get("ownerName") || ""),
                contactInfo: String(fd.get("contactInfo") || ""),
                city: prospectCity,
                country: prospectCountry,
                planTier: "founding",
                notes: String(fd.get("notes") || ""),
                website_url: String(fd.get("website_url") || ""),
              }),
            });
            const data = await res.json().catch(() => null);
            if (!res.ok || !data?.ok) {
              claimFeedback.textContent =
                data?.error || "Could not submit claim. Please check your details.";
              claimFeedback.className =
                "rounded-xl border border-red-400/40 bg-red-950/60 px-3.5 py-2.5 text-xs font-semibold text-red-200";
              return;
            }
            claimFeedback.textContent =
              "Claim received! We will reach out shortly to swap in your real photos and activate Live Mode within 24 hours.";
            claimFeedback.className =
              "rounded-xl border border-emerald-400/40 bg-emerald-950/60 px-3.5 py-2.5 text-xs font-semibold text-emerald-200";
            claimForm.reset();
          } catch {
            claimFeedback.textContent = "Network error submitting claim. Please try again.";
            claimFeedback.className =
              "rounded-xl border border-red-400/40 bg-red-950/60 px-3.5 py-2.5 text-xs font-semibold text-red-200";
          } finally {
            claimSubmitBtn.removeAttribute("disabled");
            claimSubmitBtn.textContent = orig;
          }
        });

        const removalForm = document.getElementById("removal-request-form");
        const removalFeedback = document.getElementById("removal-feedback");
        removalForm?.addEventListener("submit", async (e) => {
          e.preventDefault();
          if (!removalForm || !removalFeedback) return;
          removalFeedback.classList.add("hidden");
          const fd = new FormData(removalForm);
          try {
            const res = await fetch("/api/inquiries", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                inquiryType: "removal_request",
                slug: prospectSlug,
                businessName,
                ownerName: String(fd.get("ownerName") || ""),
                contactInfo: String(fd.get("contactInfo") || ""),
                city: prospectCity,
                country: prospectCountry,
                planTier: "founding",
                notes: "Owner requested preview edit or removal.",
                website_url: "",
              }),
            });
            const data = await res.json().catch(() => null);
            if (!res.ok || !data?.ok) {
              removalFeedback.textContent = data?.error || "Could not submit request.";
              removalFeedback.className =
                "rounded-lg border border-red-400/40 bg-red-950/60 px-3 py-2 text-xs font-semibold text-red-200";
              return;
            }
            removalFeedback.textContent =
              "Request logged. We will update or remove this preview promptly.";
            removalFeedback.className =
              "rounded-lg border border-emerald-400/40 bg-emerald-950/60 px-3 py-2 text-xs font-semibold text-emerald-200";
            removalForm.reset();
          } catch {
            removalFeedback.textContent = "Network error submitting request.";
            removalFeedback.className =
              "rounded-lg border border-red-400/40 bg-red-950/60 px-3 py-2 text-xs font-semibold text-red-200";
          }
        });

        function closeModal() {
          if (!modal) return;
          modal.classList.add("hidden");
          modal.classList.remove("flex");
        }

        closeModalBtn?.addEventListener("click", closeModal);
        doneModalBtn?.addEventListener("click", closeModal);
        modal?.addEventListener("click", (e) => {
          if (e.target === modal) closeModal();
        });
        document.addEventListener("keydown", (e) => {
          if (
            e.key === "Escape" &&
            modal &&
            !modal.classList.contains("hidden")
          ) {
            closeModal();
          }
        });

        form?.addEventListener("submit", async (e) => {
          e.preventDefault();
          if (!form || !submitBtn || !errorBox) return;

          errorBox.classList.add("hidden");
          errorBox.textContent = "";

          const formData = new FormData(form);
          const selectedAddons = [];
          addonCheckboxes.forEach((cb) => {
            if (cb.checked) selectedAddons.push(cb.value);
          });

          const payload = {
            slug: String(formData.get("slug") || ""),
            customerName: String(formData.get("customerName") || ""),
            customerPhone: String(formData.get("customerPhone") || ""),
            customerPostal: String(formData.get("customerPostal") || ""),
            vehicleSize: selectedVehicle,
            packageId: selectedPackageId,
            conditionLevel: selectedCondition,
            addonsSelected: selectedAddons,
            preferredTiming: String(
              formData.get("preferredTiming") || "this_week",
            ),
            notes: String(formData.get("notes") || ""),
            website_url: String(formData.get("website_url") || ""),
            isFounderSelfTest,
          };

          const originalText = submitBtn.textContent;
          submitBtn.disabled = true;
          submitBtn.textContent = "Calculating & Saving Quote...";

          try {
            const res = await fetch("/api/quotes", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload),
            });
            const result = await res.json();

            if (!res.ok || !result.ok) {
              errorBox.textContent =
                result.error ||
                "Please check your name, phone number, and postal code.";
              errorBox.classList.remove("hidden");
              if (result.field) {
                const invalidEl = document.getElementById(result.field);
                if (invalidEl) {
                  invalidEl.scrollIntoView({
                    behavior: "smooth",
                    block: "center",
                  });
                  invalidEl.focus();
                }
              }
              return;
            }

            if (result.quote && modalSummary && modal) {
              modalSummary.innerHTML = "";
              const line1 = document.createElement("div");
              line1.className = "font-bold text-white";
              line1.textContent = `${result.quote.vehicleLabel} · ${result.quote.packageName}`;

              const line2 = document.createElement("div");
              line2.className = "mt-1 text-xs text-[#7DD3FC] font-semibold";
              line2.textContent = `Estimated Range: ${result.quote.priceRange} (${result.quote.durationLabel})`;

              const line3 = document.createElement("div");
              line3.className = "mt-1 text-xs text-[#CBD5E1]";
              line3.textContent = `Contact: ${result.quote.customerName} (${result.quote.customerPhone}) · ${result.quote.customerPostal}`;

              modalSummary.appendChild(line1);
              modalSummary.appendChild(line2);
              modalSummary.appendChild(line3);

              if (modalSms) {
                modalSms.textContent = result.ownerPreview?.smsPreview || "";
              }
              const smsBody =
                `Hi ${businessName}, I just submitted a 60s quote request on your page:\n` +
                `Vehicle: ${result.quote.vehicleLabel}\n` +
                `Package: ${result.quote.packageName}\n` +
                `Est: ${result.quote.priceRange}\n` +
                `Area: ${result.quote.customerPostal} | Timing: ${result.quote.timingLabel}` +
                (result.quote.notes ? `\nNotes: ${result.quote.notes}` : "");
              latestQuoteSummaryText = smsBody;
              if (modalLiveSmsLink && dialableDigits) {
                modalLiveSmsLink.setAttribute(
                  "href",
                  `sms:${dialableDigits}?body=${encodeURIComponent(smsBody)}`,
                );
              }

              modal.classList.remove("hidden");
              modal.classList.add("flex");
              // Clear contact fields only so the calculator summary stays synced with the modal
              ["customerName", "customerPhone", "customerPostal", "notes"].forEach((id) => {
                const inputEl = document.getElementById(id);
                if (inputEl && "value" in inputEl) inputEl.value = "";
              });
            }
          } catch {
            errorBox.textContent =
              "Network error while submitting quote. Please try again.";
            errorBox.classList.remove("hidden");
          } finally {
            submitBtn.disabled = false;
            submitBtn.textContent = originalText;
          }
        });

        updatePricingDisplay(false);
      })();
    </script>
  </BaseLayout>
)}
