                                  class="w-full rounded-lg border border-slate-700 bg-[#0C1017] px-2.5 py-1 text-xs text-slate-100 placeholder:text-slate-400"
                                />
                                <div class="grid grid-cols-2 gap-1.5">
                                  <input
                                    name={`jobVehicle_${idx}`}
                                    type="text"
                                    value={slot.vehicleLabel}
                                    placeholder="Vehicle (e.g. 2023 BMW X5)"
                                    class="w-full rounded-lg border border-slate-700 bg-[#0C1017] px-2 py-1 text-[11px] text-slate-100 placeholder:text-slate-400"
                                  />
                                  <input
                                    name={`jobService_${idx}`}
                                    type="text"
                                    value={slot.servicePerformed}
                                    placeholder="Service performed"
                                    class="w-full rounded-lg border border-slate-700 bg-[#0C1017] px-2 py-1 text-[11px] text-slate-100 placeholder:text-slate-400"
                                  />
                                </div>
                                <div class="grid grid-cols-2 gap-1.5">
                                  <input
                                    name={`jobBefore_${idx}`}
                                    type="text"
                                    value={slot.beforeNote}
                                    placeholder="Before note"
                                    class="w-full rounded-lg border border-slate-700 bg-[#0C1017] px-2 py-1 text-[11px] text-slate-200 placeholder:text-slate-400"
                                  />
                                  <input
                                    name={`jobAfter_${idx}`}
                                    type="text"
                                    value={slot.afterNote}
                                    placeholder="After note"
                                    class="w-full rounded-lg border border-slate-700 bg-[#0C1017] px-2 py-1 text-[11px] text-slate-200 placeholder:text-slate-400"
                                  />
                                </div>
                              </div>
                            ))}
                          </div>
                        </div>

                        <div class="flex flex-wrap items-center justify-between gap-2 pt-1">
                          <div class="flex flex-wrap items-center gap-2">
                            <button
                              type="submit"
                              class="save-details-btn rounded-lg bg-slate-800 px-3 py-1.5 text-xs font-bold text-slate-100 ring-1 ring-slate-600 hover:border-[#38BDF8] hover:text-[#7DD3FC]"
                            >
                              Save Client Changes
                            </button>
                            <button
                              type="button"
                              data-save-live={prospect.id}
                              class="save-and-live-btn rounded-lg bg-[#38BDF8] px-3 py-1.5 text-xs font-bold text-[#06131F] hover:bg-[#7DD3FC]"
                            >
                              Save &amp; Go Live
                            </button>
                            {prospect.ownerPortalToken && (
                              <button
                                type="button"
                                data-rotate-portal={prospect.id}
                                class="rotate-portal-btn rounded-lg border border-slate-600 bg-[#151D2A] px-3 py-1.5 text-xs font-semibold text-slate-200 hover:border-amber-400/50 hover:text-amber-200"
                              >
                                Rotate Owner Link
                              </button>
                            )}
                          </div>

                          <button
                            type="button"
                            data-delete-prospect={prospect.id}
                            class="delete-prospect-btn rounded-lg border border-red-400/35 bg-red-950/40 px-3 py-1.5 text-xs font-bold text-red-200 hover:bg-red-900/50"
                          >
                            Delete Prospect
                          </button>
                        </div>
                      </form>
                    </details>

                    {/* Recent Quotes */}
                    {recentQuotes.length > 0 && (
                      <div class="mt-4 rounded-xl border border-sky-400/25 bg-[#0C1017]/75 p-3.5">
                        <div class="text-xs font-bold text-[#7DD3FC]">
                          Recent Quote Submissions ({recentQuotes.length} latest)
                        </div>
                        <ul class="mt-2 space-y-1.5 text-xs text-slate-200">
                          {recentQuotes.map((q) => {
                            const deliveryMeta =
                              deliveryStatusBadges[q.deliveryStatus] ||
                              deliveryStatusBadges.not_applicable;
                            return (
                              <li class="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-slate-800/90 bg-[#090C12]/90 px-3 py-2">
                                <div class="min-w-0">
                                  <span>
                                    <strong class="text-slate-50">{q.customerName}</strong> ({q.customerPhone}) · {q.vehicleSize.toUpperCase()} · {q.packageName}
                                  </span>
                                  {q.deliveryStatus === 'config_missing' ? (
                                    <div class="mt-0.5 text-[11px] text-slate-400">
                                      Saved in Owner Inbox (/owner link). Connect FOUNDER_WEBHOOK_URL or Resend keys for instant push/email alerts.
                                    </div>
                                  ) : (
                                    q.deliveryError && (
                                      <div class="mt-0.5 text-[11px] text-red-300">
                                        Alert error: {q.deliveryError}
                                      </div>
                                    )
                                  )}
                                </div>
                                <div class="flex items-center gap-2">
                                  <span
                                    class={`rounded-full border px-2 py-0.5 text-[10px] font-bold ${deliveryMeta.classes}`}
                                  >
                                    {deliveryMeta.label}
                                  </span>
                                  <span class="font-display tabular-nums font-bold text-[#38BDF8]">
                                    {prospect.currencySymbol}{q.estimatedMin} - {prospect.currencySymbol}{q.estimatedMax}
                                  </span>
                                </div>
                              </li>
                            );
                          })}
                        </ul>
                      </div>
                    )}

                    {/* Outreach Drafts */}
                    <div class="mt-4 space-y-4">
                      {drafts.map((draft) => (
                        <div
                          class="rounded-xl border border-slate-800 bg-[#0C1017]/90 p-4"
                          data-draft-box={draft.id}
                        >
                          <div class="flex flex-wrap items-center justify-between gap-2">
                            <div class="flex items-center gap-2">
                              <span class="rounded bg-slate-800 px-2 py-0.5 text-xs font-bold text-[#7DD3FC]">
                                {channelLabels[draft.channel] || draft.channel}
                              </span>
                              <span class="text-xs text-[#CBD5E1]">
                                to {draft.recipientHandle}
                              </span>
                            </div>

                            <span
                              class={`draft-status-pill rounded-full border px-2.5 py-0.5 text-[11px] font-bold ${
                                statusBadgeClasses[draft.approvalStatus] || statusBadgeClasses.draft
                              }`}
                            >
                              {statusLabels[draft.approvalStatus] || draft.approvalStatus}
                            </span>
                          </div>

                          <textarea
                            rows="4"
                            data-draft-textarea={draft.id}
                            class="mt-2.5 w-full rounded-xl border border-slate-700/80 bg-[#151D2A] p-3 text-xs leading-relaxed text-slate-100"
                          >{draft.messageBody}</textarea>

                          <div class="mt-2.5 flex flex-wrap items-center justify-between gap-2">
                            <div class="flex flex-wrap items-center gap-2">
                              <button
                                type="button"
                                data-draft-save={draft.id}
                                data-prospect-id={prospect.id}
                                data-status="approved"
                                class="draft-action-btn rounded-lg bg-[#38BDF8] px-3 py-1.5 text-xs font-bold text-[#06131F] transition-colors hover:bg-[#7DD3FC]"
                              >
                                Save &amp; Approve
                              </button>
                              <button
                                type="button"
                                data-draft-save={draft.id}
                                data-prospect-id={prospect.id}
                                data-status="sent_manually"
                                class="draft-action-btn rounded-lg border border-emerald-400/40 bg-emerald-500/15 px-3 py-1.5 text-xs font-bold text-emerald-300 transition-colors hover:bg-emerald-500/25"
                              >
                                Mark Sent Manually
                              </button>
                              <button
                                type="button"
                                data-draft-save={draft.id}
                                data-prospect-id={prospect.id}
                                data-status="replied"
                                class="draft-action-btn rounded-lg border border-amber-400/40 bg-amber-400/15 px-3 py-1.5 text-xs font-bold text-amber-200 transition-colors hover:bg-amber-400/25"
                              >
                                Owner Replied
                              </button>
                            </div>

                            <button
                              type="button"
                              data-copy-draft={draft.id}
                              data-slug={prospect.slug}
                              class="copy-draft-btn rounded-lg border border-slate-600/80 bg-[#151D2A] px-3 py-1.5 text-xs font-bold text-slate-100 transition-colors hover:border-sky-400/50 hover:text-white"
                            >
                              Copy Message
                            </button>
                          </div>
                        </div>
                      ))}
                    </div>
                  </article>
                );
              })}
            </div>
          )}

          {/* Built-in Sandbox Demos (Collapsible so real prospect KPIs stay pure) */}
          {sandboxItems.length > 0 && (
            <details class="glass-panel rounded-2xl border border-slate-700/80 p-5">
              <summary class="cursor-pointer select-none text-sm font-bold text-slate-100 hover:text-[#7DD3FC]">
                Built-in Sandbox Demos ({sandboxItems.length}) - Isolated from Owner-Tested KPIs
              </summary>
              <div class="mt-5 space-y-5">
                {sandboxItems.map(({ prospect, drafts, recentQuotes }) => (
                  <article
                    class="rounded-2xl border border-slate-800 bg-[#0C1017]/80 p-4"
                    data-prospect-card={prospect.id}
                  >
                    <div class="flex flex-wrap items-center justify-between gap-3">
                      <div>
                        <div class="flex flex-wrap items-center gap-2">
                          <h3 class="text-base font-bold text-slate-50">
                            {prospect.businessName}
                          </h3>
                          <span class="rounded bg-slate-800 px-2 py-0.5 text-xs font-semibold text-slate-200">
                            {prospect.city} ({prospect.country})
                          </span>
                          <span class="rounded-full bg-sky-400/15 px-2.5 py-0.5 text-[11px] font-bold text-[#7DD3FC] ring-1 ring-sky-400/30">
                            Sandbox Demo
                          </span>
                        </div>
                        <div class="mt-1 text-xs text-[#CBD5E1]">
                          Link: <code class="text-[#7DD3FC]">/p/{prospect.slug}</code> · {recentQuotes.length} sandbox submission(s)
                        </div>
                      </div>
                      <a
                        href={`/p/${prospect.slug}?founder=1`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="rounded-xl border border-slate-600/80 bg-[#151D2A] px-3 py-1.5 text-xs font-bold text-slate-100 hover:border-sky-400/50 hover:text-white"
                      >
                        Open Sandbox
                      </a>
                    </div>

                    {drafts[0] && (
                      <div class="mt-3 rounded-xl border border-slate-800 bg-[#151D2A]/75 p-3" data-draft-box={drafts[0].id}>
                        <div class="flex flex-wrap items-center justify-between gap-2">
                          <span class="text-xs font-bold text-[#7DD3FC]">
                            Sample {channelLabels[drafts[0].channel] || drafts[0].channel} Draft
                          </span>
                          <button
                            type="button"
                            data-copy-draft={drafts[0].id}
                            data-slug={prospect.slug}
                            class="copy-draft-btn rounded-lg border border-slate-600/80 bg-[#0C1017] px-2.5 py-1 text-[11px] font-bold text-slate-100 hover:border-sky-400/50 hover:text-white"
                          >
                            Copy Sample
                          </button>
                        </div>
                        <textarea
                          rows="2"
                          data-draft-textarea={drafts[0].id}
                          class="mt-2 w-full rounded-lg border border-slate-800 bg-[#0C1017] p-2.5 text-xs text-slate-200"
                        >{drafts[0].messageBody}</textarea>
                      </div>
                    )}
                  </article>
                ))}
              </div>
            </details>
          )}
        </section>
      </div>
    </main>
  )}

  <div
    id="studio-toast"
    role="status"
    class="pointer-events-none fixed bottom-5 right-5 z-50 hidden rounded-xl border border-sky-400/40 bg-[#151D2A] px-4 py-2.5 text-xs font-bold text-[#7DD3FC] shadow-xl cyan-glow-sm"
  />

  <script is:inline>
    (function () {
      const form = document.getElementById('new-prospect-form');
      const createBtn = document.getElementById('create-prospect-btn');
      const errBox = document.getElementById('prospect-error');
      const okBox = document.getElementById('prospect-success');
      const toastEl = document.getElementById('studio-toast');
      const domainInput = document.getElementById('public-domain-input');
      const resetDomainBtn = document.getElementById('reset-domain-btn');
      const DOMAIN_STORAGE_KEY = 'qd_public_domain';

      if (domainInput) {
        const saved = localStorage.getItem(DOMAIN_STORAGE_KEY);
        domainInput.value = saved || window.location.origin;
        domainInput.addEventListener('input', () => {
          localStorage.setItem(DOMAIN_STORAGE_KEY, domainInput.value.trim());
        });
      }

      resetDomainBtn?.addEventListener('click', () => {
        if (!domainInput) return;
        domainInput.value = window.location.origin;
        localStorage.removeItem(DOMAIN_STORAGE_KEY);
        showToast('Share domain set to current origin');
      });

      function showToast(text, variant) {
        if (!toastEl) return;
        toastEl.textContent = text;
        toastEl.className =
          variant === 'warn'
            ? 'pointer-events-none fixed bottom-5 right-5 z-50 rounded-xl border border-amber-400/50 bg-[#1C1608] px-4 py-2.5 text-xs font-bold text-amber-200 shadow-xl'
            : variant === 'error'
              ? 'pointer-events-none fixed bottom-5 right-5 z-50 rounded-xl border border-red-400/50 bg-red-950 px-4 py-2.5 text-xs font-bold text-red-200 shadow-xl'
              : 'pointer-events-none fixed bottom-5 right-5 z-50 rounded-xl border border-sky-400/40 bg-[#151D2A] px-4 py-2.5 text-xs font-bold text-[#7DD3FC] shadow-xl cyan-glow-sm';
        setTimeout(() => {
          toastEl.classList.add('hidden');
        }, variant === 'warn' ? 3600 : 2200);
      }

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!form || !createBtn || !errBox || !okBox) return;

        errBox.classList.add('hidden');
        okBox.classList.add('hidden');

        const fd = new FormData(form);
        const payload = {
          businessName: String(fd.get('businessName') || ''),
          slug: String(fd.get('slug') || ''),
          city: String(fd.get('city') || ''),
          country: String(fd.get('country') || 'US'),
          serviceArea: String(fd.get('serviceArea') || ''),
          phoneDisplay: String(fd.get('phoneDisplay') || ''),
          instagramHandle: String(fd.get('instagramHandle') || ''),
          ratingScore: String(fd.get('ratingScore') || '4.9'),
          reviewCount: Number(fd.get('reviewCount') || 45),
          baseSedanPrice: fd.get('baseSedanPrice') ? Number(fd.get('baseSedanPrice')) : undefined,
          personalizationNote: String(fd.get('personalizationNote') || ''),
        };

        const original = createBtn.textContent;
        createBtn.disabled = true;
        createBtn.textContent = 'Generating Preview & Drafts...';

        try {
          const res = await fetch('/api/prospects', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json();

          if (!res.ok || !data.ok) {
            errBox.textContent = data.error || 'Could not create prospect.';
            errBox.classList.remove('hidden');
            return;
          }

          const candidateId = form.dataset.candidateId;
          if (candidateId) {
            await fetch('/api/candidates', {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: candidateId, status: 'promoted' }),
            }).catch(() => null);
            delete form.dataset.candidateId;
          }

          okBox.textContent = `Preview created! Reloading queue with ${data.previewUrl}...`;
          okBox.classList.remove('hidden');
          window.location.reload();
        } catch {
          errBox.textContent = 'Network error creating prospect.';
          errBox.classList.remove('hidden');
        } finally {
          createBtn.disabled = false;
          createBtn.textContent = original;
        }
      });

      const copyScoutBtn = document.getElementById('copy-scout-cmd-btn');
      const scoutSnippet = document.getElementById('scout-cli-snippet');
      copyScoutBtn?.addEventListener('click', async () => {
        const text = scoutSnippet?.textContent?.trim();
        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
          showToast('Scout CLI command copied');
        } catch {
          showToast('Copy failed - copy manually from box', 'warn');
        }
      });

      function updateCandidateQueueCount() {
        const remaining = document.querySelectorAll('.candidate-card').length;
        const badge = document.getElementById('scouted-count-badge');
        const emptyState = document.getElementById('scouted-empty-state');
        if (badge) {
          badge.textContent = `${remaining} ready`;
        }
        if (emptyState) {
          if (remaining === 0) {
            emptyState.classList.remove('hidden');
          } else {
            emptyState.classList.add('hidden');
          }
        }
      }

      document.querySelectorAll('.load-candidate-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const raw = btn.getAttribute('data-candidate');
          if (!raw || !form) return;
          try {
            const candidate = JSON.parse(raw);
            const setValue = (id, val) => {
              const el = document.getElementById(id);
              if (el) el.value = val ?? '';
            };
            setValue('businessName', candidate.businessName);
            setValue('city', candidate.city);
            setValue('country', candidate.country || 'US');
            setValue('serviceArea', candidate.serviceArea);
            setValue('phoneDisplay', candidate.phoneDisplay || '');
            setValue('instagramHandle', candidate.instagramHandle);
            setValue('ratingScore', candidate.ratingScore || '4.9');
            setValue('reviewCount', String(candidate.reviewCount || 45));
            setValue('personalizationNote', candidate.personalizationNote);
            setValue('slug', '');
            form.dataset.candidateId = candidate.id;

            form.scrollIntoView({ behavior: 'smooth', block: 'start' });
            showToast('Loaded into form! Review and click Create Preview.');
          } catch {
            showToast('Could not parse candidate data.', 'error');
          }
        });
      });

      document.querySelectorAll('.dismiss-candidate-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const candidateId = btn.getAttribute('data-candidate-id');
          if (!candidateId) return;

          btn.setAttribute('disabled', 'true');
          const orig = btn.textContent;
          btn.textContent = 'Dismissing...';

          try {
            const res = await fetch('/api/candidates', {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: candidateId, status: 'dismissed' }),
            });
            const data = await res.json().catch(() => null);
            if (res.ok && data?.ok) {
              const card = document.querySelector(`[data-candidate-card="${candidateId}"]`);
              card?.remove();
              updateCandidateQueueCount();
              showToast('Candidate dismissed');
            } else {
              showToast(data?.error || 'Could not dismiss candidate.', 'error');
              btn.removeAttribute('disabled');
              btn.textContent = orig;
            }
          } catch {
            showToast('Network error dismissing candidate.', 'error');
            btn.removeAttribute('disabled');
            btn.textContent = orig;
          }
        });
      });

      document.querySelectorAll('.draft-action-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const draftId = btn.getAttribute('data-draft-save');
          const prospectId = btn.getAttribute('data-prospect-id');
          const status = btn.getAttribute('data-status');
          if (!draftId || !prospectId || !status) return;

          const textarea = document.querySelector(
            `textarea[data-draft-textarea="${draftId}"]`
          );
          const box = document.querySelector(`[data-draft-box="${draftId}"]`);
          const pill = box?.querySelector('.draft-status-pill');

          const originalText = btn.textContent;
          btn.textContent = 'Saving...';
          btn.setAttribute('disabled', 'true');

          try {
            const res = await fetch('/api/outreach', {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                id: draftId,
                prospectId,
                messageBody: textarea ? textarea.value : undefined,
                approvalStatus: status,
              }),
            });
            const data = await res.json();
            if (res.ok && data.ok && pill) {
              const labelMap = {
                draft: 'Needs Review',
                approved: 'Approved Ready',
                sent_manually: 'Sent Manually',
                replied: 'Owner Replied',
              };
              const classMap = {
                draft: 'bg-slate-800 text-slate-200 border-slate-600',
                approved: 'bg-sky-400/15 text-[#7DD3FC] border-sky-400/40',
                sent_manually: 'bg-emerald-500/15 text-emerald-300 border-emerald-400/40',
                replied: 'bg-amber-400/15 text-amber-200 border-amber-400/40',
              };
              pill.textContent = labelMap[status] || status;
              pill.className = `draft-status-pill rounded-full border px-2.5 py-0.5 text-[11px] font-bold ${
                classMap[status] || classMap.draft
              }`;
              showToast(`Saved: ${labelMap[status] || status}`);
            }
          } finally {
            btn.removeAttribute('disabled');
            btn.textContent = originalText;
          }
        });
      });

      document.querySelectorAll('.copy-draft-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const draftId = btn.getAttribute('data-copy-draft');
          const slug = btn.getAttribute('data-slug');
          if (!draftId || !slug) return;
          const textarea = document.querySelector(
            `textarea[data-draft-textarea="${draftId}"]`
          );
          if (!textarea) return;

          const configuredOrigin = (domainInput?.value || window.location.origin).replace(/\/+$/, '');
          const fullUrl = `${configuredOrigin}/p/${slug}`;
          const escapedSlug = slug.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
          const relativePathRegex = new RegExp(
            `(^|[\\s(>])\\/p\\/${escapedSlug}(?=[\\s)<.,!?]|$)`,
            'g'
          );
          const copyText = textarea.value.replace(relativePathRegex, `$1${fullUrl}`);
          const isLocalUrl =
            configuredOrigin.includes('localhost') || configuredOrigin.includes('127.0.0.1');

          try {
            await navigator.clipboard.writeText(copyText);
            if (isLocalUrl) {
              showToast(
                'Copied (Note: set your live domain above before sending to a real business!)',
                'warn'
              );
            } else {
              showToast('Copied outreach draft with live URL');
            }
            const prev = btn.textContent;
            btn.textContent = 'Copied!';
            setTimeout(() => {
              btn.textContent = prev;
            }, 1600);
          } catch {
            textarea.select();
          }
        });
      });

      document.querySelectorAll('.copy-portal-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const token = btn.getAttribute('data-copy-portal');
          if (!token) return;
          const configuredOrigin = (domainInput?.value || window.location.origin).replace(/\/+$/, '');
          const portalUrl = `${configuredOrigin}/owner/${token}`;
          try {
            await navigator.clipboard.writeText(portalUrl);
            showToast('Copied private Owner Inbox link');
          } catch {
            showToast(`Owner Inbox URL: ${portalUrl}`, 'warn');
          }
        });
      });

      document.querySelectorAll('.rotate-portal-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const prospectId = btn.getAttribute('data-rotate-portal');
          if (!prospectId) return;
          btn.setAttribute('disabled', 'true');
          try {
            const res = await fetch('/api/prospects', {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ prospectId, rotatePortalToken: true }),
            });
            const data = await res.json().catch(() => null);
            if (res.ok && data?.ok) {
              window.location.reload();
            } else {
              showToast(data?.error || 'Could not rotate owner portal link.', 'error');
            }
          } finally {
            btn.removeAttribute('disabled');
          }
        });
      });

      document.querySelectorAll('.toggle-mode-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const prospectId = btn.getAttribute('data-toggle-mode');
          const currentMode = btn.getAttribute('data-current-mode');
          if (!prospectId) return;

          const nextMode = currentMode === 'live' ? 'preview' : 'live';
          btn.setAttribute('disabled', 'true');
          try {
            const res = await fetch('/api/prospects', {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                prospectId,
                mode: nextMode,
              }),
            });
            const data = await res.json().catch(() => null);
            if (res.ok && data?.ok) {
              window.location.reload();
            } else {
              showToast(data?.error || 'Could not update client mode.', 'error');
              const card = btn.closest('[data-prospect-card]');
              const detailsDrawer = card?.querySelector('details');
              if (detailsDrawer) {
                detailsDrawer.setAttribute('open', 'true');
                const emailInput = detailsDrawer.querySelector('input[name="ownerEmail"]');
                if (emailInput) emailInput.focus();
              }
            }
          } catch {
            showToast('Network error updating client mode.', 'error');
          } finally {
            btn.removeAttribute('disabled');
          }
        });
      });

      // Inbound Inquiries Inbox handlers
      document.querySelectorAll('.load-inquiry-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const raw = btn.getAttribute('data-inquiry-load');
          if (!raw || !form) return;
          try {
            const inq = JSON.parse(raw);
            const setVal = (id, val) => {
              const el = document.getElementById(id);
              if (el) el.value = val ?? '';
            };
            setVal('businessName', inq.businessName);
            setVal('city', inq.city);
            setVal('country', inq.country || 'US');
            setVal('serviceArea', inq.city ? `${inq.city} & surrounding areas` : '');
            const contact = String(inq.contactInfo || '').trim();
            if (contact.startsWith('@') || contact.includes('instagram.com')) {
              setVal('instagramHandle', contact);
            } else if (/^[\d\s()+-]{7,}$/.test(contact)) {
              setVal('phoneDisplay', contact);
              setVal('instagramHandle', `@${inq.businessName.toLowerCase().replace(/[^a-z0-9]+/g, '')}`);
            } else {
              setVal('instagramHandle', `@${inq.businessName.toLowerCase().replace(/[^a-z0-9]+/g, '')}`);
            }
            setVal(
              'personalizationNote',
              inq.notes || `Requested a custom mobile quote preview directly via QuotesDock (${contact})`
            );
            form.scrollIntoView({ behavior: 'smooth', block: 'start' });
            showToast('Inquiry loaded into Studio form');
          } catch {
            showToast('Could not load inquiry into form.', 'error');
          }
        });
      });

      document.querySelectorAll('.inquiry-status-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-inquiry-id');
          const status = btn.getAttribute('data-inquiry-status');
          if (!id || !status) return;
          btn.setAttribute('disabled', 'true');
          try {
            const res = await fetch('/api/inquiries', {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id, status }),
            });
            const data = await res.json().catch(() => null);
            if (!res.ok || !data?.ok) {
              showToast(data?.error || 'Could not update inquiry.', 'error');
              return;
            }
            const card = document.querySelector(`[data-inquiry-card="${id}"]`);
            if (status === 'archived') {
              card?.remove();
              const remaining = document.querySelectorAll('.inquiry-card').length;
              const badge = document.getElementById('inquiries-count-badge');
              if (badge) badge.textContent = `${remaining} active`;
              showToast('Inquiry archived');
            } else {
              const pill = card?.querySelector('.inquiry-status-pill');
              if (pill) pill.textContent = status;
              showToast(`Inquiry marked ${status}`);
            }
          } catch {
            showToast('Network error updating inquiry.', 'error');
          } finally {
            btn.removeAttribute('disabled');
          }
        });
      });

      // Cloudflare R2 Direct Photo Upload handler
      document.querySelectorAll('.r2-upload-input').forEach((input) => {
        input.addEventListener('change', async () => {
          const file = input.files?.[0];
          const prospectId = input.getAttribute('data-upload-prospect');
          if (!file || !prospectId) return;

          const slotBox = input.closest('[data-gallery-slot]');
          const labelSpan = input.closest('label')?.querySelector('span');
          const urlInput = slotBox?.querySelector('.slot-url-input');
          const thumbWrap = slotBox?.querySelector('.slot-thumb-wrap');
          const thumbImg = slotBox?.querySelector('.slot-thumb');

          const origText = labelSpan?.textContent || 'Upload R2 Photo';
          if (labelSpan) labelSpan.textContent = 'Uploading...';
          input.disabled = true;

          try {
            const fd = new FormData();
            fd.append('file', file);
            fd.append('prospectId', prospectId);

            const res = await fetch('/api/media/upload', {
              method: 'POST',
              body: fd,
            });
            const data = await res.json().catch(() => null);
            if (!res.ok || !data?.ok || !data?.url) {
              showToast(data?.error || 'Photo upload failed.', 'error');
              return;
            }

            if (urlInput) urlInput.value = data.url;
            if (thumbImg) thumbImg.setAttribute('src', data.url);
            if (thumbWrap) thumbWrap.classList.remove('hidden');
            showToast('Uploaded to R2! Click Save Client Changes to publish.');
          } catch {
            showToast('Network error uploading photo.', 'error');
          } finally {
            if (labelSpan) labelSpan.textContent = origText;
            input.disabled = false;
            input.value = '';
          }
        });
      });

      async function submitEditForm(editForm, nextMode) {
        const prospectId = editForm.getAttribute('data-prospect-id');
        if (!prospectId) return;

        const fd = new FormData(editForm);
        const galleryItems = [];
        for (let i = 0; i < 6; i += 1) {
          const title = String(fd.get(`jobTitle_${i}`) || '').trim();
          const vehicleLabel = String(fd.get(`jobVehicle_${i}`) || '').trim();
          const servicePerformed = String(fd.get(`jobService_${i}`) || '').trim();
          const beforeNote = String(fd.get(`jobBefore_${i}`) || '').trim();
          const afterNote = String(fd.get(`jobAfter_${i}`) || '').trim();
          const imageUrl = String(fd.get(`photoUrl_${i}`) || '').trim();
          if (title && vehicleLabel && servicePerformed) {
            galleryItems.push({
              id: `job-${i + 1}`,
              title,
              vehicleLabel,
              servicePerformed,
              beforeNote,
              afterNote,
              imageUrl,
            });
          }
        }

        const trustPoints = [];
        for (let t = 0; t < 4; t += 1) {
          const pt = String(fd.get(`trustPoint_${t}`) || '').trim();
          if (pt.length >= 2) trustPoints.push(pt);
        }

        const payload = {
          prospectId,
          ownerEmail: String(fd.get('ownerEmail') || '').trim(),
          webhookUrl: String(fd.get('webhookUrl') || '').trim(),
          phoneDisplay: String(fd.get('phoneDisplay') || '').trim(),
          serviceArea: String(fd.get('serviceArea') || '').trim(),
          baseSedanPrice: fd.get('baseSedanPrice')
            ? Number(fd.get('baseSedanPrice'))
            : undefined,
          galleryItems,
          trustPoints: trustPoints.length > 0 ? trustPoints : undefined,
        };
        if (nextMode) {
          payload.mode = nextMode;
        }

        const res = await fetch('/api/prospects', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) {
          showToast(data.error || 'Could not update client details.', 'error');
          return;
        }
        window.location.reload();
      }

      document.querySelectorAll('.edit-prospect-form').forEach((editForm) => {
        editForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const btn = editForm.querySelector('.save-details-btn');
          if (btn) btn.setAttribute('disabled', 'true');
          try {
            await submitEditForm(editForm, null);
          } finally {
            if (btn) btn.removeAttribute('disabled');
          }
        });
      });

      document.querySelectorAll('.save-and-live-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const editForm = btn.closest('.edit-prospect-form');
          if (!editForm) return;
          btn.setAttribute('disabled', 'true');
          try {
            await submitEditForm(editForm, 'live');
          } finally {
            btn.removeAttribute('disabled');
          }
        });
      });

      document.querySelectorAll('.delete-prospect-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const prospectId = btn.getAttribute('data-delete-prospect');
          if (!prospectId) return;

          if (btn.getAttribute('data-armed') !== 'true') {
            btn.setAttribute('data-armed', 'true');
            btn.textContent = 'Confirm Delete?';
            setTimeout(() => {
              if (btn.isConnected && btn.getAttribute('data-armed') === 'true') {
                btn.removeAttribute('data-armed');
                btn.textContent = 'Delete Prospect';
              }
            }, 4000);
            return;
          }

          btn.setAttribute('disabled', 'true');
          btn.textContent = 'Deleting...';
          try {
            const res = await fetch('/api/prospects', {
              method: 'DELETE',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ prospectId }),
            });
            const data = await res.json();
            if (res.ok && data.ok) {
              window.location.reload();
            } else {
              showToast(data.error || 'Could not delete prospect.', 'error');
              btn.removeAttribute('disabled');
              btn.removeAttribute('data-armed');
              btn.textContent = 'Delete Prospect';
            }
          } catch {
            showToast('Network error deleting prospect.', 'error');
            btn.removeAttribute('disabled');
            btn.removeAttribute('data-armed');
            btn.textContent = 'Delete Prospect';
          }
        });
      });
    })();
  </script>
</BaseLayout>
