---
import BaseLayout from '../layouts/BaseLayout.astro';
import { listProspectsWithStats } from '../lib/db/repository';
import {
  getConfiguredStudioKey,
  isStudioAuthorized,
  STUDIO_COOKIE_NAME,
} from '../lib/security/auth';

const env = Astro.locals.runtime.env;
const configuredKey = getConfiguredStudioKey(env);
let authError = '';

if (Astro.request.method === 'POST' && configuredKey) {
  const formData = await Astro.request.formData().catch(() => null);
  const submittedKey = String(formData?.get('studioKey') || '').trim();
  if (submittedKey && submittedKey === configuredKey) {
    Astro.cookies.set(STUDIO_COOKIE_NAME, submittedKey, {
      path: '/',
      httpOnly: true,
      sameSite: 'lax',
      secure: Astro.url.protocol === 'https:',
      maxAge: 60 * 60 * 24 * 14,
    });
    return Astro.redirect('/studio');
  }
  authError = 'That studio key did not match ADMIN_STUDIO_KEY.';
}

const authorized = isStudioAuthorized(Astro.request, Astro.cookies, env);
const items = authorized ? await listProspectsWithStats(env.DB) : [];

const totalPreviews = items.length;
const hotTestedCount = items.filter((i) => i.previewTestQuotes > 0).length;
const liveClientsCount = items.filter((i) => i.prospect.mode === 'live').length;
const approvedOrSentCount = items.reduce(
  (acc, i) =>
    acc +
    i.drafts.filter(
      (d) =>
        d.approvalStatus === 'approved' ||
        d.approvalStatus === 'sent_manually' ||
        d.approvalStatus === 'replied'
    ).length,
  0
);

const channelLabels: Record<string, string> = {
  instagram_dm: 'Instagram DM',
  facebook_msg: 'Facebook Msg',
  email: 'Email / Text',
};

const statusBadgeClasses: Record<string, string> = {
  draft: 'bg-slate-100 text-slate-700 border-slate-300',
  approved: 'bg-sky-100 text-[#0369A1] border-sky-300',
  sent_manually: 'bg-emerald-100 text-[#15803D] border-emerald-300',
  replied: 'bg-amber-100 text-amber-900 border-amber-300',
};

const statusLabels: Record<string, string> = {
  draft: 'Needs Review',
  approved: 'Approved Ready',
  sent_manually: 'Sent Manually',
  replied: 'Owner Replied',
};
---

<BaseLayout
  title="Founder Outreach Studio | QuotesDock"
  description="Create mobile detailer previews in 60 seconds and manage your human-approved daily outreach queue."
>
  <header class="border-b border-slate-800 bg-[#0C131F] text-white">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6">
      <div class="flex items-center gap-3">
        <a href="/" class="text-lg font-extrabold tracking-tight text-white">
          QuotesDock
        </a>
        <span class="rounded-md bg-sky-500/20 px-2.5 py-0.5 text-xs font-semibold text-sky-300 ring-1 ring-sky-400/30">
          Founder Studio
        </span>
      </div>

      <div class="flex items-center gap-3 text-xs sm:text-sm">
        <a
          href="/"
          class="rounded-lg border border-slate-700 px-3 py-1.5 font-semibold text-slate-200 transition-colors hover:border-slate-500 hover:text-white"
        >
          View Demo Directory
        </a>
        <span class="hidden text-slate-400 sm:inline">
          Rule: Human approval required before sending (~10/day)
        </span>
      </div>
    </div>
  </header>

  {!authorized ? (
    <main class="mx-auto flex min-h-[75vh] max-w-md items-center px-4 py-12">
      <form
        method="POST"
        class="w-full rounded-2xl border border-[#CBD5E1] bg-white p-6 shadow-sm"
      >
        <h1 class="text-xl font-extrabold text-[#0F172A]">
          Unlock Founder Studio
        </h1>
        <p class="mt-1.5 text-sm text-[#475569]">
          Enter your configured <code class="rounded bg-slate-100 px-1 py-0.5 text-xs">ADMIN_STUDIO_KEY</code> to manage prospects and outreach drafts.
        </p>

        {authError && (
          <div class="mt-4 rounded-xl border border-red-200 bg-red-50 px-3.5 py-2.5 text-xs font-semibold text-red-800">
            {authError}
          </div>
        )}

        <label for="studioKey" class="mt-4 block text-xs font-bold text-[#0F172A]">
          Studio Access Key
        </label>
        <input
          id="studioKey"
          name="studioKey"
          type="password"
          required
          class="mt-1.5 w-full rounded-xl border border-[#CBD5E1] bg-white px-3.5 py-2.5 text-sm text-[#0F172A]"
        />
        <button
          type="submit"
          class="mt-4 w-full rounded-xl bg-[#0369A1] px-4 py-2.5 text-sm font-bold text-white transition-colors hover:bg-[#0284C7]"
        >
          Unlock Studio
        </button>
      </form>
    </main>
  ) : (
    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
      {/* Metrics Strip */}
      <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-2xl border border-[#CBD5E1] bg-white p-4">
          <div class="text-xs font-semibold text-[#475569]">
            Active Preview Pages
          </div>
          <div class="tabular-nums mt-1 text-2xl font-extrabold text-[#0F172A]">
            {totalPreviews}
          </div>
        </div>
        <div class="rounded-2xl border border-[#CBD5E1] bg-white p-4">
          <div class="text-xs font-semibold text-[#475569]">
            Owners Who Tested Quote Form
          </div>
          <div class="tabular-nums mt-1 text-2xl font-extrabold text-[#15803D]">
            {hotTestedCount}
          </div>
        </div>
        <div class="rounded-2xl border border-[#CBD5E1] bg-white p-4">
          <div class="text-xs font-semibold text-[#475569]">
            Approved / Sent Drafts
          </div>
          <div class="tabular-nums mt-1 text-2xl font-extrabold text-[#0369A1]">
            {approvedOrSentCount}
          </div>
        </div>
        <div class="rounded-2xl border border-[#CBD5E1] bg-white p-4">
          <div class="text-xs font-semibold text-[#475569]">
            Live Founding Clients
          </div>
          <div class="tabular-nums mt-1 text-2xl font-extrabold text-[#0F172A]">
            {liveClientsCount}
          </div>
        </div>
      </section>

      <div class="mt-8 grid items-start gap-8 lg:grid-cols-12">
        {/* Left Column: New Prospect Generator */}
        <section class="rounded-2xl border border-[#CBD5E1] bg-white p-5 shadow-xs lg:col-span-4 lg:sticky lg:top-6">
          <h1 class="text-lg font-extrabold text-[#0F172A]">
            1. Add New Detailer Preview
          </h1>
          <p class="mt-1 text-xs leading-relaxed text-[#475569]">
            Enter public details from Instagram, Facebook, or Maps (never scrape reviews or photos). Creates a live <code class="rounded bg-slate-100 px-1">/p/[slug]</code> link + 3 drafts for your review.
          </p>

          <form id="new-prospect-form" class="mt-5 space-y-3.5">
            <div>
              <label for="businessName" class="block text-xs font-bold text-[#0F172A]">
                Business Name *
              </label>
              <input
                id="businessName"
                name="businessName"
                type="text"
                required
                placeholder="Pacific Shine Mobile Detail"
                class="mt-1 w-full rounded-xl border border-[#CBD5E1] px-3 py-2 text-sm text-[#0F172A]"
              />
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label for="city" class="block text-xs font-bold text-[#0F172A]">
                  City *
                </label>
                <input
                  id="city"
                  name="city"
                  type="text"
                  required
                  placeholder="San Diego, CA"
                  class="mt-1 w-full rounded-xl border border-[#CBD5E1] px-3 py-2 text-sm text-[#0F172A]"
                />
              </div>

              <div>
                <label for="country" class="block text-xs font-bold text-[#0F172A]">
                  Region / Currency
                </label>
                <select
                  id="country"
                  name="country"
                  class="mt-1 w-full rounded-xl border border-[#CBD5E1] bg-white px-3 py-2 text-sm text-[#0F172A]"
                >
                  <option value="US">US ($ / Zip Code)</option>
                  <option value="UK">UK (£ / Postcode)</option>
                </select>
              </div>
            </div>

            <div>
              <label for="serviceArea" class="block text-xs font-bold text-[#0F172A]">
                Service Area Suburbs *
              </label>
              <input
                id="serviceArea"
                name="serviceArea"
                type="text"
                required
                placeholder="La Jolla, Pacific Beach, Del Mar"
                class="mt-1 w-full rounded-xl border border-[#CBD5E1] px-3 py-2 text-sm text-[#0F172A]"
              />
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label for="phoneDisplay" class="block text-xs font-bold text-[#0F172A]">
                  Public Phone *
                </label>
                <input
                  id="phoneDisplay"
                  name="phoneDisplay"
                  type="text"
                  required
                  placeholder="(619) 555-0134"
                  class="mt-1 w-full rounded-xl border border-[#CBD5E1] px-3 py-2 text-sm text-[#0F172A]"
                />
              </div>
              <div>
                <label for="instagramHandle" class="block text-xs font-bold text-[#0F172A]">
                  IG / FB Handle *
                </label>
                <input
                  id="instagramHandle"
                  name="instagramHandle"
                  type="text"
                  required
                  placeholder="@pacificshine.sd"
                  class="mt-1 w-full rounded-xl border border-[#CBD5E1] px-3 py-2 text-sm text-[#0F172A]"
                />
              </div>
            </div>

            <div class="grid grid-cols-3 gap-2.5">
              <div>
                <label for="ratingScore" class="block text-xs font-bold text-[#0F172A]">
                  Rating
                </label>
                <input
                  id="ratingScore"
                  name="ratingScore"
                  type="text"
                  value="4.9"
                  class="mt-1 w-full rounded-xl border border-[#CBD5E1] px-2.5 py-2 text-sm text-[#0F172A]"
                />
              </div>
              <div>
                <label for="reviewCount" class="block text-xs font-bold text-[#0F172A]">
                  Reviews
                </label>
                <input
                  id="reviewCount"
                  name="reviewCount"
                  type="number"
                  min="1"
                  value="45"
                  class="mt-1 w-full rounded-xl border border-[#CBD5E1] px-2.5 py-2 text-sm text-[#0F172A]"
                />
              </div>
              <div>
                <label for="baseSedanPrice" class="block text-xs font-bold text-[#0F172A]">
                  Full Detail
                </label>
                <input
                  id="baseSedanPrice"
                  name="baseSedanPrice"
                  type="number"
                  min="45"
                  placeholder="145"
                  class="mt-1 w-full rounded-xl border border-[#CBD5E1] px-2.5 py-2 text-sm text-[#0F172A]"
                />
              </div>
            </div>

            <div>
              <label for="personalizationNote" class="block text-xs font-bold text-[#0F172A]">
                1-Line Personalization Note (Why them?) *
              </label>
              <textarea
                id="personalizationNote"
                name="personalizationNote"
                rows="2"
                required
                placeholder="Saw your black Bronco paint correction reel on IG, noticed no quote link in your bio"
                class="mt-1 w-full rounded-xl border border-[#CBD5E1] px-3 py-2 text-xs text-[#0F172A]"
              />
            </div>

            <div>
              <label for="slug" class="block text-xs font-bold text-[#0F172A]">
                Custom URL Slug (Optional)
              </label>
              <input
                id="slug"
                name="slug"
                type="text"
                placeholder="auto-generated if blank"
                class="mt-1 w-full rounded-xl border border-[#CBD5E1] px-3 py-2 text-xs text-[#0F172A]"
              />
            </div>

            <div
              id="prospect-error"
              role="alert"
              class="hidden rounded-xl border border-red-200 bg-red-50 px-3 py-2 text-xs font-semibold text-red-800"
            />
            <div
              id="prospect-success"
              class="hidden rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2.5 text-xs font-semibold text-[#15803D]"
            />

            <button
              id="create-prospect-btn"
              type="submit"
              class="w-full rounded-xl bg-[#0369A1] px-4 py-3 text-sm font-bold text-white transition-colors hover:bg-[#0284C7] disabled:opacity-60"
            >
              Create Preview & Draft Outreach
            </button>
          </form>
        </section>

        {/* Right Column: Human Approval Outreach Queue */}
        <section class="space-y-6 lg:col-span-8">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <h2 class="text-xl font-extrabold text-[#0F172A]">
                2. Human Approval Outreach Queue
              </h2>
              <p class="mt-0.5 text-xs text-[#475569]">
                Review, tweak, approve, and manually send ~10 messages/day. Copy automatically expands preview links to your full domain URL.
              </p>
            </div>
          </div>

          {items.length === 0 ? (
            <div class="rounded-2xl border border-dashed border-[#CBD5E1] bg-white p-10 text-center">
              <p class="text-sm font-semibold text-[#0F172A]">
                No prospects yet
              </p>
              <p class="mt-1 text-xs text-[#475569]">
                Use the form on the left to generate your first mobile detailing preview.
              </p>
            </div>
          ) : (
            <div class="space-y-6">
              {items.map(({ prospect, drafts, recentQuotes, previewTestQuotes, totalQuotes }) => (
                <article
                  class="rounded-2xl border border-[#CBD5E1] bg-white p-5 shadow-xs"
                  data-prospect-card={prospect.id}
                >
                  {/* Prospect Header */}
                  <div class="flex flex-wrap items-start justify-between gap-4 border-b border-slate-200 pb-4">
                    <div class="min-w-0 flex-1">
                      <div class="flex flex-wrap items-center gap-2">
                        <h3 class="text-lg font-extrabold text-[#0F172A]">
                          {prospect.businessName}
                        </h3>
                        <span class="rounded bg-slate-100 px-2 py-0.5 text-xs font-bold text-slate-700">
                          {prospect.city} ({prospect.country})
                        </span>
                        <span
                          class={`mode-pill rounded-full px-2.5 py-0.5 text-xs font-bold ${
                            prospect.mode === 'live'
                              ? 'bg-emerald-100 text-[#15803D]'
                              : 'bg-sky-100 text-[#0369A1]'
                          }`}
                        >
                          {prospect.mode === 'live' ? 'Live Client Mode' : 'Preview Mode'}
                        </span>
                        {previewTestQuotes > 0 ? (
                          <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-bold text-amber-900 ring-1 ring-amber-300">
                            Owner Tested Quote Form ({previewTestQuotes} test{previewTestQuotes > 1 ? 's' : ''})
                          </span>
                        ) : (
                          <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-500">
                            Awaiting first quote test ({totalQuotes} leads)
                          </span>
                        )}
                      </div>

                      <div class="mt-1.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-[#475569]">
                        <span>Handle: <strong>{prospect.instagramHandle}</strong></span>
                        <span>Phone: <strong>{prospect.phoneDisplay}</strong></span>
                        <span>
                          Preview:{' '}
                          <a
                            href={`/p/${prospect.slug}`}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="font-bold text-[#0369A1] underline underline-offset-2 hover:text-[#0284C7]"
                          >
                            /p/{prospect.slug}
                          </a>
                        </span>
                      </div>
                    </div>

                    <div class="flex flex-wrap items-center gap-2">
                      <a
                        href={`/p/${prospect.slug}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="rounded-xl border border-[#CBD5E1] bg-white px-3 py-2 text-xs font-bold text-[#0F172A] transition-colors hover:bg-slate-50"
                      >
                        Open Preview
                      </a>
                      <button
                        type="button"
                        data-toggle-mode={prospect.id}
                        data-current-mode={prospect.mode}
                        class="toggle-mode-btn rounded-xl bg-[#0C131F] px-3 py-2 text-xs font-bold text-white transition-colors hover:bg-slate-800"
                      >
                        {prospect.mode === 'live' ? 'Switch to Preview' : 'Mark Paid & Go Live'}
                      </button>
                    </div>
                  </div>

                  {/* Recent Quotes / Activity */}
                  {recentQuotes.length > 0 && (
                    <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50/60 p-3.5">
                      <div class="text-xs font-bold text-amber-950">
                        Recent Quote Submissions ({recentQuotes.length} latest)
                      </div>
                      <ul class="mt-2 space-y-1.5 text-xs text-slate-800">
                        {recentQuotes.map((q) => (
                          <li class="flex flex-wrap items-center justify-between gap-2 rounded-lg bg-white/80 px-3 py-1.5">
                            <span>
                              <strong>{q.customerName}</strong> ({q.customerPhone}) · {q.vehicleSize.toUpperCase()} · {q.packageName}
                            </span>
                            <span class="tabular-nums font-bold text-[#0369A1]">
                              {prospect.currencySymbol}{q.estimatedMin} - {prospect.currencySymbol}{q.estimatedMax}
                            </span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {/* Outreach Drafts */}
                  <div class="mt-4 space-y-4">
                    {drafts.map((draft) => (
                      <div
                        class="rounded-xl border border-slate-200 bg-[#F8FAFC] p-4"
                        data-draft-box={draft.id}
                      >
                        <div class="flex flex-wrap items-center justify-between gap-2">
                          <div class="flex items-center gap-2">
                            <span class="text-xs font-extrabold text-[#0F172A]">
                              {channelLabels[draft.channel] || draft.channel}
                            </span>
                            <span class="text-xs text-[#475569]">
                              to {draft.recipientHandle}
                            </span>
                          </div>

                          <span
                            class={`draft-status-pill rounded-full border px-2.5 py-0.5 text-[11px] font-bold ${
                              statusBadgeClasses[draft.approvalStatus] || statusBadgeClasses.draft
                            }`}
                          >
                            {statusLabels[draft.approvalStatus] || draft.approvalStatus}
                          </span>
                        </div>

                        <textarea
                          rows="4"
                          data-draft-textarea={draft.id}
                          class="mt-2.5 w-full rounded-xl border border-[#CBD5E1] bg-white p-3 text-xs leading-relaxed text-[#0F172A]"
                        >{draft.messageBody}</textarea>

                        <div class="mt-2.5 flex flex-wrap items-center justify-between gap-2">
                          <div class="flex flex-wrap items-center gap-2">
                            <button
                              type="button"
                              data-draft-save={draft.id}
                              data-prospect-id={prospect.id}
                              data-status="approved"
                              class="draft-action-btn rounded-lg bg-[#0369A1] px-3 py-1.5 text-xs font-bold text-white transition-colors hover:bg-[#0284C7]"
                            >
                              Save & Approve
                            </button>
                            <button
                              type="button"
                              data-draft-save={draft.id}
                              data-prospect-id={prospect.id}
                              data-status="sent_manually"
                              class="draft-action-btn rounded-lg border border-emerald-300 bg-emerald-50 px-3 py-1.5 text-xs font-bold text-[#15803D] transition-colors hover:bg-emerald-100"
                            >
                              Mark Sent Manually
                            </button>
                            <button
                              type="button"
                              data-draft-save={draft.id}
                              data-prospect-id={prospect.id}
                              data-status="replied"
                              class="draft-action-btn rounded-lg border border-amber-300 bg-amber-50 px-3 py-1.5 text-xs font-bold text-amber-900 transition-colors hover:bg-amber-100"
                            >
                              Owner Replied
                            </button>
                          </div>

                          <button
                            type="button"
                            data-copy-draft={draft.id}
                            data-slug={prospect.slug}
                            class="copy-draft-btn rounded-lg border border-[#CBD5E1] bg-white px-3 py-1.5 text-xs font-bold text-[#0F172A] transition-colors hover:bg-slate-100"
                          >
                            Copy Message
                          </button>
                        </div>
                      </div>
                    ))}
                  </div>
                </article>
              ))}
            </div>
          )}
        </section>
      </div>
    </main>
  )}

  <script is:inline>
    (function () {
      const form = document.getElementById('new-prospect-form');
      const createBtn = document.getElementById('create-prospect-btn');
      const errBox = document.getElementById('prospect-error');
      const okBox = document.getElementById('prospect-success');

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!form || !createBtn || !errBox || !okBox) return;

        errBox.classList.add('hidden');
        okBox.classList.add('hidden');

        const fd = new FormData(form);
        const payload = {
          businessName: String(fd.get('businessName') || ''),
          slug: String(fd.get('slug') || ''),
          city: String(fd.get('city') || ''),
          country: String(fd.get('country') || 'US'),
          serviceArea: String(fd.get('serviceArea') || ''),
          phoneDisplay: String(fd.get('phoneDisplay') || ''),
          instagramHandle: String(fd.get('instagramHandle') || ''),
          ratingScore: String(fd.get('ratingScore') || '4.9'),
          reviewCount: Number(fd.get('reviewCount') || 45),
          baseSedanPrice: fd.get('baseSedanPrice') ? Number(fd.get('baseSedanPrice')) : undefined,
          personalizationNote: String(fd.get('personalizationNote') || ''),
        };

        const original = createBtn.textContent;
        createBtn.disabled = true;
        createBtn.textContent = 'Generating Preview & Drafts...';

        try {
          const res = await fetch('/api/prospects', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json();

          if (!res.ok || !data.ok) {
            errBox.textContent = data.error || 'Could not create prospect.';
            errBox.classList.remove('hidden');
            return;
          }

          okBox.innerHTML = '';
          const msg = document.createElement('span');
          msg.textContent = `Preview created! Reloading queue with ${data.previewUrl}...`;
          okBox.appendChild(msg);
          okBox.classList.remove('hidden');
          window.location.reload();
        } catch {
          errBox.textContent = 'Network error creating prospect.';
          errBox.classList.remove('hidden');
        } finally {
          createBtn.disabled = false;
          createBtn.textContent = original;
        }
      });

      document.querySelectorAll('.draft-action-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const draftId = btn.getAttribute('data-draft-save');
          const prospectId = btn.getAttribute('data-prospect-id');
          const status = btn.getAttribute('data-status');
          if (!draftId || !prospectId || !status) return;

          const textarea = document.querySelector(
            `textarea[data-draft-textarea="${draftId}"]`
          );
          const box = document.querySelector(`[data-draft-box="${draftId}"]`);
          const pill = box?.querySelector('.draft-status-pill');

          const originalText = btn.textContent;
          btn.textContent = 'Saving...';
          btn.setAttribute('disabled', 'true');

          try {
            const res = await fetch('/api/outreach', {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                id: draftId,
                prospectId,
                messageBody: textarea ? textarea.value : undefined,
                approvalStatus: status,
              }),
            });
            const data = await res.json();
            if (res.ok && data.ok && pill) {
              const labelMap = {
                draft: 'Needs Review',
                approved: 'Approved Ready',
                sent_manually: 'Sent Manually',
                replied: 'Owner Replied',
              };
              const classMap = {
                draft: 'bg-slate-100 text-slate-700 border-slate-300',
                approved: 'bg-sky-100 text-[#0369A1] border-sky-300',
                sent_manually: 'bg-emerald-100 text-[#15803D] border-emerald-300',
                replied: 'bg-amber-100 text-amber-900 border-amber-300',
              };
              pill.textContent = labelMap[status] || status;
              pill.className = `draft-status-pill rounded-full border px-2.5 py-0.5 text-[11px] font-bold ${
                classMap[status] || classMap.draft
              }`;
            }
          } finally {
            btn.removeAttribute('disabled');
            btn.textContent = originalText;
          }
        });
      });

      document.querySelectorAll('.copy-draft-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const draftId = btn.getAttribute('data-copy-draft');
          const slug = btn.getAttribute('data-slug');
          if (!draftId || !slug) return;
          const textarea = document.querySelector(
            `textarea[data-draft-textarea="${draftId}"]`
          );
          if (!textarea) return;

          // Expand relative preview path to full shareable URL when copying
          const fullUrl = `${window.location.origin}/p/${slug}`;
          const copyText = textarea.value.replaceAll(`/p/${slug}`, fullUrl);

          try {
            await navigator.clipboard.writeText(copyText);
            const prev = btn.textContent;
            btn.textContent = 'Copied Full Link!';
            setTimeout(() => {
              btn.textContent = prev;
            }, 1600);
          } catch {
            textarea.select();
          }
        });
      });

      document.querySelectorAll('.toggle-mode-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const prospectId = btn.getAttribute('data-toggle-mode');
          const currentMode = btn.getAttribute('data-current-mode');
          if (!prospectId) return;

          const nextMode = currentMode === 'live' ? 'preview' : 'live';
          btn.setAttribute('disabled', 'true');
          try {
            const res = await fetch('/api/prospects', {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                prospectId,
                mode: nextMode,
              }),
            });
            const data = await res.json();
            if (res.ok && data.ok) {
              window.location.reload();
            }
          } finally {
            btn.removeAttribute('disabled');
          }
        });
      });
    })();
  </script>
</BaseLayout>
