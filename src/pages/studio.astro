---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  listInboundInquiries,
  listLeadCandidates,
  listProspectsWithStats,
} from '../lib/db/repository';
import { isSandboxDemoSlug } from '../lib/db/seed-data';
import {
  deriveStudioSessionToken,
  getConfiguredStudioKey,
  isStudioAuthorized,
  STUDIO_COOKIE_NAME,
  verifyStudioPassword,
} from '../lib/security/auth';

const env = Astro.locals.runtime.env;
const configuredKey = getConfiguredStudioKey(env);
let authError = '';

if (Astro.url.searchParams.get('logout') === '1') {
  Astro.cookies.delete(STUDIO_COOKIE_NAME, { path: '/' });
  return Astro.redirect('/studio');
}

if (Astro.request.method === 'POST' && configuredKey) {
  const formData = await Astro.request.formData().catch(() => null);
  const submittedKey = String(formData?.get('studioKey') || '').trim();
  if (verifyStudioPassword(submittedKey, configuredKey)) {
    const sessionToken = await deriveStudioSessionToken(configuredKey);
    Astro.cookies.set(STUDIO_COOKIE_NAME, sessionToken, {
      path: '/',
      httpOnly: true,
      sameSite: 'lax',
      secure: Astro.url.protocol === 'https:',
      maxAge: 60 * 60 * 24 * 14,
    });
    return Astro.redirect('/studio');
  }
  authError = 'That studio key did not match ADMIN_STUDIO_KEY.';
}

const authorized = await isStudioAuthorized(Astro.request, Astro.cookies, env);
const hasResendConfig = Boolean(env.RESEND_API_KEY?.trim() && env.RESEND_FROM_EMAIL?.trim());
const hasFounderWebhook = Boolean(env.FOUNDER_WEBHOOK_URL?.trim());
const items = authorized ? await listProspectsWithStats(env.DB) : [];
const leadCandidates = authorized ? await listLeadCandidates(env.DB) : [];
const inboundInquiries = authorized ? await listInboundInquiries(env.DB) : [];
const activeInquiries = inboundInquiries.filter((inq) => inq.status !== 'archived');

const realItems = items.filter((item) => !isSandboxDemoSlug(item.prospect.slug));
const sandboxItems = items.filter((item) => isSandboxDemoSlug(item.prospect.slug));

const totalPreviews = realItems.length;
const hotTestedCount = realItems.filter((i) => i.previewTestQuotes > 0).length;
const liveClientsCount = realItems.filter((i) => i.prospect.mode === 'live').length;
const approvedOrSentCount = realItems.reduce(
  (acc, i) =>
    acc +
    i.drafts.filter(
      (d) =>
        d.approvalStatus === 'approved' ||
        d.approvalStatus === 'sent_manually' ||
        d.approvalStatus === 'replied'
    ).length,
  0
);

const channelLabels: Record<string, string> = {
  instagram_dm: 'Instagram DM',
  facebook_msg: 'Facebook Msg',
  email: 'Email / Text',
};

const statusBadgeClasses: Record<string, string> = {
  draft: 'bg-slate-800 text-slate-200 border-slate-600',
  approved: 'bg-sky-400/15 text-[#7DD3FC] border-sky-400/40',
  sent_manually: 'bg-emerald-500/15 text-emerald-300 border-emerald-400/40',
  replied: 'bg-amber-400/15 text-amber-200 border-amber-400/40',
};

const statusLabels: Record<string, string> = {
  draft: 'Needs Review',
  approved: 'Approved Ready',
  sent_manually: 'Sent Manually',
  replied: 'Owner Replied',
};

const deliveryStatusBadges: Record<string, { label: string; classes: string }> = {
  sent: {
    label: 'Alert Sent',
    classes: 'bg-emerald-500/15 text-emerald-300 border-emerald-400/40',
  },
  failed: {
    label: 'Alert Failed',
    classes: 'bg-red-500/20 text-red-200 border-red-400/40',
  },
  config_missing: {
    label: 'Saved in Owner Inbox',
    classes: 'bg-sky-400/15 text-[#7DD3FC] border-sky-400/35',
  },
  no_owner_email: {
    label: 'Missing Alert Destination',
    classes: 'bg-red-500/20 text-red-200 border-red-400/40',
  },
  preview_only: {
    label: 'Preview Test',
    classes: 'bg-sky-400/15 text-[#7DD3FC] border-sky-400/35',
  },
  not_applicable: {
    label: 'Logged',
    classes: 'bg-slate-800 text-slate-300 border-slate-600',
  },
};

const gmailAppsScriptSnippet = `function doPost(e) {
  var data = JSON.parse((e && e.postData && e.postData.contents) || '{}');
  // Optional: set Script Property WEBHOOK_SECRET to match Cloudflare secret
  var expected = PropertiesService.getScriptProperties().getProperty('WEBHOOK_SECRET');
  if (expected && data.secret !== expected) {
    return ContentService.createTextOutput(JSON.stringify({ ok: false }))
      .setMimeType(ContentService.MimeType.JSON);
  }
  var recipient = data.to || data.founderEmail || Session.getActiveUser().getEmail();
  if (recipient) {
    MailApp.sendEmail({
      to: recipient,
      subject: data.subject || 'New QuotesDock Lead',
      body: data.text || data.content || ''
    });
  }
  return ContentService.createTextOutput(JSON.stringify({ ok: true }))
    .setMimeType(ContentService.MimeType.JSON);
}`;
---

<BaseLayout
  title="Founder Outreach Studio | QuotesDock"
  description="Create mobile detailer previews in 60 seconds and manage your human-approved daily outreach queue."
  noindex={true}
>
  <header class="sticky top-0 z-40 border-b border-slate-800/90 bg-[#0C1017]/92 backdrop-blur-xl">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-4 py-3.5 sm:px-6">
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2.5 text-lg font-bold tracking-tight text-slate-50">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg border border-sky-400/35 bg-sky-400/10 text-[#38BDF8]">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 2L20 6.5V17.5L12 22L4 17.5V6.5L12 2Z" />
            </svg>
          </span>
          <span class="font-display">QuotesDock</span>
        </a>
        <span class="rounded-full border border-sky-400/30 bg-sky-400/10 px-2.5 py-0.5 text-xs font-semibold text-[#7DD3FC]">
          Founder Studio
        </span>
      </div>

      <div class="flex items-center gap-3 text-xs sm:text-sm">
        <span class="hidden rounded-lg border border-slate-700/80 bg-[#151D2A] px-3 py-1.5 text-xs text-[#CBD5E1] lg:inline">
          Safety Rule: Human approval required (~10/day manual sends)
        </span>
        {authorized && configuredKey && (
          <a
            href="/studio?logout=1"
            class="rounded-xl border border-amber-400/35 bg-amber-400/10 px-3 py-2 text-xs font-semibold text-amber-200 transition-colors hover:bg-amber-400/20"
          >
            Lock Studio
          </a>
        )}
        <a
          href="/"
          class="rounded-xl border border-slate-600/80 bg-[#151D2A] px-3.5 py-2 text-xs font-semibold text-slate-100 transition-colors hover:border-sky-400/50 hover:text-white"
        >
          View Brand Home
        </a>
      </div>
    </div>
  </header>

  {!authorized ? (
    <main class="carbon-mesh mx-auto flex min-h-[78vh] items-center justify-center px-4 py-12">
      {!configuredKey ? (
        <div class="glass-panel anisotropic-border w-full max-w-lg rounded-2xl border-amber-400/40 p-6 sm:p-7">
          <h1 class="text-xl font-bold text-slate-50">
            Studio Locked on Public Domain
          </h1>
          <p class="mt-2 text-sm leading-relaxed text-[#CBD5E1]">
            For security, passwordless access only works on <code class="rounded bg-slate-800 px-1.5 py-0.5 text-xs text-[#7DD3FC]">localhost</code>. Configure <code class="rounded bg-slate-800 px-1.5 py-0.5 text-xs text-[#7DD3FC]">ADMIN_STUDIO_KEY</code> in your Cloudflare Pages / Workers secrets and redeploy to unlock Founder Studio online.
          </p>
        </div>
      ) : (
        <form
          method="POST"
          class="glass-panel anisotropic-border w-full max-w-md rounded-2xl p-6 sm:p-7"
        >
          <h1 class="text-xl font-bold text-slate-50">
            Unlock Founder Studio
          </h1>
          <p class="mt-1.5 text-sm text-[#CBD5E1]">
            Enter your configured <code class="rounded bg-slate-800 px-1.5 py-0.5 text-xs text-[#7DD3FC]">ADMIN_STUDIO_KEY</code> to manage prospects and outreach drafts.
          </p>

          {authError && (
            <div class="mt-4 rounded-xl border border-red-400/40 bg-red-950/60 px-3.5 py-2.5 text-xs font-semibold text-red-200">
              {authError}
            </div>
          )}

          <label for="studioKey" class="mt-5 block text-xs font-bold uppercase tracking-wider text-slate-200">
            Studio Access Key
          </label>
          <input
            id="studioKey"
            name="studioKey"
            type="password"
            required
            class="mt-1.5 w-full rounded-xl border border-slate-600/80 bg-[#0C1017] px-3.5 py-2.5 text-sm text-slate-50"
          />
          <button
            type="submit"
            class="mt-4 w-full rounded-xl bg-[#38BDF8] px-4 py-2.5 text-sm font-bold text-[#06131F] transition-colors hover:bg-[#7DD3FC] cyan-glow-sm"
          >
            Unlock Studio
          </button>
        </form>
      )}
    </main>
  ) : (
    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
      {/* Metrics Strip (Real Prospects Only) */}
      <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="glass-panel anisotropic-border rounded-2xl p-4">
          <div class="text-xs font-semibold text-[#CBD5E1]">
            Real Pitched Prospects
          </div>
          <div class="font-display tabular-nums mt-1 text-3xl font-bold text-slate-50">
            {totalPreviews}
          </div>
          <div class="mt-0.5 text-[11px] text-slate-300">
            + {sandboxItems.length} built-in sandbox demos
          </div>
        </div>
        <div class="glass-panel anisotropic-border rounded-2xl border-t-emerald-400/40 p-4">
          <div class="text-xs font-semibold text-[#CBD5E1]">
            Owners Who Tested Quote Form
          </div>
          <div id="kpi-hot-tested" class="font-display tabular-nums mt-1 text-3xl font-bold text-emerald-300">
            {hotTestedCount}
          </div>
          <div class="mt-0.5 text-[11px] text-slate-300">
            Excludes ?founder=1 self-tests &amp; sandboxes
          </div>
        </div>
        <div class="glass-panel anisotropic-border rounded-2xl border-t-sky-400/40 p-4">
          <div class="text-xs font-semibold text-[#CBD5E1]">
            Approved / Sent Drafts
          </div>
          <div class="font-display tabular-nums mt-1 text-3xl font-bold text-[#38BDF8]">
            {approvedOrSentCount}
          </div>
        </div>
        <div class="glass-panel anisotropic-border rounded-2xl p-4">
          <div class="text-xs font-semibold text-[#CBD5E1]">
            Live Founding Clients
          </div>
          <div class="font-display tabular-nums mt-1 text-3xl font-bold text-slate-50">
            {liveClientsCount}
          </div>
        </div>
      </section>

      <div class="mt-8 grid items-start gap-8 lg:grid-cols-12">
        {/* Left Column: New Prospect Generator */}
        <section class="glass-panel anisotropic-border rounded-2xl p-5 lg:sticky lg:top-20 lg:col-span-4">
          <h1 class="text-lg font-bold text-slate-50">
            1. Add New Detailer Preview
          </h1>
          <p class="mt-1 text-xs leading-relaxed text-[#CBD5E1]">
            Enter public details from Instagram or Facebook (never scrape photos or reviews). Creates a live <code class="rounded bg-slate-800 px-1 text-[#7DD3FC]">/p/[slug]</code> link + 3 outreach drafts.
          </p>

          <form id="new-prospect-form" class="mt-5 space-y-3.5">
            <div>
              <label for="businessName" class="block text-xs font-semibold uppercase tracking-wider text-slate-200">
                Business Name *
              </label>
              <input
                id="businessName"
                name="businessName"
                type="text"
                required
                placeholder="Pacific Shine Mobile Detail"
                class="mt-1 w-full rounded-xl border border-slate-600/80 bg-[#0C1017] px-3 py-2 text-sm text-slate-50 placeholder:text-slate-400"
              />
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label for="city" class="block text-xs font-semibold uppercase tracking-wider text-slate-200">
                  City *
                </label>
                <input
                  id="city"
                  name="city"
                  type="text"
                  required
                  placeholder="San Diego, CA"
                  class="mt-1 w-full rounded-xl border border-slate-600/80 bg-[#0C1017] px-3 py-2 text-sm text-slate-50 placeholder:text-slate-400"
                />
              </div>

              <div>
                <label for="country" class="block text-xs font-semibold uppercase tracking-wider text-slate-200">
                  Region / Currency
                </label>
                <select
                  id="country"
                  name="country"
                  class="mt-1 w-full rounded-xl border border-slate-600/80 bg-[#0C1017] px-3 py-2 text-sm text-slate-50"
                >
                  <option value="US">US ($ / Zip Code)</option>
                  <option value="UK">UK (£ / Postcode)</option>
                </select>
              </div>
            </div>

            <div>
              <label for="serviceArea" class="block text-xs font-semibold uppercase tracking-wider text-slate-200">
                Service Area Suburbs *
              </label>
              <input
                id="serviceArea"
                name="serviceArea"
                type="text"
                required
                placeholder="La Jolla, Pacific Beach, Del Mar"
                class="mt-1 w-full rounded-xl border border-slate-600/80 bg-[#0C1017] px-3 py-2 text-sm text-slate-50 placeholder:text-slate-400"
              />
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label for="phoneDisplay" class="block text-xs font-semibold uppercase tracking-wider text-slate-200">
                  Public Phone (Optional)
                </label>
                <input
                  id="phoneDisplay"
                  name="phoneDisplay"
                  type="text"
                  placeholder="Leave blank if IG-only"
                  class="mt-1 w-full rounded-xl border border-slate-600/80 bg-[#0C1017] px-3 py-2 text-sm text-slate-50 placeholder:text-slate-400"
                />
              </div>
              <div>
                <label for="instagramHandle" class="block text-xs font-semibold uppercase tracking-wider text-slate-200">
                  IG / FB Handle or URL *
                </label>
                <input
                  id="instagramHandle"
                  name="instagramHandle"
                  type="text"
                  required
                  placeholder="@pacificshine.sd"
                  class="mt-1 w-full rounded-xl border border-slate-600/80 bg-[#0C1017] px-3 py-2 text-sm text-slate-50 placeholder:text-slate-400"
                />
              </div>
            </div>

            <div class="grid grid-cols-3 gap-2.5">
              <div>
                <label for="ratingScore" class="block text-xs font-semibold uppercase tracking-wider text-slate-200">
                  Rating
                </label>
                <input
                  id="ratingScore"
                  name="ratingScore"
                  type="text"
                  value="4.9"
                  class="mt-1 w-full rounded-xl border border-slate-600/80 bg-[#0C1017] px-2.5 py-2 text-sm text-slate-50"
                />
              </div>
              <div>
                <label for="reviewCount" class="block text-xs font-semibold uppercase tracking-wider text-slate-200">
                  Reviews
                </label>
                <input
                  id="reviewCount"
                  name="reviewCount"
                  type="number"
                  min="1"
                  value="45"
                  class="mt-1 w-full rounded-xl border border-slate-600/80 bg-[#0C1017] px-2.5 py-2 text-sm text-slate-50"
                />
              </div>
              <div>
                <label for="baseSedanPrice" class="block text-xs font-semibold uppercase tracking-wider text-slate-200">
                  Full Detail
                </label>
                <input
                  id="baseSedanPrice"
                  name="baseSedanPrice"
                  type="number"
                  min="45"
                  placeholder="145"
                  class="mt-1 w-full rounded-xl border border-slate-600/80 bg-[#0C1017] px-2.5 py-2 text-sm text-slate-50 placeholder:text-slate-400"
                />
              </div>
            </div>

            <div>
              <label for="personalizationNote" class="block text-xs font-semibold uppercase tracking-wider text-slate-200">
                1-Line Personalization Note *
              </label>
              <textarea
                id="personalizationNote"
                name="personalizationNote"
                rows="2"
                required
                placeholder="Saw your black Bronco paint correction reel on IG, noticed no quote link in your bio"
                class="mt-1 w-full rounded-xl border border-slate-600/80 bg-[#0C1017] px-3 py-2 text-xs text-slate-50 placeholder:text-slate-400"
              />
            </div>

            <div>
              <label for="slug" class="block text-xs font-semibold uppercase tracking-wider text-slate-200">
                Custom URL Slug (Optional)
              </label>
              <input
                id="slug"
                name="slug"
                type="text"
                placeholder="auto-generated if blank"
                class="mt-1 w-full rounded-xl border border-slate-600/80 bg-[#0C1017] px-3 py-2 text-xs text-slate-50 placeholder:text-slate-400"
              />
            </div>

            <div
              id="prospect-error"
              role="alert"
              class="hidden rounded-xl border border-red-400/40 bg-red-950/60 px-3 py-2 text-xs font-semibold text-red-200"
            />
            <div
              id="prospect-success"
              class="hidden rounded-xl border border-emerald-400/40 bg-emerald-950/60 px-3 py-2.5 text-xs font-semibold text-emerald-200"
            />

            <button
              id="create-prospect-btn"
              type="submit"
              class="w-full rounded-xl bg-[#38BDF8] px-4 py-3 text-sm font-bold text-[#06131F] transition-colors hover:bg-[#7DD3FC] cyan-glow-sm disabled:opacity-60"
            >
              Create Preview &amp; Draft Outreach
            </button>
          </form>
        </section>

        {/* Right Column: Inbound Inquiries + Scouted Leads Queue + Human Approval Outreach Queue */}
        <section class="space-y-6 lg:col-span-8">
          {/* Inbound Claims & Free Preview Requests Inbox */}
          <details
            id="inbound-inquiries-panel"
            open={activeInquiries.length > 0}
            class="glass-panel anisotropic-border rounded-2xl border border-emerald-400/30 p-5"
          >
            <summary class="flex cursor-pointer select-none flex-wrap items-center justify-between gap-2">
              <div class="flex flex-wrap items-center gap-2.5">
                <span class="text-lg font-bold text-slate-50">
                  Inbound Claims &amp; Preview Requests
                </span>
                <span
                  id="inquiries-count-badge"
                  class={`rounded-full border px-2.5 py-0.5 text-xs font-bold ${
                    activeInquiries.length > 0
                      ? 'border-emerald-400/40 bg-emerald-500/20 text-emerald-300'
                      : 'border-slate-700 bg-slate-800 text-slate-300'
                  }`}
                >
                  {activeInquiries.length} active
                </span>
              </div>
              <span class="text-xs font-semibold text-[#CBD5E1]">
                Click to collapse / expand
              </span>
            </summary>

            <div class="mt-4 space-y-3">
              {activeInquiries.length === 0 ? (
                <div class="rounded-xl border border-dashed border-slate-700 p-4 text-center text-xs text-[#CBD5E1]">
                  No active claims or homepage preview requests yet. Inbound detailer requests from / and /p/[slug] appear here automatically.
                </div>
              ) : (
                activeInquiries.map((inq) => {
                  const typeBadge =
                    inq.inquiryType === 'claim_page'
                      ? { label: 'Page Claim', cls: 'bg-emerald-500/20 text-emerald-300 border-emerald-400/40' }
                      : inq.inquiryType === 'removal_request'
                        ? { label: 'Removal / Edit Request', cls: 'bg-red-500/20 text-red-200 border-red-400/40' }
                        : { label: 'Free Preview Request', cls: 'bg-sky-400/15 text-[#7DD3FC] border-sky-400/40' };
                  return (
                    <article
                      class="inquiry-card rounded-xl border border-slate-700/80 bg-[#0C1017]/90 p-4"
                      data-inquiry-card={inq.id}
                    >
                      <div class="flex flex-wrap items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                          <div class="flex flex-wrap items-center gap-2">
                            <span class={`rounded-full border px-2.5 py-0.5 text-[11px] font-bold ${typeBadge.cls}`}>
                              {typeBadge.label}
                            </span>
                            <h3 class="text-sm font-bold text-slate-50">
                              {inq.businessName}
                            </h3>
                            {inq.city && (
                              <span class="rounded bg-slate-800 px-2 py-0.5 text-[11px] font-semibold text-slate-200">
                                {inq.city} ({inq.country})
                              </span>
                            )}
                            <span class="inquiry-status-pill rounded-full border border-slate-600 bg-slate-800 px-2 py-0.5 text-[10px] font-bold uppercase text-slate-200">
                              {inq.status}
                            </span>
                          </div>
                          <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-[#CBD5E1]">
                            <span>Owner: <strong class="text-slate-100">{inq.ownerName}</strong></span>
                            <span>Contact: <strong class="text-slate-100">{inq.contactInfo}</strong></span>
                            <span>Plan: <strong class="text-[#7DD3FC] uppercase">{inq.planTier}</strong></span>
                            {inq.slug && (
                              <a
                                href={`/p/${inq.slug}`}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="font-bold text-[#7DD3FC] underline underline-offset-2 hover:text-white"
                              >
                                /p/{inq.slug}
                              </a>
                            )}
                          </div>
                          {inq.notes && (
                            <p class="mt-2 rounded-lg border border-slate-800 bg-[#151D2A]/80 px-3 py-1.5 text-xs text-slate-200">
                              {inq.notes}
                            </p>
                          )}
                        </div>

                        <div class="flex shrink-0 flex-wrap items-center gap-1.5">
                          {inq.inquiryType === 'free_preview_request' && (
                            <button
                              type="button"
                              data-inquiry-load={JSON.stringify({
                                businessName: inq.businessName,
                                city: inq.city,
                                country: inq.country,
                                contactInfo: inq.contactInfo,
                                notes: inq.notes || '',
                              })}
                              class="load-inquiry-btn rounded-lg bg-[#38BDF8] px-2.5 py-1.5 text-[11px] font-bold text-[#06131F] hover:bg-[#7DD3FC]"
                            >
                              Load into Form
                            </button>
                          )}
                          <button
                            type="button"
                            data-inquiry-id={inq.id}
                            data-inquiry-status="contacted"
                            class="inquiry-status-btn rounded-lg border border-sky-400/40 bg-sky-400/10 px-2.5 py-1.5 text-[11px] font-bold text-[#7DD3FC] hover:bg-sky-400/20"
                          >
                            Contacted
                          </button>
                          <button
                            type="button"
                            data-inquiry-id={inq.id}
                            data-inquiry-status="paid"
                            class="inquiry-status-btn rounded-lg border border-emerald-400/40 bg-emerald-500/15 px-2.5 py-1.5 text-[11px] font-bold text-emerald-300 hover:bg-emerald-500/25"
                          >
                            Paid
                          </button>
