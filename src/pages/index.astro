---
import BaseLayout from '../layouts/BaseLayout.astro';
import { listProspectsWithStats } from '../lib/db/repository';

const d1 = Astro.locals.runtime.env.DB;
const items = await listProspectsWithStats(d1);
---

<BaseLayout
  title="QuotesDock | Preview-First Quote & Job-Proof Pages for Mobile Car Detailers"
  description="Live mobile-first 60-second quote calculators and job-proof landing pages for US and UK mobile car detailers."
>
  <nav class="sticky top-0 z-40 border-b border-slate-800/80 bg-[#0A0C10]/85 backdrop-blur-xl">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-4 py-3.5 sm:px-6">
      <div class="flex items-center gap-3">
        <div class="flex h-9 w-9 items-center justify-center rounded-lg border border-cyan-400/40 bg-cyan-400/10 text-[#00F2FE] cyan-glow-sm">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 2L20 6.5V17.5L12 22L4 17.5V6.5L12 2Z" />
            <path d="M12 7L16 9.5V14.5L12 17L8 14.5V9.5L12 7Z" />
          </svg>
        </div>
        <span class="font-display text-lg font-bold tracking-tight text-white">
          QuotesDock
        </span>
        <span class="hidden rounded-full border border-cyan-400/30 bg-cyan-400/10 px-2.5 py-0.5 text-[11px] font-semibold text-[#00F2FE] sm:inline-flex">
          Mobile Detailing Edition
        </span>
      </div>

      <div class="flex items-center gap-4">
        <a
          href="#workflow"
          class="hidden text-xs font-semibold text-[#94A3B8] transition-colors hover:text-white sm:inline"
        >
          How It Works
        </a>
        <a
          href="#demos"
          class="text-xs font-semibold text-[#94A3B8] transition-colors hover:text-white sm:text-sm"
        >
          Live Demos
        </a>
        <a
          href="/studio"
          class="rounded-xl bg-[#00F2FE] px-4 py-2 text-xs font-bold text-[#06121A] transition-colors hover:bg-[#4FACFE] cyan-glow-sm sm:text-sm"
        >
          Open Founder Studio
        </a>
      </div>
    </div>
  </nav>

  <header class="carbon-mesh relative overflow-hidden border-b border-slate-800/80">
    <div class="tunnel-ambient pointer-events-none absolute -top-32 left-1/2 h-80 w-[90vw] max-w-[760px] -translate-x-1/2 rounded-full bg-[#00F2FE]/10 blur-[130px]" />

    <div class="mx-auto max-w-7xl px-4 pb-16 pt-10 sm:px-6 sm:pb-20 sm:pt-16">
      <div class="grid items-center gap-10 lg:grid-cols-12">
        <div class="reveal-up is-visible min-w-0 lg:col-span-7">
          <div class="inline-flex max-w-full flex-wrap items-center gap-2 rounded-full border border-cyan-400/30 bg-cyan-400/10 px-3.5 py-1.5 text-xs font-semibold text-[#00F2FE]">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#00F2FE] opacity-75" />
              <span class="relative inline-flex h-2 w-2 rounded-full bg-[#00F2FE]" />
            </span>
            <span>Built on Cloudflare Workers + D1 ($0/mo Fixed Cost)</span>
          </div>

          <h1 class="mt-5 max-w-[19ch] text-3xl font-bold leading-[1.08] tracking-tight text-white sm:text-5xl lg:text-[54px]">
            Turn Local Detailers Into 60-Second Quote Bookings
          </h1>

          <p class="mt-4 max-w-xl text-base leading-relaxed text-[#94A3B8] sm:text-lg">
            Instead of pitching vague websites, send US and UK mobile car detailers a live, interactive quote configurator pre-built for their business.
          </p>

          <div class="mt-7 flex flex-wrap gap-3.5">
            <a
              href="/studio"
              class="group inline-flex items-center gap-2 rounded-xl bg-[#00F2FE] px-6 py-4 text-sm font-bold text-[#06121A] transition-colors hover:bg-[#4FACFE] cyan-glow sm:text-base"
            >
              <span>Generate a New Preview</span>
              <svg
                class="h-4 w-4 transition-transform group-hover:translate-x-1"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                  clip-rule="evenodd"
                />
              </svg>
            </a>
            <a
              href="/p/apex-gloss-austin"
              class="rounded-xl border border-slate-700 bg-slate-900/75 px-5 py-4 text-sm font-semibold text-slate-100 transition-colors hover:border-cyan-400/50 hover:text-white sm:text-base"
            >
              Try Sample Quote Page
            </a>
          </div>
        </div>

        <div class="reveal-up is-visible stagger-1 lg:col-span-5">
          <div class="glass-panel anisotropic-border overflow-hidden rounded-2xl p-2">
            <div class="relative aspect-[16/10] overflow-hidden rounded-xl bg-[#070A0F]">
              <img
                src="/images/hero-wetbay.jpg"
                alt="Mobile detailing wet-bay lighting showcase"
                class="h-full w-full object-cover object-[70%_62%] scale-105"
              />
              <div
                class="pointer-events-none absolute inset-0"
                style="background: linear-gradient(125deg, rgba(10,12,16,0.92) 0%, rgba(10,12,16,0.4) 50%, rgba(10,12,16,0.12) 100%), linear-gradient(to top, rgba(10,12,16,0.94) 0%, transparent 55%);"
              />
              <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between rounded-xl border border-slate-700/80 bg-[#0A0C10]/85 px-4 py-2.5 backdrop-blur-md">
                <div>
                  <div class="text-[11px] font-bold uppercase tracking-wider text-[#00F2FE]">
                    Founding Client Scope
                  </div>
                  <div class="font-display tabular-nums text-xl font-bold text-white">
                    $50 setup + $15/mo
                  </div>
                </div>
                <span class="rounded-full bg-emerald-500/15 px-2.5 py-1 text-[11px] font-semibold text-emerald-300 ring-1 ring-emerald-400/30">
                  First 5 Clients
                </span>
              </div>
            </div>

            <div class="grid gap-2.5 p-4 text-xs text-slate-200 sm:grid-cols-2">
              <div class="flex items-center gap-2 rounded-lg bg-[#0A0C10]/70 px-3 py-2">
                <span class="font-bold text-[#00F2FE]">✓</span>
                <span>1 dynamic quote page (/p/slug)</span>
              </div>
              <div class="flex items-center gap-2 rounded-lg bg-[#0A0C10]/70 px-3 py-2">
                <span class="font-bold text-[#00F2FE]">✓</span>
                <span>Up to 6 owner job photos</span>
              </div>
              <div class="flex items-center gap-2 rounded-lg bg-[#0A0C10]/70 px-3 py-2">
                <span class="font-bold text-[#00F2FE]">✓</span>
                <span>Live vehicle size configurator</span>
              </div>
              <div class="flex items-center gap-2 rounded-lg bg-[#0A0C10]/70 px-3 py-2">
                <span class="font-bold text-[#00F2FE]">✓</span>
                <span>Human-approved outreach only</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
    {/* 3-Step Workflow Strip */}
    <section id="workflow" class="reveal-up mb-16">
      <div class="max-w-2xl">
        <span class="inline-flex rounded-full border border-cyan-400/30 bg-cyan-400/10 px-3 py-1 text-xs font-semibold text-[#00F2FE]">
          Preview-First Sales System
        </span>
        <h2 class="mt-3 text-2xl font-bold tracking-tight text-white sm:text-3xl">
          How You Close Founding Clients Without Hard Selling
        </h2>
      </div>

      <div class="mt-6 grid gap-5 md:grid-cols-3">
        <div class="glass-panel anisotropic-border rounded-2xl p-6">
          <div class="font-mono text-xs font-bold text-[#00F2FE]">STEP 01</div>
          <h3 class="mt-2 text-lg font-bold text-white">Generate Link in 60s</h3>
          <p class="mt-2 text-sm leading-relaxed text-[#94A3B8]">
            Enter a detailer's public name, city, and Instagram handle in Founder Studio. Zero scraping, zero coding.
          </p>
        </div>

        <div class="glass-panel anisotropic-border rounded-2xl p-6">
          <div class="font-mono text-xs font-bold text-[#00F2FE]">STEP 02</div>
          <h3 class="mt-2 text-lg font-bold text-white">Owner Tests Their Form</h3>
          <p class="mt-2 text-sm leading-relaxed text-[#94A3B8]">
            Send ~10 human-approved messages per day. When they test the quote form, they see the live SMS alert simulator and your Studio flags them warm.
          </p>
        </div>

        <div class="glass-panel anisotropic-border rounded-2xl p-6">
          <div class="font-mono text-xs font-bold text-[#00F2FE]">STEP 03</div>
          <h3 class="mt-2 text-lg font-bold text-white">Swap 6 Photos & Go Live</h3>
          <p class="mt-2 text-sm leading-relaxed text-[#94A3B8]">
            Once they pay the $50 setup + $15/mo founding fee, toggle Live Mode and drop in their 6 best job photos.
          </p>
        </div>
      </div>
    </section>

    {/* Active Previews Grid */}
    <section id="demos" class="reveal-up">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">
            Active Detailing Previews ({items.length})
          </h2>
          <p class="mt-1.5 text-sm text-[#94A3B8]">
            Open any preview on mobile or desktop to test the 60-second configurator and owner alert simulator.
          </p>
        </div>
        <a
          href="/studio"
          class="text-sm font-bold text-[#00F2FE] transition-colors hover:text-[#4FACFE]"
        >
          Manage in Founder Studio
        </a>
      </div>

      <div class="mt-7 grid gap-5 md:grid-cols-3">
        {items.map(({ prospect, previewTestQuotes }) => {
          const basePkg =
            prospect.packages.find((p) => p.popular) ?? prospect.packages[0];
          const startPrice = basePkg
            ? `${prospect.currencySymbol}${basePkg.prices.sedan}`
            : '';

          return (
            <article class="glass-panel interactive-card anisotropic-border flex flex-col justify-between rounded-2xl p-6 hover:border-cyan-400/50">
              <div>
                <div class="flex items-center justify-between gap-2">
                  <span class="rounded-md border border-slate-700 bg-[#0A0C10] px-2.5 py-0.5 text-xs font-semibold text-slate-200">
                    {prospect.city} ({prospect.country})
                  </span>
                  <span
                    class={`rounded-full px-2.5 py-0.5 text-[11px] font-bold ${
                      prospect.mode === 'live'
                        ? 'bg-emerald-500/15 text-emerald-300 ring-1 ring-emerald-400/30'
                        : 'bg-cyan-400/15 text-[#00F2FE] ring-1 ring-cyan-400/30'
                    }`}
                  >
                    {prospect.mode === 'live' ? 'Live Client' : 'Preview'}
                  </span>
                </div>

                <h3 class="mt-4 text-lg font-bold text-white">
                  {prospect.businessName}
                </h3>
                <p class="mt-1.5 text-xs leading-relaxed text-[#94A3B8]">
                  {prospect.tagline}
                </p>

                <div class="mt-5 flex items-center justify-between border-t border-slate-800 pt-3.5 text-xs">
                  <span class="text-slate-300">
                    <strong class="text-amber-400">★ {prospect.ratingScore}</strong> ({prospect.reviewCount})
                  </span>
                  <span class="font-display tabular-nums font-bold text-[#00F2FE]">
                    From {startPrice} · {previewTestQuotes} test{previewTestQuotes === 1 ? '' : 's'}
                  </span>
                </div>
              </div>

              <a
                href={`/p/${prospect.slug}`}
                class="mt-5 inline-flex items-center justify-center rounded-xl bg-[#00F2FE] px-4 py-2.5 text-sm font-bold text-[#06121A] transition-colors hover:bg-[#4FACFE] cyan-glow-sm"
              >
                Open Live Preview
              </a>
            </article>
          );
        })}
      </div>
    </section>
  </main>
</BaseLayout>
