  <script is:inline>
    (function () {
      const reducedMotion =
        typeof window.matchMedia === 'function' &&
        window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Hero 60s Quote Micro-Simulator
      const simVehicleBtns = document.querySelectorAll('.hero-sim-vehicle');
      const simAddonBtn = document.getElementById('hero-sim-addon');
      const simEstEl = document.getElementById('hero-sim-estimate');
      const simDurEl = document.getElementById('hero-sim-duration');
      const simAlertEl = document.getElementById('hero-sim-alert');
      const simSvgs = {
        sedan: document.getElementById('hero-sim-svg-sedan'),
        suv: document.getElementById('hero-sim-svg-suv'),
        truck_xl: document.getElementById('hero-sim-svg-truck_xl'),
      };

      let simVehicle = 'suv';
      let simLabel = 'Mid-Size SUV';
      let simMin = 190;
      let simMax = 210;
      let simDur = '3 - 3.5 hrs';
      let simAddonActive = false;
      let displayedMin = 190;
      let displayedMax = 210;
      let simRaf = 0;

      function renderSimRange(targetMin, targetMax) {
        if (!simEstEl) return;
        if (reducedMotion) {
          displayedMin = targetMin;
          displayedMax = targetMax;
          simEstEl.textContent = `$${targetMin} - $${targetMax}`;
          return;
        }
        if (simRaf) window.cancelAnimationFrame(simRaf);
        const startMin = displayedMin;
        const startMax = displayedMax;
        const startTime = performance.now();
        const durationMs = 240;

        const step = (now) => {
          const t = Math.min(1, (now - startTime) / durationMs);
          const eased = 1 - Math.pow(1 - t, 3);
          const curMin = Math.round(startMin + (targetMin - startMin) * eased);
          const curMax = Math.round(startMax + (targetMax - startMax) * eased);
          displayedMin = curMin;
          displayedMax = curMax;
          simEstEl.textContent = `$${curMin} - $${curMax}`;
          if (t < 1) {
            simRaf = window.requestAnimationFrame(step);
          } else {
            simRaf = 0;
          }
        };
        simRaf = window.requestAnimationFrame(step);
      }

      function updateHeroSimulator() {
        const extra = simAddonActive ? 35 : 0;
        const targetMin = simMin + extra;
        const targetMax = simMax + extra;

        renderSimRange(targetMin, targetMax);
        if (simDurEl) simDurEl.textContent = simDur;
        if (simAlertEl) {
          const addonText = simAddonActive ? ' + Sealant' : '';
          simAlertEl.textContent = `Alert -> ${simLabel}${addonText} · $${targetMin} - $${targetMax} · 78704`;
        }

        Object.entries(simSvgs).forEach(([key, svg]) => {
          if (!svg) return;
          svg.classList.toggle('hidden', key !== simVehicle);
        });
      }

      simVehicleBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          simVehicle = btn.getAttribute('data-sim-vehicle') || 'suv';
          simLabel = btn.getAttribute('data-sim-label') || 'Mid-Size SUV';
          simMin = Number(btn.getAttribute('data-sim-min') || '190');
          simMax = Number(btn.getAttribute('data-sim-max') || '210');
          simDur = btn.getAttribute('data-sim-duration') || '3 - 3.5 hrs';

          simVehicleBtns.forEach((b) => {
            const active = b === btn;
            b.setAttribute('aria-pressed', active ? 'true' : 'false');
            b.className = active
              ? 'hero-sim-vehicle rounded-xl border-2 border-[#00F2FE] bg-[#00F2FE]/12 px-2.5 py-2 text-center text-xs font-bold text-white transition-colors'
              : 'hero-sim-vehicle rounded-xl border border-slate-700/80 bg-[#090C12]/85 px-2.5 py-2 text-center text-xs font-semibold text-slate-200 transition-colors hover:border-cyan-400/50';
          });
          updateHeroSimulator();
        });
      });

      simAddonBtn?.addEventListener('click', () => {
        simAddonActive = !simAddonActive;
        simAddonBtn.setAttribute('aria-pressed', simAddonActive ? 'true' : 'false');
        simAddonBtn.className = simAddonActive
          ? 'rounded-full border border-[#00F2FE] bg-[#00F2FE]/15 px-2.5 py-1 text-[11px] font-bold text-[#7DD3FC] transition-colors'
          : 'rounded-full border border-slate-700/90 bg-[#090C12]/90 px-2.5 py-1 text-[11px] font-semibold text-slate-200 transition-colors hover:border-cyan-400/50 hover:text-white';
        updateHeroSimulator();
      });

      // Intake Form Submission
      const form = document.getElementById('home-inquiry-form');
      const feedback = document.getElementById('home-inquiry-feedback');
      const btn = document.getElementById('home-inquiry-btn');
      const planSelect = document.getElementById('inqPlanTier');

      document.querySelectorAll('.plan-jump-link').forEach((link) => {
        link.addEventListener('click', () => {
          const tier = link.getAttribute('data-select-plan');
          if (tier && planSelect) {
            planSelect.value = tier;
          }
        });
      });

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!form || !feedback || !btn) return;

        feedback.classList.add('hidden');
        const fd = new FormData(form);
        const orig = btn.textContent;
        btn.setAttribute('disabled', 'true');
        btn.textContent = 'Submitting Request...';

        try {
          const res = await fetch('/api/inquiries', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              inquiryType: 'free_preview_request',
              businessName: String(fd.get('businessName') || ''),
              ownerName: String(fd.get('ownerName') || ''),
              city: String(fd.get('city') || ''),
              country: String(fd.get('country') || 'US'),
              contactInfo: String(fd.get('contactInfo') || ''),
              planTier: String(fd.get('planTier') || 'founding'),
              notes: String(fd.get('notes') || ''),
              website_url: String(fd.get('website_url') || ''),
            }),
          });
          const data = await res.json().catch(() => null);
          if (!res.ok || !data?.ok) {
            feedback.textContent = data?.error || 'Please check the required fields and try again.';
            feedback.className =
              'rounded-xl border border-red-400/40 bg-red-950/60 px-4 py-3 text-xs font-semibold text-red-200';
            return;
          }

          feedback.textContent =
            'Request received! We are preparing your custom mobile quote preview and will send your link within 24 hours.';
          feedback.className =
            'rounded-xl border border-emerald-400/40 bg-emerald-950/60 px-4 py-3 text-xs font-semibold text-emerald-200';
          form.reset();
        } catch {
          feedback.textContent = 'Network error submitting request. Please try again.';
          feedback.className =
            'rounded-xl border border-red-400/40 bg-red-950/60 px-4 py-3 text-xs font-semibold text-red-200';
        } finally {
          btn.removeAttribute('disabled');
          btn.textContent = orig;
        }
      });
    })();
  </script>

  <footer class="border-t border-slate-800/90 bg-[#06080D]/85 px-4 py-8 backdrop-blur-md sm:px-6">
