---
import BaseLayout from '../layouts/BaseLayout.astro';

const env = Astro.locals.runtime.env;
const rawFoundingUrl = env.FOUNDING_CHECKOUT_URL?.trim() || '';
const rawStandardUrl = env.STANDARD_CHECKOUT_URL?.trim() || '';
const foundingCheckoutUrl = rawFoundingUrl.startsWith('https://') ? rawFoundingUrl : '';
const standardCheckoutUrl = rawStandardUrl.startsWith('https://') ? rawStandardUrl : '';
---

<BaseLayout
  title="QuotesDock | Dedicated 60-Second Driveway Quote Pages for Mobile Car Detailers"
  description="Turn Instagram and Google profile clicks into private, pre-qualified detailing bookings with a 60-second quote configurator built for US and UK mobile car detailers."
  showScrollLaser={true}
>
  <div class="sticky top-0 z-40 px-3 pt-3 sm:px-6">
    <nav class="mx-auto max-w-7xl rounded-2xl border border-slate-800/90 bg-[#090C12]/88 px-4 py-3 backdrop-blur-xl shadow-[0_14px_36px_-18px_rgba(0,0,0,0.9)] sm:px-5">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex min-w-0 items-center gap-3">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-cyan-400/40 bg-cyan-400/10 text-[#00F2FE] cyan-glow-sm">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 2L20 6.5V17.5L12 22L4 17.5V6.5L12 2Z" />
              <path d="M12 7L16 9.5V14.5L12 17L8 14.5V9.5L12 7Z" />
            </svg>
          </div>
          <span class="font-display text-lg font-bold tracking-tight text-slate-50">
            QuotesDock
          </span>
          <span class="hidden items-center gap-1.5 rounded-full border border-cyan-400/30 bg-cyan-400/10 px-2.5 py-0.5 text-[11px] font-semibold text-[#7DD3FC] sm:inline-flex">
            <span class="relative flex h-1.5 w-1.5">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#00F2FE] opacity-70" />
              <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-[#00F2FE]" />
            </span>
            For Mobile Detailers &amp; Valeters
          </span>
        </div>

        <div class="flex items-center gap-4 sm:gap-6">
          <a
            href="#why-it-works"
            class="hidden text-xs font-semibold text-[#CBD5E1] transition-colors hover:text-white md:inline"
          >
            Why It Works
          </a>
          <a
            href="#how-it-works"
            class="hidden text-xs font-semibold text-[#CBD5E1] transition-colors hover:text-white lg:inline"
          >
            24-Hour Setup
          </a>
          <a
            href="#demo"
            class="hidden text-xs font-semibold text-[#CBD5E1] transition-colors hover:text-white sm:inline sm:text-sm"
          >
            Interactive Demo
          </a>
          <a
            href="#pricing"
            class="text-xs font-semibold text-[#CBD5E1] transition-colors hover:text-white sm:text-sm"
          >
            Pricing
          </a>
          <a
            href="/p/apex-gloss-austin"
            class="btn-hydro-primary rounded-xl px-4 py-2 text-xs font-bold sm:text-sm"
          >
            Try Sample Quote Page
          </a>
        </div>
      </div>
    </nav>
  </div>

  <header class="wetbay-stage relative overflow-hidden border-b border-slate-800/80">
    <div class="mx-auto max-w-7xl px-4 pb-16 pt-10 sm:px-6 sm:pb-20 sm:pt-14">
      <div class="grid items-center gap-10 lg:grid-cols-12">
        <div class="reveal-up is-visible min-w-0 lg:col-span-7">
          <div class="inline-flex max-w-full flex-wrap items-center gap-2 rounded-full border border-cyan-400/30 bg-cyan-400/10 px-3.5 py-1.5 text-xs font-semibold text-[#7DD3FC]">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#00F2FE] opacity-75" />
              <span class="relative inline-flex h-2 w-2 rounded-full bg-[#00F2FE]" />
            </span>
            <span>Built for US &amp; UK Mobile Car Detailers</span>
          </div>

          <h1 class="mt-5 max-w-[19ch] text-3xl font-bold leading-[1.08] tracking-[-0.03em] text-slate-50 sm:text-5xl lg:text-[54px]">
            Turn Instagram &amp; Google Clicks Into{' '}
            <span class="text-hydro-sheen">60-Second Driveway Quotes</span>
          </h1>

          <p class="mt-4 max-w-xl text-base leading-relaxed text-[#CBD5E1] sm:text-lg">
            Stop losing busy car owners in endless "How much for an SUV?" DMs. Give your customers a private, mobile-first quote configurator dedicated strictly to your shop, where they tap their vehicle size, pick your package, and request a booking in 60 seconds.
          </p>

          <div class="mt-7 flex flex-wrap gap-3.5">
            <a
              href="/p/apex-gloss-austin"
              data-magnetic="4"
              class="btn-hydro-primary group inline-flex items-center gap-2 rounded-xl px-6 py-4 text-sm font-bold sm:text-base"
            >
              <span>Try Interactive Quote Demo</span>
              <svg
                class="h-4 w-4 transition-transform group-hover:translate-x-1"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                  clip-rule="evenodd"
                />
              </svg>
            </a>
            <a
              href="#request-preview"
              class="rounded-xl border border-slate-600/80 bg-[#111622]/90 px-5 py-4 text-sm font-semibold text-slate-100 backdrop-blur-md transition-colors hover:border-cyan-400/55 hover:text-white sm:text-base"
            >
              Request Free Custom Preview
            </a>
          </div>

          {/* Micro-Telemetry Authority Strip */}
          <div class="mt-8 grid max-w-xl grid-cols-3 gap-3 border-t border-slate-800/90 pt-5">
            <div class="rounded-xl border border-slate-800/80 bg-[#111622]/70 px-3.5 py-2.5">
              <div class="font-display tabular-nums text-sm font-bold text-[#00F2FE] sm:text-base">
                &lt; 1s Load
              </div>
              <div class="mt-0.5 text-[11px] text-[#CBD5E1]">Cloudflare Edge</div>
            </div>
            <div class="rounded-xl border border-slate-800/80 bg-[#111622]/70 px-3.5 py-2.5">
              <div class="font-display text-sm font-bold text-slate-50 sm:text-base">
                US ($) &amp; UK (£)
              </div>
              <div class="mt-0.5 text-[11px] text-[#CBD5E1]">Zip &amp; Postcode Native</div>
            </div>
            <div class="rounded-xl border border-slate-800/80 bg-[#111622]/70 px-3.5 py-2.5">
              <div class="font-display text-sm font-bold text-emerald-300 sm:text-base">
                0% Commission
              </div>
              <div class="mt-0.5 text-[11px] text-[#CBD5E1]">100% Isolated Shop Link</div>
            </div>
          </div>
        </div>

        {/* Right Column: Playable Live 60s Quote Micro-Simulator */}
        <div class="reveal-up is-visible stagger-1 min-w-0 lg:col-span-5">
          <div
            data-tilt-card="2.5"
            class="glass-panel anisotropic-border spotlight-card overflow-hidden rounded-2xl p-2"
          >
            <div class="relative aspect-[16/9] overflow-hidden rounded-xl bg-[#090C12]">
              <img
                src="/images/hero-wetbay.jpg"
                alt="Mobile detailing wet-bay lighting showcase"
                class="h-full w-full object-cover object-[70%_62%] scale-105"
              />
              <div
                class="pointer-events-none absolute inset-0"
                style="background: linear-gradient(125deg, rgba(9,12,18,0.92) 0%, rgba(9,12,18,0.45) 52%, rgba(9,12,18,0.14) 100%), linear-gradient(to top, rgba(9,12,18,0.96) 0%, transparent 58%);"
              />
              <div class="absolute left-3 top-3 inline-flex items-center gap-1.5 rounded-full border border-cyan-400/35 bg-[#090C12]/80 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-[#7DD3FC] backdrop-blur-md">
                <span class="h-1.5 w-1.5 rounded-full bg-[#00F2FE]" />
                <span>Live Interactive Simulator</span>
              </div>
              <div class="absolute bottom-2.5 left-3 right-3 flex items-center justify-between gap-2 rounded-xl border border-slate-700/80 bg-[#090C12]/90 px-3.5 py-2 backdrop-blur-md">
                <div class="min-w-0">
                  <div class="text-[10px] font-bold uppercase tracking-wider text-[#7DD3FC]">
                    Founding Detailer Offer
                  </div>
                  <div class="font-display tabular-nums text-base font-bold text-slate-50 sm:text-lg">
                    $50 setup + $15/mo
                  </div>
                </div>
                <span class="shrink-0 rounded-full bg-emerald-500/15 px-2.5 py-1 text-[11px] font-semibold text-emerald-300 ring-1 ring-emerald-400/30">
                  First 5 Shops
                </span>
              </div>
            </div>

            {/* Interactive Vehicle & Add-on Console */}
            <div class="p-3.5 sm:p-4 space-y-3">
              <div class="flex items-center justify-between gap-2">
                <span class="font-mono text-[11px] font-bold uppercase tracking-wider text-[#7DD3FC]">
                  Tap Vehicle Size to Test
                </span>
                <button
                  id="hero-sim-addon"
                  type="button"
                  aria-pressed="false"
                  class="rounded-full border border-slate-700/90 bg-[#090C12]/90 px-2.5 py-1 text-[11px] font-semibold text-slate-200 transition-colors hover:border-cyan-400/50 hover:text-white"
                >
                  + Ceramic Sealant (+$35)
                </button>
              </div>

              <div class="grid grid-cols-3 gap-2" role="group" aria-label="Simulator vehicle size">
                <button
                  type="button"
                  data-sim-vehicle="sedan"
                  data-sim-label="Coupe / Sedan"
                  data-sim-min="155"
                  data-sim-max="175"
                  data-sim-duration="2.5 - 3 hrs"
                  aria-pressed="false"
                  class="hero-sim-vehicle rounded-xl border border-slate-700/80 bg-[#090C12]/85 px-2.5 py-2 text-center text-xs font-semibold text-slate-200 transition-colors hover:border-cyan-400/50"
                >
                  Coupe / Sedan
                </button>
                <button
                  type="button"
                  data-sim-vehicle="suv"
                  data-sim-label="Mid-Size SUV"
                  data-sim-min="190"
                  data-sim-max="210"
                  data-sim-duration="3 - 3.5 hrs"
                  aria-pressed="true"
                  class="hero-sim-vehicle rounded-xl border-2 border-[#00F2FE] bg-[#00F2FE]/12 px-2.5 py-2 text-center text-xs font-bold text-white transition-colors"
                >
                  Mid-Size SUV
                </button>
                <button
                  type="button"
                  data-sim-vehicle="truck_xl"
                  data-sim-label="3-Row Truck"
                  data-sim-min="225"
                  data-sim-max="245"
                  data-sim-duration="3.5 - 4.5 hrs"
                  aria-pressed="false"
                  class="hero-sim-vehicle rounded-xl border border-slate-700/80 bg-[#090C12]/85 px-2.5 py-2 text-center text-xs font-semibold text-slate-200 transition-colors hover:border-cyan-400/50"
                >
                  3-Row Truck
                </button>
              </div>

              {/* Illuminated Studio Bay Readout */}
              <div class="bay-floor-glow flex items-center justify-between gap-3 rounded-xl border border-slate-800/90 bg-[#090C12]/95 px-4 py-3">
                <div class="flex items-center gap-3 min-w-0">
                  <div class="relative flex h-11 w-20 shrink-0 items-center justify-center">
                    <svg
                      id="hero-sim-svg-sedan"
                      class="hidden h-9 w-20 text-[#00F2FE]"
                      viewBox="0 0 120 44"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M10 30H22M40 30H82M100 30H110L112 24L104 20L82 18L66 10H36L20 18L10 21V30Z" />
                      <circle cx="31" cy="30" r="7" />
                      <circle cx="91" cy="30" r="7" />
                    </svg>
                    <svg
                      id="hero-sim-svg-suv"
                      class="h-9 w-20 text-[#00F2FE]"
                      viewBox="0 0 120 44"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M10 30H22M40 30H82M100 30H110L112 22L104 18L90 17L76 9H30L18 18L10 21V30Z" />
                      <circle cx="31" cy="30" r="7.5" />
                      <circle cx="91" cy="30" r="7.5" />
                    </svg>
                    <svg
                      id="hero-sim-svg-truck_xl"
                      class="hidden h-9 w-20 text-[#00F2FE]"
                      viewBox="0 0 120 44"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M8 30H21M39 30H83M101 30H113V19H72V9H34L20 18L8 21V30Z" />
                      <circle cx="30" cy="30" r="8" />
                      <circle cx="92" cy="30" r="8" />
                    </svg>
                  </div>
                  <div class="min-w-0">
                    <div class="text-[10px] font-semibold uppercase tracking-wider text-[#CBD5E1]">
                      Full Reset Estimate
                    </div>
                    <div
                      id="hero-sim-estimate"
                      class="font-display tabular-nums text-xl font-bold text-[#00F2FE] sm:text-2xl"
                    >
                      $190 - $210
                    </div>
                  </div>
                </div>
                <div class="shrink-0 text-right">
                  <div id="hero-sim-duration" class="font-mono text-xs font-semibold text-slate-200">
                    3 - 3.5 hrs
                  </div>
                  <a
                    href="/p/apex-gloss-austin"
                    class="mt-0.5 inline-block text-[11px] font-semibold text-[#7DD3FC] underline decoration-cyan-400/40 underline-offset-4 hover:text-white"
                  >
                    Open Full Configurator -&gt;
                  </a>
                </div>
              </div>

              {/* Simulated Instant Owner Lead Alert */}
              <div class="flex items-center justify-between gap-2 rounded-xl border border-emerald-400/25 bg-emerald-500/10 px-3 py-2 text-[11px] text-emerald-200">
                <div class="flex min-w-0 items-center gap-2">
                  <span class="h-2 w-2 shrink-0 rounded-full bg-emerald-400" />
                  <span id="hero-sim-alert" class="truncate font-mono">
                    Alert -&gt; Mid-Size SUV · $190 - $210 · 78704
                  </span>
                </div>
                <span class="shrink-0 font-semibold text-emerald-300">Ready</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="studio-frame-rails relative mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-6 left-1/2 -z-10 h-72 w-[85%] -translate-x-1/2 rounded-full bg-cyan-500/[0.045] blur-[90px]"
    />
    {/* Why Detailers Switch: Asymmetric Bento Grid */}
    <section id="why-it-works" class="reveal-up mb-16">
      <div class="max-w-2xl">
        <span class="inline-flex rounded-full border border-cyan-400/30 bg-cyan-400/10 px-3 py-1 text-xs font-semibold text-[#7DD3FC]">
          Built to Protect Your Brand &amp; Convert Traffic
        </span>
        <h2 class="mt-3 text-2xl font-bold tracking-[-0.03em] text-slate-50 sm:text-4xl">
          Why Mobile Detailers Switch from Generic Links to QuotesDock
        </h2>
      </div>

      <div class="mt-7 grid gap-5 lg:grid-cols-12">
        {/* Bento 1 (Wide): Private Branding vs Marketplace */}
        <div class="glass-panel anisotropic-border spotlight-card rounded-2xl border-cyan-400/30 p-6 sm:p-7 lg:col-span-7">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="font-mono text-xs font-bold uppercase tracking-wider text-[#7DD3FC]">
              Private Branding
            </span>
            <span class="rounded-full border border-emerald-400/30 bg-emerald-500/10 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-300">
              Never a Marketplace
            </span>
          </div>
          <h3 class="mt-2.5 text-xl font-bold text-slate-50 sm:text-2xl">
            100% Private &amp; Isolated Shop Page
          </h3>
          <p class="mt-2 max-w-xl text-sm leading-relaxed text-[#CBD5E1]">
            Zero competitor listings, zero shared leads, and zero cross-promotion of other shops. When customers tap your bio link, they only see your detailing business.
          </p>

          <div class="mt-5 grid gap-3 sm:grid-cols-2">
            <div class="rounded-xl border border-slate-800 bg-[#090C12]/80 px-3.5 py-3 text-xs text-slate-400">
              <div class="font-mono text-[10px] font-bold uppercase text-slate-400">Generic Directories</div>
              <div class="mt-1 line-through opacity-75">4 rival shops listed next to you</div>
            </div>
            <div class="rounded-xl border border-cyan-400/35 bg-cyan-400/8 px-3.5 py-3 text-xs text-slate-100">
              <div class="font-mono text-[10px] font-bold uppercase text-[#00F2FE]">Your QuotesDock URL</div>
              <div class="mt-1 font-semibold text-white">Exclusive /p/your-shop quote lock</div>
            </div>
          </div>
        </div>

        {/* Bento 2 (Compact): Pre-Qualified Leads */}
        <div class="glass-panel anisotropic-border spotlight-card rounded-2xl p-6 sm:p-7 lg:col-span-5">
          <span class="font-mono text-xs font-bold uppercase tracking-wider text-[#7DD3FC]">
            Pre-Qualified Leads
          </span>
          <h3 class="mt-2.5 text-xl font-bold text-slate-50">
            End "How Much?" DM Tag
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-[#CBD5E1]">
            Car owners see your Sedan, SUV, and 3-Row Truck starting ranges upfront before submitting, filtering out tire-kickers automatically.
          </p>

          <div class="mt-5 grid grid-cols-3 gap-2 text-center font-mono text-[11px]">
            <div class="rounded-lg border border-slate-800 bg-[#090C12]/90 px-2 py-2">
              <div class="text-slate-400">Sedan</div>
              <div class="mt-0.5 font-bold text-[#7DD3FC]">$155+</div>
            </div>
            <div class="rounded-lg border border-cyan-400/30 bg-[#090C12]/90 px-2 py-2">
              <div class="text-slate-300">SUV</div>
              <div class="mt-0.5 font-bold text-[#00F2FE]">$190+</div>
            </div>
            <div class="rounded-lg border border-slate-800 bg-[#090C12]/90 px-2 py-2">
              <div class="text-slate-400">3-Row</div>
              <div class="mt-0.5 font-bold text-[#7DD3FC]">$225+</div>
            </div>
          </div>
        </div>

        {/* Bento 3 (Compact): Thumb-First Mobile UX */}
        <div class="glass-panel anisotropic-border spotlight-card rounded-2xl p-6 sm:p-7 lg:col-span-5">
          <span class="font-mono text-xs font-bold uppercase tracking-wider text-[#7DD3FC]">
            Thumb-First Mobile UX
          </span>
          <h3 class="mt-2.5 text-xl font-bold text-slate-50">
            Built for Instagram Bio &amp; Google Links
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-[#CBD5E1]">
            Loads in under a second on mobile with interactive vehicle silhouettes, condition upgrades, and a sticky quote bar.
          </p>

          <div class="mt-5 flex items-center justify-between rounded-xl border border-slate-800 bg-[#090C12]/90 px-3.5 py-2.5 text-xs">
            <span class="text-slate-300">Sticky Mobile Quote Dock</span>
            <span class="rounded-lg bg-[#00F2FE] px-2.5 py-1 text-[11px] font-bold text-[#041019]">
              Lock In Quote
            </span>
          </div>
        </div>

        {/* Bento 4 (Wide): Verified Job Proof */}
        <div class="glass-panel anisotropic-border spotlight-card rounded-2xl p-6 sm:p-7 lg:col-span-7">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="font-mono text-xs font-bold uppercase tracking-wider text-[#7DD3FC]">
              Verified Job Proof
            </span>
            <span class="font-mono text-[11px] text-slate-300">
              6 Real Photo Slots + Rig Specs
            </span>
          </div>
          <h3 class="mt-2.5 text-xl font-bold text-slate-50 sm:text-2xl">
            Show Your Real Gloss &amp; Rig Specs
          </h3>
          <p class="mt-2 max-w-xl text-sm leading-relaxed text-[#CBD5E1]">
            Display 6 of your real before-and-after details plus your onboard deionized water and power specs right above the booking form.
          </p>

          <div class="mt-5 flex flex-wrap gap-2 text-xs">
            <span class="rounded-lg border border-slate-700/80 bg-[#090C12]/90 px-3 py-1.5 text-slate-200">
              Before / After Toggle Cards
            </span>
            <span class="rounded-lg border border-slate-700/80 bg-[#090C12]/90 px-3 py-1.5 text-slate-200">
              Self-Contained Water &amp; Power Badges
            </span>
            <span class="rounded-lg border border-cyan-400/30 bg-cyan-400/10 px-3 py-1.5 font-semibold text-[#7DD3FC]">
              Private Owner Lead Inbox
            </span>
          </div>
        </div>
      </div>
    </section>

    {/* 24-Hour Setup Workflow (Connected Sequential Timeline) */}
    <section id="how-it-works" class="reveal-up mb-16">
      <div class="max-w-2xl">
        <span class="inline-flex rounded-full border border-cyan-400/30 bg-cyan-400/10 px-3 py-1 text-xs font-semibold text-[#7DD3FC]">
          Fast 24-Hour Onboarding
        </span>
        <h2 class="mt-3 text-2xl font-bold tracking-[-0.03em] text-slate-50 sm:text-4xl">
          How Your Detailer Page Goes Live Without Any Tech Headache
        </h2>
      </div>

      <div class="relative mt-7">
        <div
          aria-hidden="true"
          class="pointer-events-none absolute left-10 right-10 top-9 hidden h-px bg-gradient-to-r from-cyan-400/10 via-cyan-400/45 to-cyan-400/10 md:block"
        />
        <div class="grid gap-5 md:grid-cols-3">
          <div class="glass-panel anisotropic-border spotlight-card relative rounded-2xl p-6">
            <div class="inline-flex items-center gap-2 rounded-full border border-cyan-400/35 bg-[#090C12] px-3 py-1 font-mono text-xs font-bold text-[#00F2FE]">
              <span>STEP 01</span>
            </div>
            <h3 class="mt-3 text-lg font-bold text-slate-50">Test Your Custom Preview Link</h3>
            <p class="mt-2 text-sm leading-relaxed text-[#CBD5E1]">
              If we sent you a preview link for your detailing business, tap through the vehicle sizes and submit a test quote to see how your customer alerts work.
            </p>
          </div>

          <div class="glass-panel anisotropic-border spotlight-card relative rounded-2xl p-6">
