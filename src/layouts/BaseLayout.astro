---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
  noindex?: boolean;
  showScrollLaser?: boolean;
}

const {
  title,
  description,
  bodyClass = 'bg-[#090C12] text-[#F1F5F9]',
  noindex = false,
  showScrollLaser = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={bodyClass}>
    {showScrollLaser && <div id="scroll-laser" class="scroll-laser" aria-hidden="true" />}
    {showScrollLaser && (
      <div class="studio-backdrop" aria-hidden="true">
        <div class="studio-backdrop-grid" />
        <div class="studio-orb-left" />
        <div class="studio-orb-right" />
        <div id="studio-cursor-glow" class="studio-cursor-glow" />
      </div>
    )}
    <div class="relative z-10">
      <slot />
    </div>

    <script is:inline>
      (function () {
        const reducedMotion =
          typeof window.matchMedia === 'function' &&
          window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const revealEls = document.querySelectorAll('.reveal-up');
        if (revealEls.length) {
          if (reducedMotion || !('IntersectionObserver' in window)) {
            revealEls.forEach((el) => el.classList.add('is-visible'));
          } else {
            const observer = new IntersectionObserver(
              (entries) => {
                entries.forEach((entry) => {
                  if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    observer.unobserve(entry.target);
                  }
                });
              },
              { threshold: 0.01, rootMargin: '0px 0px 80px 0px' }
            );
            revealEls.forEach((el) => observer.observe(el));
          }
        }

        const laser = document.getElementById('scroll-laser');
        if (laser) {
          let scrollRaf = 0;
          const updateLaser = () => {
            scrollRaf = 0;
            const doc = document.documentElement;
            const max = Math.max(1, doc.scrollHeight - window.innerHeight);
            const pct = Math.min(1, Math.max(0, window.scrollY / max));
            laser.style.transform = `scaleX(${pct.toFixed(4)})`;
          };
          const onScroll = () => {
            if (!scrollRaf) {
              scrollRaf = window.requestAnimationFrame(updateLaser);
            }
          };
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onScroll, { passive: true });
          updateLaser();
        }

        const finePointer =
          !reducedMotion &&
          typeof window.matchMedia === 'function' &&
          window.matchMedia('(hover: hover) and (pointer: fine)').matches;

        if (finePointer) {
          let moveRaf = 0;
          let lastEvent = null;

          const cursorGlow = document.getElementById('studio-cursor-glow');
          let glowTargetX = 0;
          let glowTargetY = 0;
          let glowCurX = 0;
          let glowCurY = 0;
          let glowInitialized = false;
          let glowRaf = 0;

          const stepGlow = () => {
            glowRaf = 0;
            if (!cursorGlow || document.hidden) return;
            const dx = glowTargetX - glowCurX;
            const dy = glowTargetY - glowCurY;
            if (Math.abs(dx) < 0.5 && Math.abs(dy) < 0.5) {
              glowCurX = glowTargetX;
              glowCurY = glowTargetY;
              cursorGlow.style.transform = `translate3d(${(glowCurX - 430).toFixed(1)}px, ${(glowCurY - 430).toFixed(1)}px, 0)`;
              return;
            }
            glowCurX += dx * 0.22;
            glowCurY += dy * 0.22;
            cursorGlow.style.transform = `translate3d(${(glowCurX - 430).toFixed(1)}px, ${(glowCurY - 430).toFixed(1)}px, 0)`;
            glowRaf = window.requestAnimationFrame(stepGlow);
          };

          document.addEventListener(
            'pointermove',
            (e) => {
              if (document.hidden) return;
              lastEvent = e;

              if (cursorGlow) {
                glowTargetX = e.clientX;
                glowTargetY = e.clientY;
                if (!glowInitialized) {
                  glowInitialized = true;
                  glowCurX = glowTargetX;
                  glowCurY = glowTargetY;
                  cursorGlow.style.transform = `translate3d(${(glowCurX - 430).toFixed(1)}px, ${(glowCurY - 430).toFixed(1)}px, 0)`;
                }
                cursorGlow.style.opacity = '1';
                if (!glowRaf) {
                  glowRaf = window.requestAnimationFrame(stepGlow);
                }
              }

              if (moveRaf) return;
              moveRaf = window.requestAnimationFrame(() => {
                moveRaf = 0;
                const ev = lastEvent;
                if (!ev || !(ev.target instanceof Element)) return;

                const card = ev.target.closest('.spotlight-card');
                if (card instanceof HTMLElement) {
                  const rect = card.getBoundingClientRect();
                  card.style.setProperty('--mx', `${(ev.clientX - rect.left).toFixed(1)}px`);
                  card.style.setProperty('--my', `${(ev.clientY - rect.top).toFixed(1)}px`);
                }

                const stage = ev.target.closest('.wetbay-stage');
                if (stage instanceof HTMLElement) {
                  const rect = stage.getBoundingClientRect();
                  stage.style.setProperty('--stage-x', `${(ev.clientX - rect.left).toFixed(1)}px`);
                  stage.style.setProperty('--stage-y', `${(ev.clientY - rect.top).toFixed(1)}px`);
                }
              });
            },
            { passive: true }
          );

          document.documentElement.addEventListener('mouseleave', () => {
            if (cursorGlow) cursorGlow.style.opacity = '0';
          });

          document.querySelectorAll('[data-tilt-card]').forEach((el) => {
            if (!(el instanceof HTMLElement)) return;
            const maxDeg = Number(el.getAttribute('data-tilt-card') || '3');
            let tiltRaf = 0;
            el.style.transition = 'transform 260ms cubic-bezier(0.16, 1, 0.3, 1)';
            el.addEventListener(
              'pointermove',
              (ev) => {
                if (document.hidden) return;
                const rect = el.getBoundingClientRect();
                if (!rect.width || !rect.height) return;
                const nx = (ev.clientX - rect.left) / rect.width - 0.5;
                const ny = (ev.clientY - rect.top) / rect.height - 0.5;
                if (tiltRaf) window.cancelAnimationFrame(tiltRaf);
                tiltRaf = window.requestAnimationFrame(() => {
                  const rx = (-ny * maxDeg * 2).toFixed(2);
                  const ry = (nx * maxDeg * 2).toFixed(2);
                  el.style.transform = `perspective(1000px) rotateX(${rx}deg) rotateY(${ry}deg)`;
                });
              },
              { passive: true }
            );
            el.addEventListener('pointerleave', () => {
              if (tiltRaf) window.cancelAnimationFrame(tiltRaf);
              el.style.transform = '';
            });
          });

          document.querySelectorAll('[data-magnetic]').forEach((el) => {
            if (!(el instanceof HTMLElement)) return;
            const maxPull = Number(el.getAttribute('data-magnetic') || '4');
            let magRaf = 0;
            el.addEventListener(
              'pointermove',
              (ev) => {
                if (document.hidden) return;
                const rect = el.getBoundingClientRect();
                if (!rect.width || !rect.height) return;
                const dx = ((ev.clientX - rect.left) / rect.width - 0.5) * 2 * maxPull;
                const dy = ((ev.clientY - rect.top) / rect.height - 0.5) * 2 * maxPull;
                if (magRaf) window.cancelAnimationFrame(magRaf);
                magRaf = window.requestAnimationFrame(() => {
                  el.style.transform = `translate3d(${dx.toFixed(1)}px, ${dy.toFixed(1)}px, 0)`;
                });
              },
              { passive: true }
            );
            el.addEventListener('pointerleave', () => {
              if (magRaf) window.cancelAnimationFrame(magRaf);
              el.style.transform = '';
            });
          });
        }
      })();
    </script>
  </body>
</html>
